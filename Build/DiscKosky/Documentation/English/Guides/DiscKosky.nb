Cell[CellGroupData[{

Cell["DiscKosky Documentation", "GuideTitle",
 CellID->1439520439,ExpressionUUID->"ec6106e3-230e-4e62-9d62-68fb23aa5411"],

Cell["\<\
DiscKosky provides tools for sector-by-sector critical point counts, repeated \
discontinuity checks, and graph visualizations of sector drops. Use the \
tutorial for a worked example and the symbol pages for detailed options.\
\>", "GuideAbstract",
 CellID->1669521233,ExpressionUUID->"fc6be7e7-ca55-40b4-89e0-ba312cdb7fc6"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"d04184f7-d772-4684-a5fe-193343db1bf0"]
}, Open  ]],

