Cell[CellGroupData[{

Cell["DiscKosky Documentation", "GuideTitle",
 CellID->1439520439,ExpressionUUID->"0b979b6f-277c-4960-8a89-56df74e5724f"],

Cell["\<\
DiscKosky provides tools for sector-by-sector critical point counts, repeated \
discontinuity checks, and graph visualizations of sector drops. Use the \
tutorial for a worked example and the symbol pages for detailed options.\
\>", "GuideAbstract",
 CellID->1669521233,ExpressionUUID->"c044fbcc-d08f-41b7-91ce-7f7a515df7fe"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"51efbade-780d-485c-9bf7-8614db823861"]
}, Open  ]],

