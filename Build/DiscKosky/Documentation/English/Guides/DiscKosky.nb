Cell[CellGroupData[{

Cell["DiscKosky Documentation", "GuideTitle",
 CellID->1439520439,ExpressionUUID->"eabe0aed-aa0a-43ab-b530-c5d44e87278a"],

Cell[TextData[{
 "DiscKosky provides tools for sector-by-sector critical point counts, \
repeated discontinuity checks, and graph visualizations of sector drops. See \
the ",
 ButtonBox["Using DiscKosky",
  BaseStyle->"Link",
  ButtonData->"paclet:DiscKosky/tutorial/UsingDiscKosky"],
 " tech note for a worked example and the reference pages for details and \
options."
}], "GuideAbstract",
 CellID->1669521233,ExpressionUUID->"fe408b8a-f75f-42b7-9710-c2ebbf03a99e"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"6b107deb-a4bd-4452-867d-cc4b2ed600e2"]
}, Open  ]],

