Cell[CellGroupData[{

Cell["DiscKosky Documentation", "GuideTitle",
 CellID->1439520439,ExpressionUUID->"612b2253-f64d-4b31-8016-321b453d4b04"],

Cell["\<\
DiscKosky provides tools for sector-by-sector critical point counts, repeated \
discontinuity checks, and graph visualizations of sector drops. Use the \
tutorial for a worked example and the symbol pages for detailed options.\
\>", "GuideAbstract",
 CellID->1669521233,ExpressionUUID->"fe1a25de-d5a2-4b3c-8cbd-1bd38a21e435"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"61379496-5c0b-40fc-abdb-1a9c311158d4"]
}, Open  ]],

