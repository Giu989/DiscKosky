    RowBox[{"gpol", ",", "vars", ",", 
     RowBox[{"{", "}"}]}], "]"}], ";"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"CountSectorsUnregulated", "[", 
    RowBox[{"gpol", ",", "vars", ",", 
     RowBox[{"{", "}"}], ",", 
     RowBox[{"\"\<msolve\>\"", "\[Rule]", "False"}]}], "]"}], ";"}], 
  "]"}]}], "Input",
 CellLabel->"In[9]:=",
 CellID->491912444,ExpressionUUID->"1e0ea84b-94a0-40b3-9146-1137f51e3394"]
}, Open  ]],

