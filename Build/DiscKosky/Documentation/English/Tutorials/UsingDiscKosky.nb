}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Graphing Sector Drops", "TechNoteSection",
 CellID->1221267223,ExpressionUUID->"a0a7febf-b050-4702-8715-7f52c24346cb"],

Cell["\<\
SectorDropGraph draws the sector graph. Nodes are sectors, arrows point from \
subsectors to immediate supersectors, and node labels are singularity indices.\
\>", "TechNoteText",
 CellID->562188352,ExpressionUUID->"ce204cbd-55fd-43d2-92ba-5a1f4ad616ca"],

Cell[BoxData[
 RowBox[{"SectorDropGraph", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet"}], "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->244333380,ExpressionUUID->"c0621ca8-0f7f-483c-ab8d-13a42deada23"],

Cell[BoxData[
 RowBox[{"SectorDropGraph", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", 
   RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", "True"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->487322237,ExpressionUUID->"88df5cf7-17d7-4760-87a3-bb9b8a2c83e9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Performance", "TechNoteSection",
 CellID->1635953384,ExpressionUUID->"939c7bdf-fb72-4ff5-b2a8-515c32f0987e"],

Cell["\<\
By default, DiscKosky uses msolve when the executable is available. Setting \
\"msolve\" -> False forces Mathematica's built-in GroebnerBasis workflow and \
can be much slower on difficult examples.\
\>", "TechNoteText",
 CellID->332317216,ExpressionUUID->"340d4b48-daa8-453b-ba3b-06c5c263c310"],

Cell[BoxData[{
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"CountSectorsUnregulated", "[", 
    RowBox[{"gpol", ",", "vars", ",", 
     RowBox[{"{", "}"}]}], "]"}], ";"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"CountSectorsUnregulated", "[", 
    RowBox[{"gpol", ",", "vars", ",", 
     RowBox[{"{", "}"}], ",", 
     RowBox[{"\"\<msolve\>\"", "\[Rule]", "False"}]}], "]"}], ";"}], 
  "]"}]}], "Input",
 CellLabel->"In[9]:=",
 CellID->491912444,ExpressionUUID->"38ed82b6-4f9f-4bb8-b300-d745411a1ad5"]
}, Open  ]],

