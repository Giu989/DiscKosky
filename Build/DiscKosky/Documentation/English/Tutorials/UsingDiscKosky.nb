Cell["\<\
DiscKosky is a package for studying the repeated discontinuity structure of \
Euler integrals. This is done primarily by counting the number of critical \
points associated to the Feynman integral.\
\>", "TechNoteText",
 CellID->898362796,ExpressionUUID->"253cbf3c-2455-44a9-9d31-b8a59eb21eed"],

Cell["\<\
This tech note introduces the most important commands of DiscKosky, \
illustrated on a simple one-loop example. More details on each function and \
its options can be found on the corresponding reference pages.\
\>", "TechNoteText",
 CellID->1942604819,ExpressionUUID->"10fce384-7bcd-40c1-ac0b-1ac9580eacb5"],

Cell["Load the package:", "TechNoteMathCaption",
 CellID->1014577915,ExpressionUUID->"36d5b84b-e26a-4a4e-abca-b5554e906d63"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<DiscKosky`\>\"", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1022905431,ExpressionUUID->"cfa21f36-0bd9-4e8c-b423-e77bf607544e"],

Cell[CellGroupData[{

Cell["Core Usage", "TechNoteSection",
 CellID->1951386777,ExpressionUUID->"99d86dd2-f9f0-4827-b807-c4323fce0cf0"],

Cell[TextData[{
 "DiscKosky",
 " provides three main high-level functions for predicting sequential \
discontinuities: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CheckDoubleDiscontinuities"]], 
    "paclet:DiscKosky/ref/CheckDoubleDiscontinuities", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8c66445c-de89-44cb-a2cf-1903e1f1b3ec"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CheckSequentialDiscontinuity"]], 
    "paclet:DiscKosky/ref/CheckSequentialDiscontinuity", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1f542957-ccee-41b2-a46f-6e88e13f0114"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SectorDropGraph"]], "paclet:DiscKosky/ref/SectorDropGraph", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "13e3b5db-83c4-4d6f-b938-ecd419c35b75"],
 "."
}], "TechNoteText",
 CellID->987825340,ExpressionUUID->"bac44c19-78ea-4a88-abac-4650406b067c"],

