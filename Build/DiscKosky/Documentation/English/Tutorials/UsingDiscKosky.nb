Cell["\<\
DiscKosky is a Wolfram Language paclet for studying sector-by-sector critical \
point counts and repeated discontinuity structure of Feynman integrals.\
\>", "TechNoteText",
 CellID->898362796,ExpressionUUID->"ada07edc-c57f-4502-8bfb-4dd7f83f1fcb"],

Cell["\<\
The examples below use the small graph example from \
dev_tests/simple_example.m.\
\>", "TechNoteText",
 CellID->1452817362,ExpressionUUID->"fab0d81c-9b14-4ef6-87ee-b216ab98aec9"],

Cell["Loading the Package", "TechNoteMathCaption",
 CellID->1014577915,ExpressionUUID->"3b97d362-b02d-49d3-9e1c-5e1e284b5354"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<DiscKosky`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1629665133,ExpressionUUID->"5d7af642-57c9-4211-999b-4cabc022d814"],

Cell[CellGroupData[{

Cell["A Small Polynomial and Alphabet", "TechNoteSection",
 CellID->1200482625,ExpressionUUID->"0a5c9987-a19c-41dd-8dc9-3f822e6d85cc"],

Cell["\<\
Start with a polynomial, the propagator variables, and an ordered list of \
singularities.\
\>", "TechNoteText",
 CellID->381582614,ExpressionUUID->"11f5bde7-eae0-40bc-a2ff-a615257f439c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->314500041,ExpressionUUID->"bfa8569c-01df-4da6-a570-6030b5e49b9f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Counting Sectors", "TechNoteSection",
 CellID->457319930,ExpressionUUID->"09fd54d6-9e49-4954-9738-5073cc91016d"],

Cell["\<\
CountSectorsUnregulated returns {total, sectorCounts, sectors}. The third \
argument is a list of cut variables; only sectors containing all cut \
variables are counted.\
\>", "TechNoteText",
 CellID->1047698328,ExpressionUUID->"0c9a9072-f8f3-4764-8112-959404efe4f9"],

Cell[CellGroupData[{

