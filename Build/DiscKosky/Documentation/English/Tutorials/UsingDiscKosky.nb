Cell["\<\
DiscKosky is a Wolfram Language paclet for studying sector-by-sector critical \
point counts and repeated discontinuity structure of Feynman integrals.\
\>", "TechNoteText",
 CellID->898362796,ExpressionUUID->"1495b95d-4566-4ef3-9839-709cd6835248"],

Cell["\<\
The examples below use the small graph example from \
dev_tests/simple_example.m.\
\>", "TechNoteText",
 CellID->1452817362,ExpressionUUID->"e244cb46-88f9-42de-82dd-787012b1611c"],

Cell["Loading the Package", "TechNoteMathCaption",
 CellID->1014577915,ExpressionUUID->"ba797583-e3e1-40e8-8c51-1d9ec1e124dc"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<DiscKosky`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1629665133,ExpressionUUID->"e378ffb3-4841-4bee-9e14-494189458de6"],

Cell[CellGroupData[{

Cell["A Small Polynomial and Alphabet", "TechNoteSection",
 CellID->1200482625,ExpressionUUID->"7e2b103c-6bf4-4a3e-956e-6bcf331fc314"],

Cell["\<\
Start with a polynomial, the propagator variables, and an ordered list of \
singularities.\
\>", "TechNoteText",
 CellID->381582614,ExpressionUUID->"ae2ad3ab-36f6-4373-9e36-14eb782dd709"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->314500041,ExpressionUUID->"a7318acf-5784-4205-a56c-63651bc32a6d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Counting Sectors", "TechNoteSection",
 CellID->457319930,ExpressionUUID->"d370aefe-81e4-40f6-aa32-7cbb05c234ca"],

Cell["\<\
CountSectorsUnregulated returns {total, sectorCounts, sectors}. The third \
argument is a list of cut variables; only sectors containing all cut \
variables are counted.\
\>", "TechNoteText",
 CellID->1047698328,ExpressionUUID->"2285eea3-3258-4001-aa25-a96f33984660"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CountSectorsUnregulated", "[", 
  RowBox[{"gpol", ",", "vars", ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->274810544,ExpressionUUID->"0dc52565-7494-4798-b22c-497e147dec33"],

