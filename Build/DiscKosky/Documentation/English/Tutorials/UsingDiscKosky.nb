         Placed[{
            Pane[
             Style["{x2, x3}", 10, 
              GrayLevel[0.15]], FrameMargins -> {{0, 0}, {7, 0}}], 
            Pane[
             Style["{3}", 10, Bold, 
              RGBColor[0.55, 0.1, 0.08]], 
             FrameMargins -> {{0, 0}, {0, 7}}]}, {Above, Below}], {1, 4} -> 
         Placed[{
            Pane[
             Style["{x1, x4}", 10, 
              GrayLevel[0.15]], FrameMargins -> {{0, 0}, {7, 0}}], 
