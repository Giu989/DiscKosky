 CellID->1148871023,ExpressionUUID->"911b9077-ff88-4411-b38f-08dde98c66e5"]
}, Open  ]],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f88a2655-d009-40c6-bcbe-7ed367169c63"],
 " indicates that a higher-dimensional solution to the ",
 "critical point equations has been found. The entry in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "fed578f7-f981-41ce-bce1-96cfe7e60b65"],
 " row and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["j", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "47632201-2d7a-4825-ba1d-77de40ebc8a4"],
 " column of this matrix, namely ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "102e1a2d-479f-471e-9a5a-d0f24dbe7fc5"],
 ", tells us whether a discontinuity with respect to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["j", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "a91a55ac-ff08-4705-9cff-16b36187490d"],
 " singularity can follow a discontinuity with respect to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "93b8b0e5-d2bc-4785-a126-ef7f39cf42a9"],
 " singularity. Namely, if ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d66d6897-3834-4e13-bca0-a9cf7b863bbb"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48e5d1dd-c426-4312-b45f-cb0a90196ad8"],
 ", this indicates that the Feynman integral ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "9b9d481a-eafa-49ca-b737-8fbecf8f3b98"],
 " satisfies a genealogical constraint of the form"
}], "TechNoteText",
 CellID->1408544087,ExpressionUUID->"fde5364f-78bb-4dd7-a2ec-8bcaccc3eb1f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["Disc", 
    RowBox[{"sings", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]], 
   "\[CenterEllipsis]", 
   SubscriptBox["Disc", 
    RowBox[{"sings", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]], 
   "\[CenterEllipsis]", "\[ScriptCapitalI]", "=", "0"}], 
  TraditionalForm]], "DisplayMath",
 CellID->1701802682,ExpressionUUID->"b1725bb2-c444-4196-a372-326ec47a2930"],

Cell[TextData[{
 "Conversely, if ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "795aa896-365c-4144-9be4-90033872aa53"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6790da14-192c-44f5-9fd4-91806b4a281f"],
 ", such sequences of discontinuities are not ruled out by this method."
}], "TechNoteText",
 CellID->921957231,ExpressionUUID->"931bd21a-c196-4446-acb7-de667fec9116"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Refining Indeterminate Entries", "Subsection",
 CellID->150763012,ExpressionUUID->"3296b1ff-fb06-4bb6-9d70-91f9df9b4817"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "497e518b-3a74-4f03-988d-549f6096d0f2"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5c918800-8872-4cc0-b3c5-05e924de9e64"],
 ", there are two ways one can proceed. Most directly, these entries indicate \
that the ",
 "critical point algorithm cannot be applied, so the conservative option is \
to treat such a ",
 "result as equivalent to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9530346-889b-4f39-a89b-fc982080f1e1"],
 ". However, more can be said in many of the cases in which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "62e568e2-39e9-48a2-aed8-f142bcdabbb3"],
 " solutions arise (such as when a sector that has no critical points in ",
 "generic kinematics becomes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1c9ae7da-b0a4-4796-91a2-52c1322656a9"],
 " in a singular limit). These more refined ",
 "predictions can be requested by using the option ",
 Cell[BoxData["\"\<RefineIndeterminates\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b4538226-8cfd-446e-bf2c-fe3fe4779b71"],
 ", which can be passed to all of the core ",
 "DiscKosky",
 " functions."
}], "TechNoteText",
 CellID->951771314,ExpressionUUID->"ca043007-9eb0-4fbc-bd0b-5dc71cf65ad0"],

Cell[TextData[{
 "Compute the double discontinuity matrix with ",
 Cell[BoxData["\"\<RefineIndeterminates\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "655778d5-9b9d-45e6-bc00-6aa28c083932"],
 " enabled:"
}], "TechNoteMathCaption",
 CellID->1638046882,ExpressionUUID->"3565f89a-404a-4d8e-a784-8bd8587d3012"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dM2", "=", 
   RowBox[{"CheckDoubleDiscontinuities", "[", 
    RowBox[{"g", ",", "vars", ",", "sings", ",", 
     RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1996661693,ExpressionUUID->"d07e4714-06a4-4bb7-a6c7-a4945cb2a256"],

