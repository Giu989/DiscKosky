}, Open  ]],

Cell["\<\
A regulated count is useful as a check when critical points can move to \
infinity in the unregulated formulation.\
\>", "TechNoteText",
 CellID->176674680,ExpressionUUID->"c8cd9e2d-f1df-4bdf-9166-ce530542e68a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CountSectorsRegulated", "[", 
  RowBox[{"gpol", ",", "vars", ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->959152778,ExpressionUUID->"3a9be894-8b59-4fd8-93d9-f64ff267d3cb"],

