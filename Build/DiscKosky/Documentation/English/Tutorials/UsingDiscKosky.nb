Cell[TextData[{
 "Compared to ",
 Cell[BoxData["dM1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ef1f759-abad-4dcf-b9da-dff399addcf1"],
 ", four new singularities (",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "71d1c349-d082-4872-8c00-a5a5e03436a6"],
 ", ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "6", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "916a89a4-505e-4fba-90ca-a1f494b8e316"],
 ", ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "7", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7b16fc1b-876d-4e7e-b250-90bc515e5581"],
 ", and ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "8", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dd08a971-09ec-4883-bf0c-6d8e8910f8c9"],
 ") can now be identified as giving rise to non-repeating discontinuities. \
Any ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21000d3f-6308-4fdc-83a8-a24ffc885635"],
 " entries that the refined algorithm cannot resolve are conservatively set \
to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6ad6c8e8-a7f6-48e4-856c-41f25d08dee2"],
 "."
}], "TechNoteText",
 CellID->1528055918,ExpressionUUID->"a272392f-f0b4-4c70-9dec-b5979d793081"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sequences of Discontinuities", "Subsection",
 CellID->654515079,ExpressionUUID->"56974f11-40be-4a6e-9178-bf64cd8968c5"],

Cell[TextData[{
 "The function ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CheckSequentialDiscontinuity"]], 
    "paclet:DiscKosky/ref/CheckSequentialDiscontinuity", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8eb22cc3-74b7-4108-aefd-f80a0659d93d"],
 " works in a very similar manner, except that it tests for a specific string \
of discontinuities ",
 "of any length. It takes four inputs: the same three as above, and a \
specific sequence to test, ",
 "given as a list of positions in ",
 Cell[BoxData["sings"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0c89a880-e9fd-4f76-94f4-50791acf475e"],
 "."
}], "TechNoteText",
 CellID->1158688030,ExpressionUUID->"a9139693-8c0f-48b5-b5f5-6494f9d1f500"],

Cell[TextData[{
 "Test whether discontinuities with respect to ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2ccbbddf-e4fa-415b-85d1-b5671782c748"],
 ", ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "9", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "76d561a7-837c-4a38-a513-7e5e905b9e2f"],
 ", and ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "7", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fb6ca570-412c-41e8-ac58-4a57684e635c"],
 " can appear in this order:"
}], "TechNoteMathCaption",
 CellID->1451455643,ExpressionUUID->"ae02f441-0e96-4934-a1d6-a4816a0d89d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CheckSequentialDiscontinuity", "[", 
  RowBox[{"g", ",", "vars", ",", "sings", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "9", ",", "7"}], "}"}], ",", 
   RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", "True"}]}], 
  "]"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->1787328310,ExpressionUUID->"17b7d3b0-cf81-4a87-a5b7-5a86f1c92fc3"],

Cell[BoxData["False"], "Output",
