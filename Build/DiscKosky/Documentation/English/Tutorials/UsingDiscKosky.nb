             Style["{2}", 10, Bold, 
              RGBColor[0.55, 0.1, 0.08]], 
             FrameMargins -> {{0, 0}, {0, 7}}]}, {Above, Below}], {1, 2, 3, 
          4} -> Placed[{
            Pane[
