 CellLabel->"Out[4]=",
 CellID->1816070719,ExpressionUUID->"ebcd6b1f-f89b-4251-b3fc-337b8c5529c1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Checking Discontinuities", "TechNoteSection",
 CellID->1669212534,ExpressionUUID->"4b948891-ff4d-4a6b-bd45-375caf393d00"],

Cell["\<\
CheckRepeatedDiscontinuity tests an ordered sequence of singularity indices. \
CheckDoubleDiscontinuities builds the pairwise matrix.\
\>", "TechNoteText",
 CellID->1457276726,ExpressionUUID->"9ee22f82-3c24-4624-b90e-761665fdffdc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CheckRepeatedDiscontinuity", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "9"}], "}"}], ",", 
   RowBox[{"\"\<CheckCriticalPointValidity\>\"", "\[Rule]", "False"}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1566422874,ExpressionUUID->"9ff3f36d-b260-42dd-81cb-f6ba71dbdca3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]=",
 CellID->1126264437,ExpressionUUID->"2ba0bf1e-6435-4c24-be67-248a80fed5c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dimensions", "[", 
  RowBox[{"CheckDoubleDiscontinuities", "[", 
   RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", 
    RowBox[{"\"\<CheckCriticalPointValidity\>\"", "\[Rule]", "False"}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->473597541,ExpressionUUID->"cad78753-fff6-4b7c-a62d-9b21103457ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10", ",", "10"}], "}"}]], "Output",
 CellLabel->"Out[6]=",
 CellID->189231089,ExpressionUUID->"6f178383-b02d-4735-b024-df8cdaaf4e93"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Graphing Sector Drops", "TechNoteSection",
 CellID->1221267223,ExpressionUUID->"b6915e52-98e5-4435-b95d-31edcd3eecd1"],

Cell["\<\
SectorDropGraph draws the sector graph. Nodes are sectors, arrows point from \
subsectors to immediate supersectors, and node labels are singularity indices.\
\>", "TechNoteText",
 CellID->562188352,ExpressionUUID->"46c6b3f6-c22e-4afb-9d6b-8b218a74ebea"],

Cell[BoxData[
 RowBox[{"SectorDropGraph", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet"}], "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->244333380,ExpressionUUID->"c15607d3-0078-4a86-9ad3-38b433ff36e3"],

Cell[BoxData[
 RowBox[{"SectorDropGraph", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", 
   RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", "True"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->487322237,ExpressionUUID->"47369d99-a436-426f-b630-4122e771aa4f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Performance", "TechNoteSection",
 CellID->1635953384,ExpressionUUID->"b74b59d4-6ebd-42c1-a159-eba4f781b5f0"],

Cell["\<\
By default, DiscKosky uses msolve when the executable is available. Setting \
\"msolve\" -> False forces Mathematica's built-in GroebnerBasis workflow and \
can be much slower on difficult examples.\
\>", "TechNoteText",
 CellID->332317216,ExpressionUUID->"0c9f66de-5522-4e50-9d73-3ff5b14f16b9"],

Cell[BoxData[{
 RowBox[{"AbsoluteTiming", "[", 
