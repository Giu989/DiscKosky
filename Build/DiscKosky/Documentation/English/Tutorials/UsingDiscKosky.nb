  FontFamily->"Source Sans Pro",ExpressionUUID->
  "41f3a80d-a535-4fab-9d95-5ff5f617c48b"],
 "."
}], "TechNoteText",
 CellID->2136772585,ExpressionUUID->"45592c5c-6f36-4154-834c-2d828053fe84"],

