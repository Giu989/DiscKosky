Cell[TextData[{
 "Compared to ",
 Cell[BoxData["dM1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "acade065-cfc7-44ff-9117-b75e0afb113e"],
 ", four new singularities (",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "68c635e9-fd43-40d5-b2a0-9b3be841765d"],
 ", ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "6", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e878f2e9-a1fd-44e9-a581-92fe6ea517dd"],
 ", ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "7", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "009f7cb2-929d-4bda-bf2e-e863e70d4aa5"],
 ", and ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "8", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "50188522-4dfe-421f-a426-6028af3582ba"],
 ") can now be identified as giving rise to non-repeating discontinuities. \
Any ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b9b26dcb-2ecc-4b29-91b6-873f8a4d6dbe"],
 " entries that the refined algorithm cannot resolve are conservatively set \
to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ff7afcb4-0395-4bea-9b66-02021f8aee37"],
 "."
}], "TechNoteText",
 CellID->1528055918,ExpressionUUID->"5eeff0af-7138-4a85-afc6-b02062480d4f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sequences of Discontinuities", "Subsection",
 CellID->654515079,ExpressionUUID->"ccb41134-d61b-491a-85d8-534bd1b84f39"],

Cell[TextData[{
 "The function ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CheckSequentialDiscontinuity"]], 
    "paclet:DiscKosky/ref/CheckSequentialDiscontinuity", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f7f29a96-d4bf-46e2-8086-7053ecd2071c"],
 " works in a very similar manner, except that it tests for a specific string \
of discontinuities ",
 "of any length. It takes four inputs: the same three as above, and a \
specific sequence to test, ",
 "given as a list of positions in ",
 Cell[BoxData["sings"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "adcfdf30-2124-4679-8d1e-c628a1969744"],
 "."
}], "TechNoteText",
 CellID->1158688030,ExpressionUUID->"3df7420d-e3b8-488f-bf02-2bbba4400063"],

Cell[TextData[{
 "Test whether discontinuities with respect to ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01f80247-9050-455e-91f7-2628dbaac13a"],
 ", ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "9", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "693e77a3-0c76-47d6-ae00-0443b1f3af54"],
 ", and ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "7", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1eb2f99-3cb9-4968-bc65-e46c0e679be2"],
 " can appear in this order:"
}], "TechNoteMathCaption",
 CellID->1451455643,ExpressionUUID->"4e09050a-f4b4-417c-aabd-e57f1fcd2aa2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CheckSequentialDiscontinuity", "[", 
  RowBox[{"g", ",", "vars", ",", "sings", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "9", ",", "7"}], "}"}], ",", 
   RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", "True"}]}], 
  "]"}]], "Input",
