          4} -> Placed[{
            Pane[
             Style["{x2, x4}", 10, 
              GrayLevel[0.15]], FrameMargins -> {{0, 0}, {7, 0}}], 
            Pane[
             Style["{4}", 10, Bold, 
              RGBColor[0.55, 0.1, 0.08]], 
             FrameMargins -> {{0, 0}, {0, 7}}]}, {Above, Below}], {2, 3, 4} -> 
         Placed[
           Pane[
            Style["{x2, x3, x4}", 10, 
             GrayLevel[0.15]], FrameMargins -> {{0, 0}, {7, 0}}], Above], {1, 
          3} -> Placed[{
            Pane[
             Style["{x1, x3}", 10, 
              GrayLevel[0.15]], FrameMargins -> {{0, 0}, {7, 0}}], 
            Pane[
             Style["{1}", 10, Bold, 
