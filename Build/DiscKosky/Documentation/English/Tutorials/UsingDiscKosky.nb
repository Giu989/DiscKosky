 CellID->1148871023,ExpressionUUID->"15b5122f-4573-4dab-805a-272113105fc7"]
}, Open  ]],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "90655185-1896-43e9-a037-28f257c0c141"],
 " indicates that a higher-dimensional solution to the ",
 "critical point equations has been found. The entry in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "b30d2d80-0736-4947-b215-d609d8735b0d"],
 " row and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["j", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "563bd2c3-dee7-4a4b-90d0-1029c6dd78f5"],
 " column of this matrix, namely ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c2f6c541-742f-47bb-b89f-bc984624a046"],
 ", tells us whether a discontinuity with respect to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["j", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "84137bb4-db39-4f68-bd9c-b42b2d1addd7"],
 " singularity can follow a discontinuity with respect to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "b75ef413-db78-45d3-83f3-82e4a0a55aa7"],
 " singularity. Namely, if ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab2791ca-e42e-430e-9282-89ff69088d27"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4ac45297-543d-4f44-a7fc-5dff5f1ded46"],
 ", this indicates that the Feynman integral ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "14a9adf0-1621-4883-996f-cde04eaae509"],
 " satisfies a genealogical constraint of the form"
}], "TechNoteText",
 CellID->1408544087,ExpressionUUID->"4aceda28-8083-4d21-b001-0db376797819"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["Disc", 
    RowBox[{"sings", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]], 
   "\[CenterEllipsis]", 
   SubscriptBox["Disc", 
    RowBox[{"sings", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]], 
   "\[CenterEllipsis]", "\[ScriptCapitalI]", "=", "0"}], 
  TraditionalForm]], "DisplayMath",
 CellID->1701802682,ExpressionUUID->"067c00cc-626c-4f71-b64b-233411f8486e"],

Cell[TextData[{
 "Conversely, if ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9e9949e3-755a-4892-ab2c-7af18f1e8aaa"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d0742e1d-58ae-4031-8d0b-f2901e5c8163"],
 ", such sequences of discontinuities are not ruled out by this method."
}], "TechNoteText",
 CellID->921957231,ExpressionUUID->"0559dfb2-79cd-46c4-b8d5-7f1ca1d1505a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Refining Indeterminate Entries", "Subsection",
 CellID->150763012,ExpressionUUID->"07c2cb2f-8662-450e-9b73-87d9f901e263"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a343c73-1603-4c19-b224-511ff49f18b1"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5248121a-c9ba-45de-b633-d1f129b196a7"],
 ", there are two ways one can proceed. Most directly, these entries indicate \
that the ",
 "critical point algorithm cannot be applied, so the conservative option is \
to treat such a ",
 "result as equivalent to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e2b84e9d-5c23-4062-b598-c1d0f8c0fde8"],
 ". However, more can be said in many of the cases in which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "561438da-12b2-448b-9099-1bfdca971610"],
 " solutions arise (such as when a sector that has no critical points in ",
 "generic kinematics becomes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc6e0a1c-0fb0-410c-9b95-606ca65e0b8b"],
 " in a singular limit). These more refined ",
 "predictions can be requested by using the option ",
 Cell[BoxData["\"\<RefineIndeterminates\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94c090fe-5a99-4442-a041-3e3cace7848e"],
 ", which can be passed to all of the core ",
 "DiscKosky",
 " functions."
}], "TechNoteText",
 CellID->951771314,ExpressionUUID->"4046989e-9214-4c71-9107-4285953d5096"],

Cell[TextData[{
 "Compute the double discontinuity matrix with ",
 Cell[BoxData["\"\<RefineIndeterminates\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1df2ce5e-28c5-495c-949e-f8ace6f90ed4"],
 " enabled:"
}], "TechNoteMathCaption",
 CellID->1638046882,ExpressionUUID->"3e4d91be-5fad-4a99-898a-d9d4038d09d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dM2", "=", 
   RowBox[{"CheckDoubleDiscontinuities", "[", 
    RowBox[{"g", ",", "vars", ",", "sings", ",", 
     RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1996661693,ExpressionUUID->"8c107370-eb41-4a21-b9f7-f8f58952c2d9"],

