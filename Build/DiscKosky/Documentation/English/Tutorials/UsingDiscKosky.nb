 CellID->696543383,ExpressionUUID->"07c73855-27b5-4c34-a442-4b7e850e2547"]
}, Open  ]],

Cell["\<\
A regulated count is useful as a check when critical points can move to \
infinity in the unregulated formulation.\
\>", "TechNoteText",
 CellID->176674680,ExpressionUUID->"85b7a768-5d3a-4b09-be3d-3a72eb6a230b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CountSectorsRegulated", "[", 
  RowBox[{"gpol", ",", "vars", ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->959152778,ExpressionUUID->"f048f620-fd2d-4ba4-84ab-011ada3d3757"],

