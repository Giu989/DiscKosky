Cell["\<\
Two-mass easy box integral. Each propagator is labeled by its integration \
variable.\
\>", "TechNoteCaption",
 CellID->2134284973,ExpressionUUID->"3818c915-d923-4675-9fa3-fdae6984e492"],

Cell[TextData[{
 "The kinematic variables of this integral are the masses of the two massive \
corners, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["m", "1", "2"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "1"], "+", 
       SubscriptBox["p", "2"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"66a40fcc-fecd-450b-a9ad-897a171d1f36"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["m", "2", "2"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "4"], "+", 
       SubscriptBox["p", "5"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"7d902109-9c8b-4ba1-aad1-d6ad42c884b2"],
 ", and the invariants ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "12"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "1"], "+", 
       SubscriptBox["p", "2"], "+", 
       SubscriptBox["p", "3"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"4fbd9c2b-e604-4c2f-810d-4510cb7b9eff"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "23"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "3"], "+", 
       SubscriptBox["p", "4"], "+", 
       SubscriptBox["p", "5"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"8d1239a3-08c2-436e-936b-cb897aec15f6"],
 "."
}], "TechNoteText",
 CellID->1600199884,ExpressionUUID->"8720b8d4-4de4-4393-81b6-ce1b4f909df1"],

Cell["\<\
For this integral, the Lee\[Dash]Pomeransky polynomial, the integration \
variables, and the candidate singularities are given by:\
\>", "TechNoteMathCaption",
 CellID->1891355317,ExpressionUUID->"cae138b0-3879-449b-9d24-8f4b6063a31f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sings", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      SuperscriptBox["m2", "2"], "-", "s12"}], ",", 
     RowBox[{
      SuperscriptBox["m1", "2"], "-", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->989529795,ExpressionUUID->"1c1605a2-ce61-4bc0-93d7-38fa3c534267"],

Cell[CellGroupData[{

Cell["Double Discontinuities", "Subsection",
 CellID->1283911587,ExpressionUUID->"9d7f09c4-67c3-4c21-b8d3-950300cf2313"],

Cell[TextData[{
 "Given these arguments, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CheckDoubleDiscontinuities"]], 
    "paclet:DiscKosky/ref/CheckDoubleDiscontinuities", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4dc3eabb-9084-452a-a85b-a0272e1a7295"],
 " produces a matrix that tells the user which ordered sequences of \
discontinuities can appear ",
 "in the Feynman integral."
}], "TechNoteText",
 CellID->1755027163,ExpressionUUID->"f8389ee9-64fd-47ee-9d2d-12dc694555fa"],

Cell["\<\
Compute the double discontinuity matrix and display it in matrix form:\
\>", "TechNoteMathCaption",
 CellID->565328207,ExpressionUUID->"69a3aad1-b717-4389-8f95-b1da2fe465bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dM1", "=", 
   RowBox[{"CheckDoubleDiscontinuities", "[", 
    RowBox[{"g", ",", "vars", ",", "sings"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->1283030017,ExpressionUUID->"cbfab5c2-b099-495a-a5bf-5c361c930706"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dM1", "//", "MatrixForm"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->797771126,ExpressionUUID->"39768d0b-b635-47c4-957e-66c3271aea37"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"True", "False", "False", "False", "Indeterminate", "Indeterminate", 
      "False", "False", "True", "True"},
     {"False", "True", "False", "False", "Indeterminate", "False", "False", 
      "Indeterminate", "True", "True"},
     {"False", "False", "True", "False", "False", "Indeterminate", 
      "Indeterminate", "False", "True", "True"},
     {"False", "False", "False", "True", "False", "False", "Indeterminate", 
      "Indeterminate", "True", "True"},
     {"False", "False", "False", "False", "Indeterminate", "False", "False", 
      "False", "True", "True"},
     {"False", "False", "False", "False", "False", "Indeterminate", "False", 
      "False", "True", "True"},
     {"False", "False", "False", "False", "False", "False", "Indeterminate", 
      "False", "True", "True"},
     {"False", "False", "False", "False", "False", "False", "False", 
      "Indeterminate", "True", "True"},
     {"False", "False", "False", "False", "False", "False", "False", "False", 
      "True", "True"},
     {"False", "False", "False", "False", "False", "False", "False", "False", 
