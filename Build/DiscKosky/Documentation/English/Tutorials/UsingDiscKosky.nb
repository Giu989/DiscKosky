      RowBox[{"x1", ",", "x3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "x4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x2", ",", "x3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x2", ",", "x4"}], "}"}], ",", 
