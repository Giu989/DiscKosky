Cell["\<\
A regulated count is useful as a check when critical points can move to \
infinity in the unregulated formulation.\
\>", "TechNoteText",
 CellID->176674680,ExpressionUUID->"1357c0ff-0b25-46d5-b818-28a9de289f5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CountSectorsRegulated", "[", 
  RowBox[{"gpol", ",", "vars", ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->959152778,ExpressionUUID->"7606f145-33e0-44be-a8e0-66c1f5b65314"],

