Cell["\<\
DiscKosky is a Wolfram Language paclet for studying sector-by-sector critical \
point counts and repeated discontinuity structure of Feynman integrals.\
\>", "TechNoteText",
 CellID->898362796,ExpressionUUID->"e7804fae-2112-40ba-ba93-e2879f0394df"],

Cell["\<\
The examples below use the small graph example from \
dev_tests/simple_example.m.\
\>", "TechNoteText",
 CellID->1452817362,ExpressionUUID->"86e7d961-02c3-4e2f-b5ee-d8a81fa9a53b"],

Cell["Loading the Package", "TechNoteMathCaption",
 CellID->1014577915,ExpressionUUID->"c867624e-513a-4169-90f9-24a121b9a9aa"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<DiscKosky`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1629665133,ExpressionUUID->"4937dabb-7460-4076-aef6-069dd222e098"],

Cell[CellGroupData[{

Cell["A Small Polynomial and Alphabet", "TechNoteSection",
 CellID->1200482625,ExpressionUUID->"3393bba8-4edb-4530-b4ee-9308a53b0477"],

Cell["\<\
Start with a polynomial, the propagator variables, and an ordered list of \
singularities.\
\>", "TechNoteText",
 CellID->381582614,ExpressionUUID->"fb7c3d63-9139-4a28-a0b0-7cc6135fabf2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->314500041,ExpressionUUID->"dac65235-ceb9-4ad8-b6f1-175a86c68700"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Counting Sectors", "TechNoteSection",
 CellID->457319930,ExpressionUUID->"324fa7ba-50d0-4770-86ef-57ba0fefd306"],

Cell["\<\
CountSectorsUnregulated returns {total, sectorCounts, sectors}. The third \
argument is a list of cut variables; only sectors containing all cut \
variables are counted.\
\>", "TechNoteText",
 CellID->1047698328,ExpressionUUID->"2c83baab-060d-4186-a418-77e0b9019823"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CountSectorsUnregulated", "[", 
  RowBox[{"gpol", ",", "vars", ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->274810544,ExpressionUUID->"4776f368-6c8d-41de-9212-8960070e8d50"],

