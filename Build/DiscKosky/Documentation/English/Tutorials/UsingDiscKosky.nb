 CellID->1893017526,ExpressionUUID->"f70e1015-22bc-4c45-aa33-17c178947afd"],

Cell["\<\
DiscKosky also exposes some lower-level functions that can be used to \
identify nonzero sequences of discontinuities.\
\>", "TechNoteText",
 CellID->208849413,ExpressionUUID->"0e0e76f9-c434-40ff-b1f8-4e3158040c4e"],

Cell[BoxData[GridBox[{
   {
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["CountSectorsUnregulated"]], 
       "paclet:DiscKosky/ref/CountSectorsUnregulated", 
       "DiscKosky Package Symbol"},
      "PackageLink",
