 CellID->567539839,ExpressionUUID->"f4b71c41-bd90-4545-8033-8feff0f6f9a9"],

Cell["\<\
Two-mass easy box integral. Each propagator is labeled by its integration \
variable.\
\>", "TechNoteCaption",
 CellID->2134284973,ExpressionUUID->"fbdcc7ca-0463-49a7-bf9f-ef5aa2b4b561"],

Cell[TextData[{
 "The kinematic variables of this integral are the masses of the two massive \
corners, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["m", "1", "2"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "1"], "+", 
       SubscriptBox["p", "2"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"b51b8f2a-16fa-4790-89b0-6e6a0053321c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["m", "2", "2"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "4"], "+", 
       SubscriptBox["p", "5"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"cc950c66-f86e-40bf-9422-f7ac8d64e2d4"],
 ", and the invariants ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "12"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "1"], "+", 
       SubscriptBox["p", "2"], "+", 
       SubscriptBox["p", "3"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"8a15b971-05d3-47cb-a835-fce30eb7c31d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "23"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "3"], "+", 
       SubscriptBox["p", "4"], "+", 
       SubscriptBox["p", "5"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"a024bd71-ae51-4b89-b4b8-fc397bcad97f"],
 "."
}], "TechNoteText",
 CellID->1600199884,ExpressionUUID->"6cbbd769-8467-46a2-a77f-fb47e1438e31"],

Cell["\<\
For this integral, the Lee\[Dash]Pomeransky polynomial, the integration \
variables, and the candidate singularities are given by:\
\>", "TechNoteMathCaption",
 CellID->1891355317,ExpressionUUID->"2b8c13f0-a585-4298-bfb0-4d12f35ba134"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sings", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      SuperscriptBox["m2", "2"], "-", "s12"}], ",", 
     RowBox[{
      SuperscriptBox["m1", "2"], "-", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->989529795,ExpressionUUID->"64962b73-224b-4ceb-b60a-b532bd037296"],

Cell[CellGroupData[{

Cell["Double Discontinuities", "Subsection",
 CellID->1283911587,ExpressionUUID->"cad09603-cc88-4adf-9bb2-462322ac40c7"],

Cell[TextData[{
 "Given these arguments, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CheckDoubleDiscontinuities"]], 
    "paclet:DiscKosky/ref/CheckDoubleDiscontinuities", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ae3d698-1f0c-4cf3-bfce-36adeabcd72d"],
 " produces a matrix that tells the user which ordered sequences of \
discontinuities can appear ",
 "in the Feynman integral."
}], "TechNoteText",
 CellID->1755027163,ExpressionUUID->"2aab8ab4-91c4-4754-91f0-65037c9585bb"],

Cell["\<\
Compute the double discontinuity matrix and display it in matrix form:\
\>", "TechNoteMathCaption",
 CellID->565328207,ExpressionUUID->"6d67231e-12c4-4ada-9d1d-62ae2425d521"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dM1", "=", 
   RowBox[{"CheckDoubleDiscontinuities", "[", 
    RowBox[{"g", ",", "vars", ",", "sings"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->1283030017,ExpressionUUID->"82e09dfa-c667-4e7f-90fc-347e1e3f4af2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dM1", "//", "MatrixForm"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->797771126,ExpressionUUID->"2115f7c5-2e9b-45f7-962b-9e8f23631575"],

Cell[BoxData[
 TagBox[
