 CellLabel->"Out[4]=",
 CellID->1816070719,ExpressionUUID->"ea49b50b-504b-47f2-a116-a35ff19cdd4d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Checking Discontinuities", "TechNoteSection",
 CellID->1669212534,ExpressionUUID->"9bacea2a-15b1-4613-8593-a8c289336e8a"],

Cell["\<\
CheckRepeatedDiscontinuity tests an ordered sequence of singularity indices. \
CheckDoubleDiscontinuities builds the pairwise matrix.\
\>", "TechNoteText",
 CellID->1457276726,ExpressionUUID->"c27395f1-a578-4108-b416-1d93c03fde79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CheckRepeatedDiscontinuity", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "9"}], "}"}], ",", 
   RowBox[{"\"\<CheckCriticalPointValidity\>\"", "\[Rule]", "False"}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1566422874,ExpressionUUID->"f7a909a7-7da5-414a-8628-bc0510006c94"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]=",
 CellID->1126264437,ExpressionUUID->"15107246-ab8e-4674-9f8f-ce734357325e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dimensions", "[", 
  RowBox[{"CheckDoubleDiscontinuities", "[", 
   RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", 
    RowBox[{"\"\<CheckCriticalPointValidity\>\"", "\[Rule]", "False"}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->473597541,ExpressionUUID->"3e6f0b2d-c2a1-46ba-8464-09a4077d6d9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10", ",", "10"}], "}"}]], "Output",
 CellLabel->"Out[6]=",
 CellID->189231089,ExpressionUUID->"7715643a-46ae-4072-a489-4eb16749500b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Graphing Sector Drops", "TechNoteSection",
 CellID->1221267223,ExpressionUUID->"4ce26b54-2e0e-4f91-9711-bb3043d5d8c2"],

Cell["\<\
SectorDropGraph draws the sector graph. Nodes are sectors, arrows point from \
subsectors to immediate supersectors, node labels are singularity indices, \
and refined indeterminate labels are drawn in orange on arrows.\
\>", "TechNoteText",
 CellID->562188352,ExpressionUUID->"a3649315-fa8d-4709-8deb-e258f8fae555"],

Cell[BoxData[
 RowBox[{"SectorDropGraph", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet"}], "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->244333380,ExpressionUUID->"382dec56-d904-42f6-a9cc-206daaa2f3fb"],

Cell[BoxData[
 RowBox[{"SectorDropGraph", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", 
   RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", "True"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->487322237,ExpressionUUID->"a5034024-af36-497a-ac4d-7974bf59d429"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Performance", "TechNoteSection",
 CellID->1635953384,ExpressionUUID->"23cc401a-8124-4481-a423-6b03fd67f596"],

Cell["\<\
By default, DiscKosky uses msolve when the executable is available. Setting \
\"msolve\" -> False forces Mathematica's built-in GroebnerBasis workflow and \
can be much slower on difficult examples.\
\>", "TechNoteText",
 CellID->332317216,ExpressionUUID->"1decf39d-4bac-4edb-a43a-9163c9698200"],

Cell[BoxData[{
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"CountSectorsUnregulated", "[", 
    RowBox[{"gpol", ",", "vars", ",", 
     RowBox[{"{", "}"}]}], "]"}], ";"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"CountSectorsUnregulated", "[", 
    RowBox[{"gpol", ",", "vars", ",", 
     RowBox[{"{", "}"}], ",", 
     RowBox[{"\"\<msolve\>\"", "\[Rule]", "False"}]}], "]"}], ";"}], 
  "]"}]}], "Input",
 CellLabel->"In[9]:=",
 CellID->491912444,ExpressionUUID->"97414c2b-f31f-4149-b8ef-061ba296bcbc"]
}, Open  ]],

