        Medium], ArrowBox[{{0., 2.}, {1., 1.}}, 0.030239520958083826`], 
        ArrowBox[{{0., 2.}, {0., 1.}}, 0.030239520958083826`], 
        ArrowBox[{{1., 2.}, {2., 1.}}, 0.030239520958083826`], 
        ArrowBox[{{1., 2.}, {0., 1.}}, 0.030239520958083826`], 
        ArrowBox[{{2., 2.}, {1., 1.}}, 0.030239520958083826`], 
