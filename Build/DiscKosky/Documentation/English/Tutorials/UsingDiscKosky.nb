Cell[BoxData[
 RowBox[{"CountSectorsUnregulated", "[", 
  RowBox[{"g", ",", "vars", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], ",", 
   RowBox[{"\"\<Constraint\>\"", "\[Rule]", 
    RowBox[{
    "sings", "\[LeftDoubleBracket]", "10", "\[RightDoubleBracket]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[14]:=",
 CellID->269501507,ExpressionUUID->"64147a3b-0efd-423d-9597-f8f570634381"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[14]=",
 CellID->145267486,ExpressionUUID->"b8d0a676-641b-4d47-bb0d-75e44f4f856f"]
}, Open  ]],

Cell[TextData[{
 "This shows that one critical point is lost in the top sector when the \
condition ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "10", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4afc1416-ded0-4e32-a642-ec7e7f75ee88"],
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SubscriptBox["s", "12"], "+", 
     SubscriptBox["s", "23"], "-", 
     SubsuperscriptBox["m", "1", "2"], "-", 
     SubsuperscriptBox["m", "2", "2"]}], "=", "0"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"cf7db4a3-48b6-4334-bcfb-67264357f13d"],
 " is enforced on the external kinematics. This indicates that the \
corresponding ",
 "Lefschetz thimble can play the role of a vanishing cycle when a \
discontinuity is computed with ",
 "respect to the singularity at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["s", "12"], "+", 
     SubscriptBox["s", "23"], "-", 
     SubsuperscriptBox["m", "1", "2"], "-", 
     SubsuperscriptBox["m", "2", "2"]}], "=", "0"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"4f4bd923-3ec9-4410-8506-3411b374d4ed"],
 "."
}], "TechNoteText",
 CellID->968443475,ExpressionUUID->"039e9770-69e6-4b25-8fde-0f76405177d5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sectors Associated with a Singularity", "Subsection",
 CellID->537787826,ExpressionUUID->"b730eff9-82bc-43ee-b056-0da44ca031d8"],

Cell[TextData[{
 "It is also possible to access directly which on-shell lines (sectors) \
correspond to a ",
 "singularity with the command ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindSingularitySectors"]], 
    "paclet:DiscKosky/ref/FindSingularitySectors", "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3acda0a3-e1a1-4151-97fe-f68b6067576a"],
 ". This command takes as input a ",
 "Lee\[Dash]Pomeransky polynomial, a list of integration variables, the set \
of candidate Landau ",
 "singularities, and the index of the specific singularity to analyze."
}], "TechNoteText",
 CellID->1847605117,ExpressionUUID->"22da64ad-bf0e-4c8f-a0ae-76cc7ebac1f4"],

Cell[TextData[{
 "Find the sectors associated with the singularity ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "10", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "44c1a170-4af7-44c1-93dc-f0ff6ebeff4d"],
 ":"
}], "TechNoteMathCaption",
 CellID->262112485,ExpressionUUID->"1305c53c-8700-4cc0-a891-34aa741a47e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindSingularitySectors", "[", 
  RowBox[{"g", ",", "vars", ",", "sings", ",", "10"}], "]"}]], "Input",
 CellLabel->"In[15]:=",
 CellID->1006350987,ExpressionUUID->"6e1f6f1a-ec06-41d2-96cf-6b46ededa8bc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[15]=",
 CellID->1969214210,ExpressionUUID->"f0d541e3-303d-46da-ba82-823f8b938d8a"]
}, Open  ]],

Cell[TextData[{
 "This shows that the singularity at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["s", "12"], "+", 
     SubscriptBox["s", "23"], "-", 
     SubsuperscriptBox["m", "1", "2"], "-", 
     SubsuperscriptBox["m", "2", "2"]}], "=", "0"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"541cdd5b-fdf6-4c1b-973d-e0a71ac5727c"],
 " is associated with (only) the top sector of the one-loop box."
}], "TechNoteText",
 CellID->1734725861,ExpressionUUID->"4f6c701d-b009-4032-85cf-7129fcc61ad5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Counting with Analytic Regulators", "Subsection",
 CellID->1503806100,ExpressionUUID->"0ba0be36-961f-44e5-95f4-8152f68e9102"],

Cell[TextData[{
 "Finally, ",
 "DiscKosky",
 " provides a public function for counting with analytic regulators. More ",
 "precisely, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CountSectorsRegulated"]], 
    "paclet:DiscKosky/ref/CountSectorsRegulated", "DiscKosky Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1b5b083a-c8b2-4efa-a943-5c78b0c58b6d"],
 " computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "n"], "\[Chi]", "(", 
    RowBox[{
     SuperscriptBox["\[DoubleStruckCapitalC]", "n"], "\[Backslash]", 
     RowBox[{"V", "(", 
      RowBox[{
       SubscriptBox["x", "1"], "\[CenterEllipsis]", 
       SubscriptBox["x", "n"], " ", "G"}], ")"}]}], ")"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"e11ff0ac-1681-4aed-abf8-cea5b74d70d9"],
 ", where ",
 Cell[BoxData[
  FormBox["\[Chi]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "2b3eb2e2-1caa-48c8-842a-be8eaea4b4d3"],
 " is the Euler characteristic, ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineMath",ExpressionUUID->
  "b1282e50-a75c-40e6-96d6-086a5eeb71b4"],
 " is the number of integration variables, and ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineMath",ExpressionUUID->
  "05febb70-0a78-4ce6-88b2-0a533a26909b"],
 " is the Lee\[Dash]Pomeransky polynomial. This can ",
 StyleBox["always",
  FontSlant->"Italic"],
 " be interpreted as the number of master integrals of the (regulated) \
Feynman integral. In most ",
 "cases, the output of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CountSectorsUnregulated"]], 
    "paclet:DiscKosky/ref/CountSectorsUnregulated", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "beab71e4-19a0-4b03-acfb-efc804ed793b"],
 " will agree with this more rigorous ",
 "computation."
}], "TechNoteText",
 CellID->169674101,ExpressionUUID->"7c88adee-8dc6-421e-a4f3-b1748c5109a9"],

Cell["\<\
Compare the total number of critical points from the unregulated and \
regulated counts:\
\>", "TechNoteMathCaption",
 CellID->1651998800,ExpressionUUID->"13ba08ea-845a-4745-b077-41ee3be5558a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
