Cell["\<\
DiscKosky is a package for studying the repeated discontinuity structure of \
Euler integrals. This is done primarily by counting the number of critical \
points associated to the Feynman integral.\
\>", "TechNoteText",
 CellID->898362796,ExpressionUUID->"cc95b78d-e502-4bb2-b52a-90f8b2770e96"],

Cell["\<\
This tech note introduces the most important commands of DiscKosky, \
illustrated on a simple one-loop example. More details on each function and \
its options can be found on the corresponding reference pages.\
\>", "TechNoteText",
 CellID->1942604819,ExpressionUUID->"bbe27463-0d4b-427a-9dca-5e454ba7bf07"],

Cell["Load the package:", "TechNoteMathCaption",
 CellID->1014577915,ExpressionUUID->"ac3a588c-629b-4bf2-a2e9-d380ae05545b"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<DiscKosky`\>\"", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1022905431,ExpressionUUID->"ea6b5ea1-1085-4320-b962-c9f235448776"],

Cell[CellGroupData[{

Cell["Core Usage", "TechNoteSection",
 CellID->1951386777,ExpressionUUID->"f0fa02ee-68ba-4030-aae5-4945f24ab7a1"],

Cell[TextData[{
 "DiscKosky",
 " provides three main high-level functions for predicting sequential \
discontinuities: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CheckDoubleDiscontinuities"]], 
    "paclet:DiscKosky/ref/CheckDoubleDiscontinuities", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4921a017-dd83-4853-aa51-aeb3ad69e230"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CheckSequentialDiscontinuity"]], 
    "paclet:DiscKosky/ref/CheckSequentialDiscontinuity", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0c845d90-2580-42d6-a2cc-d176c657be1c"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SectorDropGraph"]], "paclet:DiscKosky/ref/SectorDropGraph", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "675f109c-a16f-41b8-8114-519273904ee8"],
 "."
}], "TechNoteText",
 CellID->987825340,ExpressionUUID->"37af1dd4-df6a-4475-8569-cc2c99874c44"],

