Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CountSectorsUnregulated", "[", 
  RowBox[{"g", ",", "vars", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], ",", 
   RowBox[{"\"\<Constraint\>\"", "\[Rule]", 
    RowBox[{
    "sings", "\[LeftDoubleBracket]", "10", "\[RightDoubleBracket]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[14]:=",
 CellID->269501507,ExpressionUUID->"43869a43-14eb-4a2e-82f7-fc402dd0725a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[14]=",
 CellID->145267486,ExpressionUUID->"8cc03017-6232-4405-ad6f-6e3b780052ae"]
}, Open  ]],

Cell[TextData[{
 "This shows that one critical point is lost in the top sector when the \
condition ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "10", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f6dad296-e052-45a9-8059-e2449a8b25ec"],
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SubscriptBox["s", "12"], "+", 
     SubscriptBox["s", "23"], "-", 
     SubsuperscriptBox["m", "1", "2"], "-", 
     SubsuperscriptBox["m", "2", "2"]}], "=", "0"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"620df42f-39e9-4613-95a4-d7b6a94fc070"],
 " is enforced on the external kinematics. This indicates that the \
corresponding ",
 "Lefschetz thimble can play the role of a vanishing cycle when a \
discontinuity is computed with ",
 "respect to the singularity at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["s", "12"], "+", 
     SubscriptBox["s", "23"], "-", 
     SubsuperscriptBox["m", "1", "2"], "-", 
     SubsuperscriptBox["m", "2", "2"]}], "=", "0"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"3e62c8b4-222c-4ef9-8615-9555049ba421"],
 "."
}], "TechNoteText",
 CellID->968443475,ExpressionUUID->"19fe1d65-571c-4915-a851-2cd154a405b0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sectors Associated with a Singularity", "Subsection",
 CellID->537787826,ExpressionUUID->"4fbf373a-48f1-4c5a-97db-9888e85a81e8"],

Cell[TextData[{
 "It is also possible to access directly which on-shell lines (sectors) \
correspond to a ",
 "singularity with the command ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindSingularitySectors"]], 
    "paclet:DiscKosky/ref/FindSingularitySectors", "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5b4d6171-ae1e-4283-851a-269cad758c6c"],
 ". This command takes as input a ",
 "Lee\[Dash]Pomeransky polynomial, a list of integration variables, the set \
of candidate Landau ",
 "singularities, and the index of the specific singularity to analyze."
}], "TechNoteText",
 CellID->1847605117,ExpressionUUID->"d26fd7b4-839f-4337-aa77-305e0570f9f2"],

Cell[TextData[{
 "Find the sectors associated with the singularity ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "10", "\[RightDoubleBracket]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33565c21-a417-4bce-a787-8f12f1d3df3c"],
 ":"
}], "TechNoteMathCaption",
 CellID->262112485,ExpressionUUID->"2fab4fc7-da60-4470-a5fe-b359342fa37d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindSingularitySectors", "[", 
  RowBox[{"g", ",", "vars", ",", "sings", ",", "10"}], "]"}]], "Input",
 CellLabel->"In[15]:=",
 CellID->1006350987,ExpressionUUID->"02dc40d5-f859-4ff9-97e1-1115554235c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[15]=",
 CellID->1969214210,ExpressionUUID->"b691d0d5-34b3-4f3a-a2c4-970baaaf2e76"]
}, Open  ]],

Cell[TextData[{
 "This shows that the singularity at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["s", "12"], "+", 
     SubscriptBox["s", "23"], "-", 
     SubsuperscriptBox["m", "1", "2"], "-", 
     SubsuperscriptBox["m", "2", "2"]}], "=", "0"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"85825708-a123-40f2-ad1f-fb90feba5a6b"],
 " is associated with (only) the top sector of the one-loop box."
}], "TechNoteText",
 CellID->1734725861,ExpressionUUID->"1a7d28bc-0543-4a8d-8907-92a638d4c6e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Counting with Analytic Regulators", "Subsection",
 CellID->1503806100,ExpressionUUID->"8ae50659-6136-4b0d-b8cb-0a05a3e3c178"],

Cell[TextData[{
 "Finally, ",
 "DiscKosky",
 " provides a public function for counting with analytic regulators. More ",
 "precisely, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CountSectorsRegulated"]], 
    "paclet:DiscKosky/ref/CountSectorsRegulated", "DiscKosky Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98186729-9d71-4825-8318-80c7c1d650c3"],
 " computes the Euler characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "(", 
    RowBox[{
     SuperscriptBox["\[DoubleStruckCapitalC]", "n"], "\[Backslash]", 
     RowBox[{"V", "(", 
      RowBox[{
       SubscriptBox["x", "1"], "\[CenterEllipsis]", 
       SubscriptBox["x", "n"], " ", "G"}], ")"}]}], ")"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"f15e0ccb-a145-4432-95f2-570535bd3120"],
 ", where ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineMath",ExpressionUUID->
  "5e1b1e8e-05e9-4320-8d31-0bcdbaa00046"],
 " is the Lee\[Dash]Pomeransky polynomial. This can ",
 StyleBox["always",
  FontSlant->"Italic"],
 " be interpreted as the number of master integrals of the (regulated) \
Feynman integral. In most ",
 "cases, the output of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CountSectorsUnregulated"]], 
    "paclet:DiscKosky/ref/CountSectorsUnregulated", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ec53a294-c700-428b-8049-81fbac31a010"],
 " will agree with this more rigorous ",
 "computation."
}], "TechNoteText",
 CellID->169674101,ExpressionUUID->"60f0106f-04cf-447a-887a-9928107f5cb8"],

Cell["\<\
Compare the total number of critical points from the unregulated and \
regulated counts:\
\>", "TechNoteMathCaption",
 CellID->1651998800,ExpressionUUID->"5ede502b-86ae-4a1f-aee0-80727982963c"],

