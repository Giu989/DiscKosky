 CellLabel->"Out[4]=",
 CellID->1816070719,ExpressionUUID->"74d925a7-cb1b-4c12-aab3-c96d0dd592aa"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Checking Discontinuities", "TechNoteSection",
 CellID->1669212534,ExpressionUUID->"b7e80895-868f-4c61-b7d9-9a245465831a"],

Cell["\<\
CheckSequentialDiscontinuity tests an ordered sequence of singularity \
indices. CheckDoubleDiscontinuities builds the pairwise matrix.\
\>", "TechNoteText",
 CellID->1457276726,ExpressionUUID->"621a2371-81a3-40b5-84ce-bb35ea3d6c27"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CheckSequentialDiscontinuity", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "9"}], "}"}], ",", 
   RowBox[{"\"\<CheckCriticalPointValidity\>\"", "\[Rule]", "False"}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1566422874,ExpressionUUID->"14472bf8-1868-44a2-9d4f-b49a15f6224a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]=",
 CellID->1126264437,ExpressionUUID->"ea44d281-1d3a-4ee2-9c8a-314874e82914"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dimensions", "[", 
  RowBox[{"CheckDoubleDiscontinuities", "[", 
   RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", 
    RowBox[{"\"\<CheckCriticalPointValidity\>\"", "\[Rule]", "False"}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->473597541,ExpressionUUID->"d4bb8531-193a-4112-b0b7-2d457add82cb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10", ",", "10"}], "}"}]], "Output",
