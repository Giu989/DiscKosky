Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GroebnerBasisMS"]], "paclet:DiscKosky/ref/GroebnerBasisMS", 
     "DiscKosky Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["ideal", "TI"], ",", 
    StyleBox["vars", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "870cd8e4-cb59-4c22-9581-1992206e9c1e"],
 ", ",
 Cell[BoxData[
  StyleBox["ideal", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5ed5160d-d2ad-4305-9e79-6b0ab8753f0d"],
 " is a list of polynomials with rational coefficients, and ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "49ec4d72-6bee-48de-b50a-43a3ce2713b8"],
 " is a list of distinct variables that includes every variable appearing in ",
 Cell[BoxData[
  StyleBox["ideal", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e0effb2a-e7e0-4bf8-a2a0-8821f73261a9"],
 "."
}], "Notes",
 CellID->268713426,ExpressionUUID->"321ad6d2-5a79-4572-b9bc-d3fe7ce90803"],

Cell[TextData[{
 "The result is a list of polynomials that form a Groebner basis of ",
 Cell[BoxData[
  StyleBox["ideal", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "93a9671a-ac18-44cb-a594-cb72a8cfda9e"],
 " for the degree reverse lexicographic monomial order, with the variables \
ordered as in ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e1dff822-561f-439b-85e0-56ec4d6bd4bb"],
 ". If msolve is not found or fails, or the input is not valid, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GroebnerBasisMS"]], "paclet:DiscKosky/ref/GroebnerBasisMS", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab00fae0-4ee2-4ab2-9d5e-3ec3531a715a"],
 " prints an error message and returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "15ee1e16-c873-4f21-92b7-9fa329ac6335"],
 "."
}], "Notes",
 CellID->2094002344,ExpressionUUID->"b8a2eecc-202f-41dc-91f0-cc4ebd359221"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GroebnerBasisMS"]], "paclet:DiscKosky/ref/GroebnerBasisMS", 
     "DiscKosky Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["jobs", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "952a188c-ec9c-4614-afde-d75b40614235"],
 ", each element of ",
 Cell[BoxData[
  StyleBox["jobs", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c3618b85-cb3b-40c9-bf12-05a7199f0bbc"],
 " can be an association ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\"\<Ideal\>\"", "\[Rule]", 
     StyleBox["ideal", "TI"]}], ",", 
    RowBox[{"\"\<Variables\>\"", "\[Rule]", 
     StyleBox["vars", "TI"]}]}], "\[RightAssociation]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "60693f14-4a2b-44cb-9171-593d4c942391"],
 " or a pair ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["ideal", "TI"], ",", 
    StyleBox["vars", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "03734ffb-0ea6-4b5d-a4da-5b0f86b0b03b"],
 ". The result is a list containing the Groebner basis of each job, in the \
order of ",
 Cell[BoxData[
  StyleBox["jobs", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "18cec3e1-24cf-4757-9a2c-fc13ca15b4e0"],
 ", or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "842e3d3f-0110-4379-89e3-33dac6256ae3"],
 " if any job fails."
}], "Notes",
 CellID->419528080,ExpressionUUID->"e5f48866-df1d-44b5-a6cb-d30f4980e48e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GroebnerBasisMS"]], "paclet:DiscKosky/ref/GroebnerBasisMS", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5c6e38f1-6dc9-4d87-87f6-c79fbb2dc781"],
 " requires the msolve executable, which is looked up on the bash PATH or in \
the directory given in the paclet file Kernel/paths.m. If msolve is not \
available, use the built-in ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GroebnerBasis"]], "paclet:ref/GroebnerBasis"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    StyleBox["ideal", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    RowBox[{"MonomialOrder", "\[Rule]", "DegreeReverseLexicographic"}]}], 
   "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2164cd1e-7a3f-4ce9-b91e-2eb0e97a77f1"],
 " for small examples."
}], "Notes",
 CellID->714703331,ExpressionUUID->"401b8607-56a7-4855-a083-004a93c06dc3"],

Cell[TextData[{
 "The options ",
 Cell[BoxData["\"\<MSolveJobs\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5cf7ec04-a9d8-4003-a1a1-32c552521d78"],
 " and ",
 Cell[BoxData["\"\<msolveParallelThreads\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ee235d9b-912f-4b9d-9b8f-ea74b9130c61"],
 " control how many msolve jobs are run in parallel and how many threads each \
job uses."
}], "Notes",
 CellID->971922940,ExpressionUUID->"2859f1c2-ae2f-430d-b332-64809896c7e7"],

Cell[TextData[{
 "Variables listed in ",
 Cell[BoxData["\"\<EliminateVariables\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7d9514b5-43ed-40af-80bf-16f5a07275d8"],
 " must appear in every job, and at least one variable must remain."
}], "Notes",
 CellID->1638204517,ExpressionUUID->"b94f9912-c90d-499b-bdad-a8ba7f458ad7"],

Cell["The following options can be given:", "Notes",
