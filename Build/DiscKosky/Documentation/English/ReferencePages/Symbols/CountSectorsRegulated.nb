Cell["\<\
Regulated and unregulated counts can differ when points at infinity \
contribute. In such cases, the regulated approach produces the correct result:\
\>", "ExampleText",
 CellID->1600212169,ExpressionUUID->"4358a095-dc71-40ba-b7f1-64dbe9dbbf34"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "+", "x", "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"3", " ", "y"}], "+", 
    RowBox[{"6", " ", "x", " ", "y"}], "+", 
    RowBox[{"11", " ", 
     SuperscriptBox["x", "2"], " ", "y"}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "3"], " ", "y"}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["x", "2"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"19", " ", 
     SuperscriptBox["x", "3"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"18", " ", 
     SuperscriptBox["x", "4"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["x", "4"], " ", 
     SuperscriptBox["y", "3"]}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "5"], " ", 
     SuperscriptBox["y", "3"]}], "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "6"], " ", 
     SuperscriptBox["y", "4"]}]}]}], ";"}]], "Input",
 CellProlog:>Needs["DiscKosky`"],
 CellLabel->"In[1]:=",
 CellID->1134798046,ExpressionUUID->"f02d1bd0-148a-4f8a-a491-381987920d1a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"CountSectorsUnregulated", "[", 
   RowBox[{"f", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], ",", 
    RowBox[{"{", "}"}]}], "]"}], "\[LeftDoubleBracket]", "1", 
  "\[RightDoubleBracket]"}], "\[IndentingNewLine]", 
 RowBox[{"CountSectorsRegulated", "[", 
  RowBox[{"f", ",", 
