Cell["\<\
Define the Lee\[Dash]Pomeransky polynomial of the one-loop two-mass easy box \
and its integration variables:\
\>", "ExampleText",
 CellID->1616259346,ExpressionUUID->"0059cc34-3df7-435c-96ea-a20f27dc0b65"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}]}], "Input",\

 CellProlog:>Needs["DiscKosky`"],
 CellLabel->"In[1]:=",
 CellID->1192835785,ExpressionUUID->"06358330-753c-4217-a294-6aeebba9cbf3"],

