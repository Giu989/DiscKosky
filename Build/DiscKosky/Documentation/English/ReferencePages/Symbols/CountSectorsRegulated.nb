Cell["\<\
Regulated and unregulated counts can differ when points at infinity \
contribute. In such cases, the regulated approach produces the correct result.\
\>", "Notes",
 CellID->1600212169,ExpressionUUID->"d84f2be7-1e7c-4947-a900-246327ff028e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "+", "x", "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"3", " ", "y"}], "+", 
    RowBox[{"6", " ", "x", " ", "y"}], "+", 
    RowBox[{"11", " ", 
     SuperscriptBox["x", "2"], " ", "y"}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "3"], " ", "y"}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["x", "2"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"19", " ", 
     SuperscriptBox["x", "3"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"18", " ", 
     SuperscriptBox["x", "4"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
