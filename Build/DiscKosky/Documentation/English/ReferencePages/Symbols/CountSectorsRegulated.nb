Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CountSectorsRegulated"]], 
    "paclet:DiscKosky/ref/CountSectorsRegulated", "DiscKosky Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "18a3a1f0-d704-44f0-9238-1e8cf6cb3c9e"],
 " computes the number of critical points of a Feynman integral with analytic \
regulators, given by its Lee\[Dash]Pomeransky polynomial ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d46a8ec1-c7bc-4841-9a12-c2572d1e0c5b"],
 " in the integration variables ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3db7b5ca-07d3-40d5-80c2-23b16c2ef600"],
 "."
}], "Notes",
 CellID->1914533785,ExpressionUUID->"41195099-2c40-4fd3-8e6b-501bf56ebbd0"],

Cell[TextData[{
 "The variables in ",
 Cell[BoxData[
  StyleBox["cut", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "97e1c4b2-0024-4293-ba28-3167a3315adc"],
 " are not regulated, to mimic the effect of cutting the corresponding \
propagators. Use ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cut", "TI"], "=", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7e9af8ce-8459-4af8-a00c-47dbc3e4cb4b"],
 " when no propagators are cut."
}], "Notes",
 CellID->885746738,ExpressionUUID->"3bc847bb-38c3-4b1a-94a9-ef39eed37a86"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cut", "TI"], "=", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6d41fcf1-e43c-4ba0-aad5-ed0d65e9e042"],
 ", the result is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "n"], " ", "\[Chi]", "(", 
    RowBox[{
     SuperscriptBox["\[DoubleStruckCapitalC]", "n"], "\[Backslash]", 
     RowBox[{"V", "(", 
      RowBox[{
       SubscriptBox["x", "1"], "\[CenterEllipsis]", 
       SubscriptBox["x", "n"], " ", "G"}], ")"}]}], ")"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"dce71af2-ce38-4d50-bc03-2f2f50bacb34"],
 ", where ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineMath",ExpressionUUID->
  "db54de11-5d21-4bc7-a542-f62ab85ee308"],
 " is ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "932a2c1d-0717-4d05-9931-637d197230c9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox["x", "n"]}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "faa88949-cf7b-4157-a3cb-3908623445b9"],
 " are the variables in ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c95fe965-5ea9-4b11-b367-a81726931c76"],
 ". This is the number of master integrals of the regulated Feynman integral, \
not accounting for symmetries, and provides a global check on the \
sector-by-sector counts of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CountSectorsUnregulated"]], 
    "paclet:DiscKosky/ref/CountSectorsUnregulated", 
