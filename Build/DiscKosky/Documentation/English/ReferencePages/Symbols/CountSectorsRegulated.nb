Cell["\<\
CountSectorsRegulated computes the number of (regulated) critical points of \
the regulated ideal.\
\>", "Notes",
 CellID->1914533785,ExpressionUUID->"d1d3c83c-c27c-49f8-acb1-2fbf3577afcd"],

Cell[TextData[{
 "With an empty third argument, the result is the expected number of master \
integrals without symmetries for the chosen polynomial. If a non empty ",
 StyleBox["cut", "TI"],
 " is given, CountSectorsRegulated will ",
 StyleBox["not", "TI"],
 " regulate the variables given in the ",
 StyleBox["cut,", "TI"],
 " to mimic the effect of cutting these propagators."
}], "Notes",
 CellID->885746738,ExpressionUUID->"49218761-e3b1-4ee3-b138-365e92696fb4"],

Cell[TextData[{
 "This count is useful as a global check on sector-by-sector unregulated \
counts obtained with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CountSectorsUnregulated"]], 
    "paclet:DiscKosky/ref/CountSectorsUnregulated", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9285f26c-0075-43b5-a5dc-a7567dfaa876"]
}], "Notes",
