Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "66650a23-f26d-495d-a21b-f72166d8138a"],
 " is the Lee\[Dash]Pomeransky polynomial of the Feynman integral and ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "76accaa0-56d6-4014-8d57-86f2132a2a07"],
 " is the list of its integration variables, one for each propagator. ",
 Cell[BoxData[
  StyleBox["cut", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "74c18b14-16b4-43cd-844e-c32e61f608a4"],
 " lists the integration variables of the cut propagators; use ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "86196d1d-7fa1-4c3c-b375-154b3d98f3d7"],
 " when no propagators are cut."
}], "Notes",
 CellID->586972977,ExpressionUUID->"e0e8dd62-3628-43da-9fce-fbc9ba9ee075"],

Cell[TextData[{
 "All other symbols in ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f7ffb24e-eded-4ed9-b220-d55e023caeb2"],
 " are kinematic parameters and are given random numerical values, so the \
counts hold for generic kinematics. With the ",
 Cell[BoxData["\"\<Constraint\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "68b5d4a6-caad-415e-b53d-e07e37dc678b"],
 " option, they hold for generic kinematics on the locus where the given \
polynomial vanishes."
}], "Notes",
 CellID->961311688,ExpressionUUID->"186feb94-7a52-4f7f-ac5e-6cb63aec8865"],

Cell[TextData[{
 "Each sector is labeled by the list of integration variables that are not \
set to zero; this list always contains all the variables in ",
 Cell[BoxData[
  StyleBox["cut", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4391ca26-2059-42f0-8fc8-972cd93d2e47"],
 ". ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sectorCounts", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["k", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cd50d842-bd58-419e-a493-be6e9b97da03"],
 " is the number of critical points in the sector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sectors", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["k", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5a1217ee-349b-46c7-bd24-dc2c0e41e87e"],
 ", and ",
 Cell[BoxData[
  StyleBox["total", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cd7296fb-6db6-486a-a689-10bfc1444dfc"],
 " is the sum of ",
 Cell[BoxData[
  StyleBox["sectorCounts", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f3240e4a-2ce7-41ef-ba4b-81ad6a7cb288"],
 "."
}], "Notes",
 CellID->1133355265,ExpressionUUID->"8ffb9d6d-cc5a-4bcd-a09c-a64fc81154c8"],

Cell[TextData[{
 "If the critical points in a sector are not isolated, the corresponding \
entry of ",
 Cell[BoxData[
  StyleBox["sectorCounts", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "53483a01-a4ba-4a92-a5c2-93a4ac0ea6e9"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "95200daf-21d6-45bb-b4f7-e614a12144ca"],
 ", and so is ",
 Cell[BoxData[
  StyleBox["total", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e5649031-c982-4b01-a2da-8af7d81042b1"],
 ". If the computation cannot be carried out, for instance when ",
 Cell[BoxData[
  RowBox[{"\"\<msolve\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "62da7851-0b34-49bb-a5ae-a079db3aebf6"],
 " is given but the msolve executable is not found, an error is printed and \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6144d657-8074-436b-85ec-79acdbaada7b"],
 " is returned."
}], "Notes",
 CellID->709380178,ExpressionUUID->"767bdda7-ba20-4f90-8e4d-f3231130251a"],

