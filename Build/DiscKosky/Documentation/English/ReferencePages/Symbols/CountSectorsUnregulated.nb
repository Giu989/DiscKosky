Cell["\<\
Compare against the regulated count when critical points may move to infinity.\
\>", "Notes",
 CellID->1281127357,ExpressionUUID->"fb7452d6-b972-485f-a98a-3b7906779771"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "+", "x", "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"3", " ", "y"}], "+", 
    RowBox[{"6", " ", "x", " ", "y"}], "+", 
    RowBox[{"11", " ", 
     SuperscriptBox["x", "2"], " ", "y"}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "3"], " ", "y"}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["x", "2"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"19", " ", 
     SuperscriptBox["x", "3"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"18", " ", 
     SuperscriptBox["x", "4"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["x", "4"], " ", 
     SuperscriptBox["y", "3"]}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "5"], " ", 
     SuperscriptBox["y", "3"]}], "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "6"], " ", 
     SuperscriptBox["y", "4"]}]}]}], ";"}]], "Input",
