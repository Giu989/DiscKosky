Cell["\<\
Define the example polynomial used throughout the DiscKosky documentation.\
\>", "Notes",
 CellID->1681378749,ExpressionUUID->"1b91306c-b00e-49fc-90cf-e80789f0bff3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}]}], "Input",\

 CellProlog:>Needs["DiscKosky`"],
 CellLabel->"In[1]:=",
 CellID->1640206756,ExpressionUUID->"80bf4382-e1cc-47ff-984f-66f4d4937e01"],

