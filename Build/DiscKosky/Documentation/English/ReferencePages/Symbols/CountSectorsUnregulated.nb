Cell["\<\
Define the example polynomial used throughout the DiscKosky documentation.\
\>", "Notes",
 CellID->1681378749,ExpressionUUID->"28362b97-5a3a-41cb-9c43-fda317fbfdff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}]}], "Input",\

 CellProlog:>Needs["DiscKosky`"],
 CellLabel->"In[1]:=",
 CellID->1640206756,ExpressionUUID->"783c7e84-29c3-4d5f-b48a-3e3d806e4ec8"],

