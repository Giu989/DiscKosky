Cell["\<\
The Lee-Pomeransky polynomial for the one loop box \"two mass easy\"\
\>", "Notes",
 CellID->1681378749,ExpressionUUID->"36fd7c53-5530-49e7-92d0-559c07e94d3e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}]}], "Input",\

 CellProlog:>Needs["DiscKosky`"],
 CellLabel->"In[1]:=",
 CellID->1640206756,ExpressionUUID->"99e75744-0f1b-46d3-bf9f-55ca67ff162b"],

