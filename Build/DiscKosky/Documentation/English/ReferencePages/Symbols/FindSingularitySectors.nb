Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "77a838f4-2527-4af9-84e4-7f1e11954722"],
 " is the Lee\[Dash]Pomeransky polynomial of the Feynman integral, ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc8d98fd-42dc-48f8-bdfb-e44354c3bbb6"],
 " is the list of its integration variables, and ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9b67e24-b7ae-447f-b711-89a233a1f836"],
 " is the list of candidate singularities, given as polynomials in the \
external kinematic parameters; ",
 Cell[BoxData[
  StyleBox["index", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "788b48b7-abe4-4ca6-836c-ee0fcbc11b0e"],
 " is the position in ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "577cd275-3682-4af5-9082-11c38629cb8f"],
 " of the singularity to analyze."
}], "Notes",
 CellID->1355564270,ExpressionUUID->"303b73f9-f901-40c7-b97b-c98eba2fcceb"],

Cell[TextData[{
 "The result lists the sectors in which the number of critical points is \
smaller on the support of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["index", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cefb214d-7d25-4ebc-aa93-9eb9c362e2eb"],
 " than for generic kinematics, or by those in which this number is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d567bd2e-2773-4ba0-ba35-528754781135"],
 ", indicating a higher-dimensional solution to the critical point equations. \
Each sector is given as the list of integration variables that are not set to \
zero in it, so that ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"x1", ",", "x3"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3a882ecf-2b7f-46a5-9b4f-afc52f6ea1bc"],
 " denotes the sector ",
 Cell[BoxData[
  RowBox[{"x2", "=", "x4", "=", "0"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01316d1b-4a62-4055-ad6e-828ca0ea9a09"],
 "."
}], "Notes",
 CellID->597805011,ExpressionUUID->"402fb64d-577f-456b-9577-0ceb1c6259d9"],

