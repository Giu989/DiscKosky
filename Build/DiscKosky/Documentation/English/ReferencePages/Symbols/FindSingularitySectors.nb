Cell["\<\
Define the Lee\[Dash]Pomeransky polynomial of the one-loop two-mass easy box, \
its integration variables, and a list of candidate singularities:\
\>", "ExampleText",
 CellID->1514468047,ExpressionUUID->"f2296ef8-5acc-438c-98b3-d56431544726"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellProlog:>Needs["DiscKosky`"],
 CellLabel->"In[1]:=",
 CellID->1513626083,ExpressionUUID->"a638f544-7187-4471-a883-d4533a4e4487"],

Cell[TextData[{
 "Find the sectors associated with the singularity ",
 Cell[BoxData[
  RowBox[{
  "rationalAlphabet", "\[LeftDoubleBracket]", "10", 
   "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4d2356d3-a01f-4841-980e-3c45228b3c77"],
 ":"
}], "ExampleText",
