Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7879e1af-a1d0-4d3d-ae8f-67d2bd63ca89"],
 " is the Lee\[Dash]Pomeransky polynomial of a Feynman integral, ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b7a7e890-299d-4ac3-958e-99f4954f3c60"],
 " is the list of its integration variables, and ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f8b42a7d-5e64-46e2-bd69-a8da7a7c7417"],
 " is a list of candidate singularities, given as polynomials in the external \
kinematic parameters."
}], "Notes",
 CellID->1736969072,ExpressionUUID->"6bcf0d75-80f7-43e5-bdfc-de5d97682b62"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SectorDropGraph"]], "paclet:DiscKosky/ref/SectorDropGraph", 
    "DiscKosky Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f12b90df-d23e-44b2-9895-a00f7441ec9a"],
 " returns a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0312d5dc-8431-49c3-97c3-71e3de74eb28"],
 " whose vertices are the sectors of ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5171de5f-55cd-48eb-925a-400535deacde"],
 ", given as lists of positions in ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4d0b632e-cfea-4bfb-b980-0d7a2901b39e"],
 ", with arrows pointing from subsectors to immediate supersectors. It \
returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4cb0a17b-edee-437c-9db4-e068f72f4571"],
 " if the critical point counts cannot be computed or do not pass the \
validity checks."
}], "Notes",
 CellID->1500773682,ExpressionUUID->"3201bac1-e58f-46e6-9ddb-bed75f859022"],

Cell[TextData[{
 "Above each node is its sector, given as the list of variables that are not \
set to zero. Below it are the indices ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b7d9e018-4a31-41b3-907a-77f13d5685a3"],
 " of the singularities associated with that sector: those for which the \
number of critical points in the sector drops, or becomes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "41b1a4da-a06c-4997-b5d5-dc6d5c38a554"],
 ", when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["i", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e8d00902-ae77-43df-8260-bca952d29994"],
 " vanishes."
}], "Notes",
 CellID->1443405534,ExpressionUUID->"40a7bcc0-0b5f-4977-b3a2-b8c50ad81041"],

Cell[TextData[{
 "With the default settings, a discontinuity with respect to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["j", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0d4f900d-faf1-445e-b5ef-b1f729e528ed"],
 " can follow one with respect to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["i", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b681086f-8e0e-4472-b562-c85d276d44a3"],
 " only if ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7e05eaa7-bf6a-451d-b284-c1f65284b22a"],
 " appears at a node where ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e969ea93-b178-462a-9749-93383c359dd4"],
 " appears, or at a node reachable from it along the arrows. Otherwise, the \
Feynman integral ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "3394ebf6-e430-4f65-850c-5a5da568f3eb"],
 " satisfies the genealogical constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", 
     RowBox[{
      StyleBox["singList", "TI"], "\[LeftDoubleBracket]", "j", 
      "\[RightDoubleBracket]"}]], "\[CenterEllipsis]", 
    SubscriptBox["Disc", 
     RowBox[{
      StyleBox["singList", "TI"], "\[LeftDoubleBracket]", "i", 
      "\[RightDoubleBracket]"}]], "\[CenterEllipsis]", "\[ScriptCapitalI]", "=",
     "0"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "21eee5fa-fd57-4807-a56c-da81dcbd0615"],
 "."
}], "Notes",
 CellID->1156255091,ExpressionUUID->"f3ba9007-8a4d-4bda-94dd-9cc34e7b657d"],

Cell["The following options can be given:", "Notes",
 CellID->151494426,ExpressionUUID->"2478f241-c6a7-47d9-affc-a85a0f77e3a0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "55ef94d7-1da0-4c97-b0f2-e9bc18b210df"], "\"\<CheckCriticalPointValidity\
\>\"", 
    TemplateBox[{
      Cell[
       TextData["True"]], "paclet:ref/True"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to run automatic checks that certify the validity of the output\
\>", "TableText",ExpressionUUID->"b4fb8bd0-52f3-4c77-a39a-24ff8bc60268"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
