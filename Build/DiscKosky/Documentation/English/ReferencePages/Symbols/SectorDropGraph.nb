     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
