     "a6c76f77-49e7-4cee-ba60-cbf03284cbfc"], "\"\<DeleteEmptyNodes\>\"", 
    TemplateBox[{
      Cell[
       TextData["True"]], "paclet:ref/True"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to prune nodes whose subsectors have no associated singularities\
\>", "TableText",ExpressionUUID->"2304dd68-d834-4be1-a7bc-a28557135cea"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
