Cell["\<\
Vertices are sectors. Arrows point from subsectors to immediate supersectors.\
\
\>", "Notes",
 CellID->1500773682,ExpressionUUID->"9809375c-a542-4e99-9990-d21d1d33da35"],

Cell["\<\
The sector name is displayed above each node and the associated singularity \
indices below it.\
\>", "Notes",
 CellID->1443405534,ExpressionUUID->"8407ce8a-cf39-4868-9abf-d184c021ec85"],

Cell["\<\
SectorDropGraph first builds Euler-characteristic data in the same way as \
CheckDoubleDiscontinuities, so counting options are forwarded to the \
underlying computations.\
\>", "Notes",
 CellID->652195287,ExpressionUUID->"dd7d6c41-ac0c-4919-9da7-6370ece12afe"],

Cell["\<\
With \"RefineIndeterminates\" -> True, generic-zero sectors that become \
Indeterminate move those labels to orange arrows toward immediate larger \
sectors.\
\>", "Notes",
 CellID->1612247117,ExpressionUUID->"c3e0ffd7-bf7c-4e7e-8f09-861a009d953b"],

Cell["\<\
With \"DeleteEmptyNodes\" -> True, a node is kept when it or one of its \
subsectors has an associated singularity.\
\>", "Notes",
 CellID->1845252834,ExpressionUUID->"02df4a9b-1a33-4dd3-badf-f3b992d86bdd"],

Cell["The following options can be given:", "Notes",
 CellID->151494426,ExpressionUUID->"26171563-504c-4c92-9622-0e7bf8b0f078"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "93b92968-87e4-4fd1-bbe1-9a72d3403269"], "\"\<RefineIndeterminates\>\"", 
    
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to move zero-to-Indeterminate labels from nodes to outgoing edges\
\>", "TableText",ExpressionUUID->"3ec4a752-7bc9-4e8e-92d2-0af69a8240c2"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "da425dba-5c5b-4dbf-83b0-5f2539574b33"], "\"\<DeleteEmptyNodes\>\"", 
    TemplateBox[{
      Cell[
       TextData["True"]], "paclet:ref/True"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to prune nodes whose subsectors have no associated singularities\
\>", "TableText",ExpressionUUID->"f43ee600-388e-4f95-9eee-2357e4107193"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "2bfea25d-67a5-4f64-b928-82547d336b61"], "\"\<CheckCriticalPointValidity\
\>\"", 
    TemplateBox[{
      Cell[
       TextData["True"]], "paclet:ref/True"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to compare the generic unregulated count against the regulated count \
before continuing\
\>", "TableText",ExpressionUUID->"8536b962-1b4c-481a-ba08-5b3a5a63fc0b"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "f59063c8-c50c-4bc4-994a-c862e2978e0a"], "\"\<msolve\>\"", 
    TemplateBox[{
