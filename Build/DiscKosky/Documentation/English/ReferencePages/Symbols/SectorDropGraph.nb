    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to apply a more refined algorithm to discontinuity sequences that the \
standard procedure cannot resolve\
\>", "TableText",ExpressionUUID->"90065353-2b69-419e-a8ee-c61ea078b1d0"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "cd1c8eeb-bac1-4e1d-b9c0-734193af77e9"], "\"\<DeleteEmptyNodes\>\"", 
    TemplateBox[{
      Cell[
       TextData["True"]], "paclet:ref/True"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to remove nodes for which neither the sector nor any of its \
subsectors has an associated singularity\
\>", "TableText",ExpressionUUID->"2e17c1e7-1052-4d90-9849-c60659aebd35"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "8c9ff9a7-2374-416d-9ee5-25a1c47db233"], "\"\<msolve\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to use msolve for the underlying Groebner basis computations\
\>", "TableText",ExpressionUUID->"fa1f59e5-7326-41c8-ac0e-2cc38f825a9e"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{
  "Columns" -> {{None}}, "Rows" -> {None, None, None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True, True, True}}}},
 CellID->438679867,ExpressionUUID->"8f010021-f4b5-4bce-b09d-db44f42af8c1"],

Cell[TextData[{
 "With the default setting ",
 Cell[BoxData[
  RowBox[{"\"\<DeleteEmptyNodes\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "34a39d38-90bb-44f5-951a-8489459faa28"],
 ", a node is kept when it or one of its subsectors has an associated \
singularity."
}], "Notes",
 CellID->1845252834,ExpressionUUID->"4c8f7ee4-8bce-439e-ba8f-e03753c9bc54"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3518d4ea-f1dc-47b5-ae85-b5252340e35c"],
 ", singularities that make the critical point count ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "45fba298-d1f1-4d73-ac78-6f73ac7745aa"],
 " in a sector with no critical points in generic kinematics are removed from \
the node of that sector and shown in orange on the edges leaving it."
}], "Notes",
 CellID->1086880136,ExpressionUUID->"80ee490e-cbbf-4da6-96fe-947652ce1da0"]
}, Closed]],

