Cell["\<\
Vertices are sectors. Arrows point from subsectors to immediate supersectors.\
\
\>", "Notes",
 CellID->1500773682,ExpressionUUID->"3e2dc51b-8acf-455b-9572-223d58d4ad7b"],

Cell["\<\
The sector name is displayed above each node and the associated singularity \
indices below it.\
\>", "Notes",
 CellID->1443405534,ExpressionUUID->"cb082bed-4f30-4f47-ad31-69fe6b6407b5"],

Cell["\<\
SectorDropGraph first builds Euler-characteristic data in the same way as \
CheckDoubleDiscontinuities, so counting options are forwarded to the \
underlying computations.\
\>", "Notes",
 CellID->652195287,ExpressionUUID->"1deffd4f-7f83-460f-bf56-14bffa4bff72"],

Cell["\<\
With \"DeleteEmptyNodes\" -> True, a node is kept when it or one of its \
subsectors has an associated singularity.\
\>", "Notes",
 CellID->1845252834,ExpressionUUID->"e95d98a7-c041-470e-bb99-b35bba9eb8cc"],

Cell["The following options can be given:", "Notes",
 CellID->151494426,ExpressionUUID->"c09309fd-4612-40d1-b9f4-06a6cba1aee4"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "4713c0ec-d4dc-4995-b242-68fa2ef168d8"], "\"\<RefineIndeterminates\>\"", 
    
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
apply the more refined algorithm for dealing with discontinuity sequences the \
standard procedure cannot  resolve\
\>", "TableText",ExpressionUUID->"1e237df0-b00a-4f51-bc26-3d905ada2350"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "c59d03c2-3b57-403e-a0a4-25954747349c"], "\"\<DeleteEmptyNodes\>\"", 
    TemplateBox[{
      Cell[
       TextData["True"]], "paclet:ref/True"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
prune nodes whose subsectors have no associated singularities\
\>", "TableText",ExpressionUUID->"ada216be-1482-481e-8253-7c19bc2db662"]},
