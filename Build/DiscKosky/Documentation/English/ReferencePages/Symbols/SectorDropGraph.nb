Cell["\<\
Vertices are sectors. Arrows point from subsectors to immediate supersectors.\
\
\>", "Notes",
 CellID->1500773682,ExpressionUUID->"430c83e0-318e-479f-a05e-cc93056f35a6"],

Cell["\<\
The sector name is displayed above each node and the associated singularity \
indices below it.\
\>", "Notes",
 CellID->1443405534,ExpressionUUID->"69ad8fe9-b3eb-429f-9544-55fd5c3e77ab"],

Cell["\<\
SectorDropGraph first builds Euler-characteristic data in the same way as \
CheckDoubleDiscontinuities, so counting options are forwarded to the \
underlying computations.\
\>", "Notes",
 CellID->652195287,ExpressionUUID->"382ddf8f-b959-495a-a38c-2a01d0a32112"],

Cell["\<\
With \"DeleteEmptyNodes\" -> True, a node is kept when it or one of its \
subsectors has an associated singularity.\
\>", "Notes",
 CellID->1845252834,ExpressionUUID->"330d894a-5461-4c9d-8e2e-3b8c3e643c28"],

Cell["The following options can be given:", "Notes",
 CellID->151494426,ExpressionUUID->"d0f7f723-33d6-4a06-89ee-bf43bef9c334"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "58b7fa05-d64d-4219-b2cd-1be59437d5b5"], "\"\<RefineIndeterminates\>\"", 
    
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "whether to refine the display of indeterminate singularities", 
     "TableText",ExpressionUUID->"67b9caa2-094a-4a89-b414-68dd21585c3f"]},
