Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "afd08307-63b6-4bc2-92bb-49f1ee6f3e8f"],
 " is the Lee\[Dash]Pomeransky polynomial of the Feynman integral ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "529b1bf0-a8e7-4539-b908-6d271cc58a8a"],
 ", ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4b4785a-436b-42ec-9d56-ebbfa3a14014"],
 " is the list of its integration variables, and ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "95bb233d-b2f7-434c-8698-1a608eb6bf41"],
 " is the list of candidate singularities, given as polynomials in the \
external kinematic parameters."
}], "Notes",
 CellID->1642487768,ExpressionUUID->"7e41339f-bffc-46eb-96f7-3bd9c8ee4eeb"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["indexList", "TI"], "=", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["i", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["i", "TI"], 
      StyleBox["2", "TR"]], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["i", "TI"], 
      StyleBox["n", "TI"]]}], "}"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e3c95923-5f25-4c53-8abc-81968d02f486"],
 " is a list of positions in ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "84f98b69-e7f1-426e-ac08-e136e2528571"],
 ", with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["i", "TI"], 
   StyleBox["1", "TR"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9f9c759b-fc95-48e4-9930-9a137be61e9f"],
 " corresponding to the first discontinuity taken. The sequence tested is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", 
     SubscriptBox["i", "n"]], "\[CenterEllipsis]", 
    SubscriptBox["Disc", 
     SubscriptBox["i", "2"]], "\[CenterEllipsis]", 
    SubscriptBox["Disc", 
     SubscriptBox["i", "1"]], "\[CenterEllipsis]", "\[ScriptCapitalI]"}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "468f18ef-30af-4e9d-86ef-a308f42cbba1"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Disc", "k"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "f2e0eb2b-c4bd-4a32-a574-84b6c1774aa7"],
 " denotes the discontinuity with respect to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["k", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b2e9f137-8ced-4fb0-a702-469b11a2e902"],
 "."
}], "Notes",
 CellID->2016578698,ExpressionUUID->"c950abb4-76d3-4c81-9f5b-b885015f8416"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bce23ffc-8f81-48a6-9480-9915f3e1c16c"],
 " if the sequence is shown to vanish, so that ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "4f942fe7-c479-478d-99e5-551024d6d108"],
 " satisfies the genealogical constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["Disc", 
      SubscriptBox["i", "n"]], "\[CenterEllipsis]", 
     SubscriptBox["Disc", 
      SubscriptBox["i", "2"]], "\[CenterEllipsis]", 
     SubscriptBox["Disc", 
      SubscriptBox["i", "1"]], "\[CenterEllipsis]", "\[ScriptCapitalI]"}], "=",
     "0"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "a4434159-cdd8-4b23-aff3-9ac06f3f5f06"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c4775ba6-daa1-4fca-b931-d5989134dae1"],
 " if the sequence is not ruled out by this method. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "127916dc-6f13-4d49-8750-ff2e95b37a35"],
 " indicates that a higher-dimensional solution to the critical point \
equations has been found; with ",
 Cell[BoxData[
  RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ccb5821f-f920-45bd-aba6-0601ceb10609"],
 ", such cases are resolved where possible and otherwise conservatively \
returned as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8726c19c-a67e-43ba-9724-086ce2bd776f"],
 "."
}], "Notes",
