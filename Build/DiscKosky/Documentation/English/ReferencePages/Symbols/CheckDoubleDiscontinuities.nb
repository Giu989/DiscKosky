Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bdcdd6d0-b1d9-4696-b80b-6c802991e47b"],
 " is the Lee\[Dash]Pomeransky polynomial of the Feynman integral ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "87570192-272e-4ce2-81fc-796d9939992f"],
 ", ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a22ee0fc-fbd1-4e60-8e4d-639d61f2800b"],
 " is the list of its integration variables, and ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a059ff91-03cb-40a7-bb5c-71efcb976f88"],
 " is a list of candidate singularities, given as polynomials in the external \
kinematic parameters."
}], "Notes",
 CellID->1479431249,ExpressionUUID->"a9a59ad4-40c2-47e4-8b4d-77896734e950"],

Cell[TextData[{
 "The result is a square matrix indexed by positions in ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "317a6039-a6f0-4081-ab8b-ee318d4f0fbc"],
 ", whose ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dd36adb1-aa20-4f11-8ba5-3f7105891079"],
 " entry is given by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CheckSequentialDiscontinuity"]], 
     "paclet:DiscKosky/ref/CheckSequentialDiscontinuity", 
     "DiscKosky Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "07e1e19b-b544-4bd4-971f-19586f940300"],
 ". This entry pertains to the discontinuity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", "j"], "\[CenterEllipsis]", 
    SubscriptBox["Disc", "i"], "\[CenterEllipsis]", "\[ScriptCapitalI]"}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "f103add7-0e5a-49e6-a152-704f264d4f3b"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Disc", "k"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "b83ca437-0e70-42d1-8018-13011e7723b4"],
 " denotes the discontinuity with respect to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["k", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "acc724a7-ec7f-41fd-8274-d2fa90e4d4ea"],
 "."
}], "Notes",
 CellID->1142919505,ExpressionUUID->"426f18d9-c21f-4991-9366-22e9bba72d9f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "790d2904-92d3-4649-b9a3-ff0814300b7d"],
 " means that ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "b40fcb16-8a3b-45cd-93b5-4202f2b0c43f"],
 " satisfies the genealogical constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", "j"], "\[CenterEllipsis]", 
    SubscriptBox["Disc", "i"], "\[CenterEllipsis]", "\[ScriptCapitalI]", "=", 
    "0"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "7b10cf06-290e-4252-b04d-d4e51aa04912"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9df2815b-cd65-43b0-a318-6ed49f066088"],
 " means that this sequence of discontinuities is not ruled out, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ddef2dc1-7b53-438a-ac45-703712795055"],
 " means that a higher-dimensional solution of the critical point equations \
was found. With ",
 Cell[BoxData[
  RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "460ec15f-ec98-4c4a-8d8c-2ff493babdff"],
 ", the refined algorithm is applied to the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1d098e5-0465-4eef-9607-a47726cb7e01"],
 " entries, and any that it cannot resolve are conservatively set to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc25aec6-4bd6-44ad-b387-8cb5ad3173e3"],
 "."
}], "Notes",
 CellID->443982688,ExpressionUUID->"7d7ab9d7-ce3f-4f4c-b8ad-da28f88dd85b"],

