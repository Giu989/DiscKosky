Cell[BoxData[
 RowBox[{"CountSectorsRegulated", "[", 
  RowBox[{"g", ",", "vars", ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->"In[17]:=",
 CellID->1018490299,ExpressionUUID->"06eea159-71c1-4833-a38f-54339005c7ad"],

Cell[BoxData["5"], "Output",
 CellChangeTimes->{4.0014931352627153`*^9},
 CellLabel->"Out[17]=",
 CellID->1147802642,ExpressionUUID->"b7a27cab-f6a1-44ba-96d7-9df814966f9c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CountSectorsRegulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"]], 
  "InlineFormula",ExpressionUUID->"61b41445-6cdd-49af-8526-d34798fbe8c3"],
 " also supports the ",
 Cell[BoxData["\<\"Constraint\"\>"], "InlineFormula",ExpressionUUID->
  "d21cc051-b3fe-4cf2-9fd9-606686b954cd"],
 " option, in the same way as ",
 Cell[BoxData[
  ButtonBox["CountSectorsUnregulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"]], 
  "InlineFormula",ExpressionUUID->"e49d6a0a-778c-4e3f-91c5-9415ca29e10a"],
 "."
}], "Text",
 CellID->2136772585,ExpressionUUID->"b90fabd3-1fcd-4be9-a773-1d9b308d5e33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CountSectorsRegulated", "[", 
  RowBox[{"g", ",", "vars", ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"\"\<Constraint\>\"", "\[Rule]", 
    RowBox[{
    "sings", "\[LeftDoubleBracket]", "10", "\[RightDoubleBracket]"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.0014931224345818`*^9, 4.0014931254009743`*^9}},
 CellLabel->"In[18]:=",
 CellID->675024339,ExpressionUUID->"28472b1f-8afb-4948-8a51-5678509e6783"],

Cell[BoxData["4"], "Output",
