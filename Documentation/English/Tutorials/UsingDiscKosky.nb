          Offset[{0, 2}, {2., 0.030239520958083826}], ImageScaled[{0.5, 0}],
          BaseStyle->"Graphics"], InsetBox[
          PaneBox[
           StyleBox["\<\"{9, 10}\"\>",
            StripOnInput->False,
            LineColor->RGBColor[0.55, 0.1, 0.08],
            FrontFaceColor->RGBColor[0.55, 0.1, 0.08],
            BackFaceColor->RGBColor[0.55, 0.1, 0.08],
            GraphicsColor->RGBColor[0.55, 0.1, 0.08],
            FontSize->10,
            FontWeight->Bold,
            FontColor->RGBColor[0.55, 0.1, 0.08]],
           FrameMargins->{{0, 0}, {0, 7}}], 
