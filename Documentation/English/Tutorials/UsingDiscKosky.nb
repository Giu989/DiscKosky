  "InlineFormula",ExpressionUUID->"63d27b9f-df72-4c0a-9f1a-9d8b862e9774"],
 " can appear in this order:"
}], "MathCaption",
 CellID->1451455643,ExpressionUUID->"549c8749-e229-42c6-aff5-a7e99ed78125"],

