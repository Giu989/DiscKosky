Notebook[{

Cell[CellGroupData[{
Cell["Using DiscKosky", "Title",
 CellID->1628376489,ExpressionUUID->"b050b995-54ad-4233-8a99-fcd04b51398d"],

Cell["\<\
DiscKosky is a package for studying the repeated discontinuity structure of \
Euler integrals. This is done primarily by counting the number of critical \
points associated to the Feynman integral.\
\>", "Text",
 CellChangeTimes->{{4.001407922339279*^9, 4.0014079838741007`*^9}},
 CellID->898362796,ExpressionUUID->"f45f071b-b658-4d32-97d4-bacd0bc49244"],

Cell["\<\
This tech note introduces the most important commands of DiscKosky, \
illustrated on a simple one-loop example. More details on each function and \
its options can be found on the corresponding reference pages.\
\>", "Text",
 CellID->1942604819,ExpressionUUID->"dff066bf-9664-44d4-9a0c-f305dd452975"],

Cell[CellGroupData[{

Cell["Load the package:", "MathCaption",
 CellID->1014577915,ExpressionUUID->"b55f2e41-702e-4505-97f9-62ad8f02ceeb"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<DiscKosky`\>\"", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1022905431,ExpressionUUID->"7ef2c498-75de-4a00-b9ea-a71cd08521e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Core Usage", "Section",
 CellID->1951386777,ExpressionUUID->"c18ec15e-edbb-43ab-9483-c858c53c8c2b"],

Cell[TextData[{
 "DiscKosky",
 " provides three main high-level functions for predicting sequential \
discontinuities: ",
 Cell[BoxData[
  ButtonBox["CheckDoubleDiscontinuities",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CheckDoubleDiscontinuities"]], 
  "InlineFormula",ExpressionUUID->"1c7861b8-79db-42f3-aa01-80dd15b36abf"],
 ", ",
 Cell[BoxData[
  ButtonBox["CheckSequentialDiscontinuity",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CheckSequentialDiscontinuity"]], 
  "InlineFormula",ExpressionUUID->"7bb07747-275a-461f-be27-11f84b5ca97a"],
 ", and ",
 Cell[BoxData[
  ButtonBox["SectorDropGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/SectorDropGraph"]], "InlineFormula",
  ExpressionUUID->"f9bf6add-cec8-4530-88ed-c16c8b7e7e97"],
 "."
}], "Text",
 CellID->987825340,ExpressionUUID->"93f33b97-5be2-4837-8eec-9ec3b1952753"],

Cell[BoxData[GridBox[{
   {
    RowBox[{
     ButtonBox["CheckDoubleDiscontinuities",
      BaseStyle->"Link",
      ButtonData->"paclet:DiscKosky/ref/CheckDoubleDiscontinuities"], "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["vars", "TI"], ",", 
      StyleBox["sings", "TI"]}], "]"}], Cell[TextData[{
     "matrix indicating which ordered pairs of discontinuities with respect \
to the singularities ",
     StyleBox["sings", "TI"],
     " can appear"
    }], "TableText",ExpressionUUID->"4237458d-db7d-4902-97e5-8da75f3f40b2"]},
   {
    RowBox[{
     ButtonBox["CheckSequentialDiscontinuity",
      BaseStyle->"Link",
      ButtonData->"paclet:DiscKosky/ref/CheckSequentialDiscontinuity"], "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["vars", "TI"], ",", 
      StyleBox["sings", "TI"], ",", 
      StyleBox["seq", "TI"]}], "]"}], Cell[TextData[{
     "test whether the sequence of discontinuities with respect to the \
singularities indexed by ",
     StyleBox["seq", "TI"],
     " can appear"
    }], "TableText",ExpressionUUID->"32ff2c8f-bded-4996-9e46-3228419bf6ee"]},
   {
    RowBox[{
     ButtonBox["SectorDropGraph",
      BaseStyle->"Link",
      ButtonData->"paclet:DiscKosky/ref/SectorDropGraph"], "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["vars", "TI"], ",", 
      StyleBox["sings", "TI"]}], "]"}], Cell["\<\
graph of the sectors of the integral, labeled by the singularities that \
appear in each sector\
\>", "TableText",ExpressionUUID->"7a6082f2-51b2-44a5-9335-d3fcd2c78baa"]}
  }]], "DefinitionBox",
 CellID->887070137,ExpressionUUID->"86643313-7a08-433b-b308-3e2af7d60efb"],

Cell["\<\
High-level functions for predicting sequential discontinuities.\
\>", "Caption",
 CellID->2049652972,ExpressionUUID->"261df3f3-2679-47b9-ae56-6c4ab9e679ca"],

Cell[CellGroupData[{

Cell["\<\
The three inputs needed to apply these functions to a given Feynman integral \
are the Lee\[Dash]Pomeransky polynomial, a list of the integration variables, \
and a candidate set of singular loci in the space of external parameters. For \
example, consider the two-mass easy box integral shown below.\
\>", "Text",
 CellID->1500641153,ExpressionUUID->"6e463eaf-30ae-4aef-ae96-8b44e4808598"],

Cell[BoxData[
 GraphicsBox[
  {AbsoluteThickness[1.25], 
   LineBox[{{-0.8, 0.8}, {0.8, 0.8}, {0.8, -0.8}, {-0.8, -0.8}, {-0.8, 0.8}}],
    LineBox[{{-0.8, 0.8}, {-1.6660254037844386`, 1.3}}], 
   LineBox[{{-0.8, 0.8}, {-1.3, 1.6660254037844386`}}], 
   LineBox[{{0.8, 0.8}, {1.5071067811865475`, 1.5071067811865475`}}], 
   LineBox[{{0.8, -0.8}, {1.6660254037844386`, -1.3}}], 
   LineBox[{{0.8, -0.8}, {1.3, -1.6660254037844386`}}], 
   LineBox[{{-0.8, -0.8}, {-1.5071067811865475`, -1.5071067811865475`}}], 
   InsetBox[
    SubscriptBox[
     StyleBox["\<\"x\"\>",
      StripOnInput->False,
      FontSlant->Italic], "1"], {0, 0.8}, NCache[
    ImageScaled[{Rational[1, 2], -0.25}], ImageScaled[{0.5, -0.25}]]], 
   InsetBox[
    SubscriptBox[
     StyleBox["\<\"x\"\>",
      StripOnInput->False,
      FontSlant->Italic], "2"], {0.8, 0}, NCache[
    ImageScaled[{-0.30000000000000004`, Rational[1, 2]}], 
     ImageScaled[{-0.30000000000000004`, 0.5}]]], InsetBox[
    SubscriptBox[
     StyleBox["\<\"x\"\>",
      StripOnInput->False,
      FontSlant->Italic], "3"], {0, -0.8}, NCache[
    ImageScaled[{Rational[1, 2], 1.25}], ImageScaled[{0.5, 1.25}]]], 
   InsetBox[
    SubscriptBox[
     StyleBox["\<\"x\"\>",
      StripOnInput->False,
      FontSlant->Italic], "4"], {-0.8, 0}, NCache[
    ImageScaled[{1.3, Rational[1, 2]}], ImageScaled[{1.3, 0.5}]]], InsetBox[
    SubscriptBox[
     StyleBox["\<\"p\"\>",
      StripOnInput->False,
      FontSlant->Italic], "1"], {-1.95, 1.25}], InsetBox[
    SubscriptBox[
     StyleBox["\<\"p\"\>",
      StripOnInput->False,
      FontSlant->Italic], "2"], {-1.49, 1.89}], InsetBox[
    SubscriptBox[
     StyleBox["\<\"p\"\>",
      StripOnInput->False,
      FontSlant->Italic], "3"], {1.9, 1.8}], InsetBox[
    SubscriptBox[
     StyleBox["\<\"p\"\>",
      StripOnInput->False,
      FontSlant->Italic], "4"], {2, -1.3}], InsetBox[
    SubscriptBox[
     StyleBox["\<\"p\"\>",
      StripOnInput->False,
      FontSlant->Italic], "5"], {1.7, -1.8}], InsetBox[
    SubscriptBox[
     StyleBox["\<\"p\"\>",
      StripOnInput->False,
      FontSlant->Italic], "6"], {-1.8, -1.7}]},
  BaseStyle->{FontFamily -> "Times", FontSize -> 15},
  ImageSize->230,
  PlotRange->{{-2.2, 2.2}, {-2.1, 2.1}}]], "Picture",
 CellID->567539839,ExpressionUUID->"ac8745cc-80db-4959-819b-df8b817611a8"]
}, Open  ]],

Cell["\<\
Two-mass easy box integral. Each propagator is labeled by its integration \
variable.\
\>", "Caption",
 CellID->2134284973,ExpressionUUID->"204bfc39-14fc-4e5b-8012-1acb6e046612"],

Cell[TextData[{
 "The kinematic variables of this integral are the masses of the two massive \
corners, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["m", "1", "2"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "1"], "+", 
       SubscriptBox["p", "2"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"1cc72af0-bc4e-4b39-9c06-6c5673fcb3f8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["m", "2", "2"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "4"], "+", 
       SubscriptBox["p", "5"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"87114af7-39cb-47f7-b679-33b240202125"],
 ", and the invariants ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "12"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "1"], "+", 
       SubscriptBox["p", "2"], "+", 
       SubscriptBox["p", "3"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"80405cba-e9ab-4fd0-bbd0-769edc6d565b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "23"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "3"], "+", 
       SubscriptBox["p", "4"], "+", 
       SubscriptBox["p", "5"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"d1402b00-0aef-4bc0-a62e-e95349ceab18"],
 "."
}], "Text",
 CellID->1600199884,ExpressionUUID->"f5eeb050-7907-4b26-988b-65bd7d64c94f"],

Cell[CellGroupData[{

Cell["\<\
For this integral, the Lee\[Dash]Pomeransky polynomial, the integration \
variables, and the candidate singularities are given by:\
\>", "MathCaption",
 CellID->1891355317,ExpressionUUID->"2fca4f30-2345-4edf-8995-03e93b458a58"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sings", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      SuperscriptBox["m2", "2"], "-", "s12"}], ",", 
     RowBox[{
      SuperscriptBox["m1", "2"], "-", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->989529795,ExpressionUUID->"b8928e91-20fc-4eff-9dc2-a3c4d7febfb2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Double Discontinuities", "Subsection",
 CellID->1283911587,ExpressionUUID->"ab375f24-ab81-43c1-947a-7a4655548419"],

Cell[TextData[{
 "Given these arguments, ",
 Cell[BoxData[
  ButtonBox["CheckDoubleDiscontinuities",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CheckDoubleDiscontinuities"]], 
  "InlineFormula",ExpressionUUID->"cb14209a-8619-406a-9ca9-2a5b8f1228eb"],
 " produces a matrix that tells the user which ordered sequences of \
discontinuities can appear ",
 "in the Feynman integral."
}], "Text",
 CellID->1755027163,ExpressionUUID->"0e8e6774-40a3-4e9f-87f0-35423da975aa"],

Cell[CellGroupData[{

Cell["\<\
Compute the double discontinuity matrix and display it in matrix form:\
\>", "MathCaption",
 CellID->565328207,ExpressionUUID->"dd1dc19b-c32e-4010-8fd2-b4c141b8766a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dM1", "=", 
   RowBox[{"CheckDoubleDiscontinuities", "[", 
    RowBox[{"g", ",", "vars", ",", "sings"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->1283030017,ExpressionUUID->"cc11fc8f-e066-49a7-9a83-754f58e1d47a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dM1", "//", "MatrixForm"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->797771126,ExpressionUUID->"353573dd-cc27-4691-b8c6-bcc84c6634ca"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"True", "False", "False", "False", "Indeterminate", "Indeterminate", 
      "False", "False", "True", "True"},
     {"False", "True", "False", "False", "Indeterminate", "False", "False", 
      "Indeterminate", "True", "True"},
     {"False", "False", "True", "False", "False", "Indeterminate", 
      "Indeterminate", "False", "True", "True"},
     {"False", "False", "False", "True", "False", "False", "Indeterminate", 
      "Indeterminate", "True", "True"},
     {"False", "False", "False", "False", "Indeterminate", "False", "False", 
      "False", "True", "True"},
     {"False", "False", "False", "False", "False", "Indeterminate", "False", 
      "False", "True", "True"},
     {"False", "False", "False", "False", "False", "False", "Indeterminate", 
      "False", "True", "True"},
     {"False", "False", "False", "False", "False", "False", "False", 
      "Indeterminate", "True", "True"},
     {"False", "False", "False", "False", "False", "False", "False", "False", 
      "True", "True"},
     {"False", "False", "False", "False", "False", "False", "False", "False", 
      "True", "True"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{4.001493133621434*^9},
 CellLabel->"Out[7]//MatrixForm=",
 CellID->1148871023,ExpressionUUID->"52ffcf9e-e898-45f5-9917-6d06e64b5c99"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "d6fef330-b9e6-4bd8-aa53-d377b7445ef0"],
 " indicates that a higher-dimensional solution to the ",
 "critical point equations has been found. The entry in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "0185079d-55be-4ab2-8ab2-7178906a68c6"],
 " row and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["j", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "4982dc10-f523-4eef-8834-994d508875ed"],
 " column of this matrix, namely ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"b5c84d9c-357d-48e7-8b9a-763af46094fc"],
 ", tells us whether a discontinuity with respect to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["j", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "352b3e23-0ada-46ab-a096-6858d5cb1c36"],
 " singularity can follow a discontinuity with respect to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "cfff0b94-99ed-4ed9-9ba1-78cca62729e7"],
 " singularity. Namely, if ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"5d717a18-fba6-4b2f-bfd3-fa83343406b4"],
 " is ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "9b5067d2-0f28-4c15-adc3-7f3ed1ade65d"],
 ", this indicates that the Feynman integral ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "92f8c796-6b3b-4218-8c73-ee70da930144"],
 " satisfies a genealogical constraint of the form"
}], "Text",
 CellID->1408544087,ExpressionUUID->"15cba87a-d30f-42e2-853c-1bbe8348bcc1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["Disc", 
    RowBox[{"sings", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]], 
   "\[CenterEllipsis]", 
   SubscriptBox["Disc", 
    RowBox[{"sings", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]], 
   "\[CenterEllipsis]", "\[ScriptCapitalI]", "=", "0"}], 
  TraditionalForm]], "DisplayMath",
 CellID->1701802682,ExpressionUUID->"3192a14b-d765-4e4f-8705-9b0a57cace11"],

Cell[TextData[{
 "Conversely, if ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"13da6ac6-5b2f-4e33-8de4-5472c1b52680"],
 " is ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "0e83d1c9-8eb4-4190-ac07-44d1d435c7ef"],
 ", such sequences of discontinuities are not ruled out by this method."
}], "Text",
 CellID->921957231,ExpressionUUID->"09e62d03-b49e-43c6-9443-50049ab1cda0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Refining Indeterminate Entries", "Subsection",
 CellID->150763012,ExpressionUUID->"954f5d52-1155-4f7c-b3a8-516abfb922b6"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  RowBox[{"dM1", "\[LeftDoubleBracket]", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"9a92d885-e236-471c-857b-d684fd0d802d"],
 " is ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "fbde227c-794c-4fd3-8a88-b9496ddce989"],
 ", there are two ways one can proceed. Most directly, these entries indicate \
that the ",
 "critical point algorithm cannot be applied, so the conservative option is \
to treat such a ",
 "result as equivalent to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "6e493f80-e0e0-4089-be11-4cee073e57e9"],
 ". However, more can be said in many of the cases in which ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "93b2276d-e9d0-4066-933a-c60a3541574e"],
 " solutions arise (such as when a sector that has no critical points in ",
 "generic kinematics becomes ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "d84848df-36ee-47a4-8e2e-193a9a3f2020"],
 " in a singular limit). These more refined ",
 "predictions can be requested by using the option ",
 Cell[BoxData["\<\"RefineIndeterminates\"\>"], "InlineFormula",ExpressionUUID->
  "6ba5ce10-7be6-44ba-8a1b-e80617ae5132"],
 ", which can be passed to all of the core ",
 "DiscKosky",
 " functions."
}], "Text",
 CellID->951771314,ExpressionUUID->"150ae9d0-c64f-4129-9f4f-e770adb00b09"],

Cell[CellGroupData[{

Cell[TextData[{
 "Compute the double discontinuity matrix with ",
 Cell[BoxData["\<\"RefineIndeterminates\"\>"], "InlineFormula",ExpressionUUID->
  "e16944d1-bda2-4c4f-a74e-058d01ce774b"],
 " enabled:"
}], "MathCaption",
 CellID->1638046882,ExpressionUUID->"4e313d11-b886-46fa-b46c-86b47d10b565"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dM2", "=", 
   RowBox[{"CheckDoubleDiscontinuities", "[", 
    RowBox[{"g", ",", "vars", ",", "sings", ",", 
     RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1996661693,ExpressionUUID->"5feb0ac0-a430-48e8-9f9f-3255b1a9b01a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dM2", "//", "MatrixForm"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->2072889356,ExpressionUUID->"a1609de4-a3bf-4c51-a6ac-42088e248429"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
