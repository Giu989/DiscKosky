Cell[TextData[{
 "Compared to ",
 Cell[BoxData[
 "dM1"], "InlineFormula",ExpressionUUID->
  "7a07eded-64f0-40a1-8e4f-1e6107655e41"],
 ", four new singularities (",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]], 
  "InlineFormula",ExpressionUUID->"f6857de7-82dd-42ab-a83d-e5c9dcb67c53"],
 ", ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "6", "\[RightDoubleBracket]"}]], 
  "InlineFormula",ExpressionUUID->"e712ae32-d426-4ffb-9117-ae927d42d1ee"],
 ", ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "7", "\[RightDoubleBracket]"}]], 
  "InlineFormula",ExpressionUUID->"87d3b138-2106-4eee-bab3-4a189f50017a"],
 ", and ",
 Cell[BoxData[
  RowBox[{"sings", "\[LeftDoubleBracket]", "8", "\[RightDoubleBracket]"}]], 
  "InlineFormula",ExpressionUUID->"aa19d176-b927-4c7b-a9a4-50cea85ae3e8"],
 ") can now be identified as giving rise to non-repeating discontinuities. \
Any ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "83ab43be-cb0d-4efc-93ac-0ca80b9778b2"],
 " entries that the refined algorithm cannot resolve are conservatively set \
to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "12f73747-e426-4732-b70e-24d6b7da8fa2"],
 "."
}], "Text",
 CellID->1528055918,ExpressionUUID->"32209f15-19ea-404b-95fe-35d4f0575c9c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sequences of Discontinuities", "Subsection",
 CellID->654515079,ExpressionUUID->"d5e73d80-7972-42e8-86ac-af1bb051d33e"],

Cell[TextData[{
 "The function ",
 Cell[BoxData[
  ButtonBox["CheckSequentialDiscontinuity",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CheckSequentialDiscontinuity"]], 
  "InlineFormula",ExpressionUUID->"460ea892-69fb-440c-994e-9a4e94bb8638"],
 " works in a very similar manner, except that it tests for a specific string \
of discontinuities ",
 "of any length. It takes four inputs: the same three as above, and a \
specific sequence to test, ",
 "given as a list of positions in ",
 Cell[BoxData[
 "sings"], "InlineFormula",ExpressionUUID->
  "e33fcad8-d736-40f8-9de8-1b043ac6012d"],
 "."
}], "Text",
 CellID->1158688030,ExpressionUUID->"c76f9c0b-397e-4a70-8acf-94b480c1c1ea"],

Cell[CellGroupData[{

Cell[TextData[{
 "Test whether discontinuities with respect to ",
