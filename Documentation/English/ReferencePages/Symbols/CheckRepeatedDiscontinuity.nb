Cell[CellGroupData[{
Cell["CheckRepeatedDiscontinuity", "ObjectName",
 CellID->433740186,ExpressionUUID->"ea42bb03-fe5f-4169-95d0-9b83c828c0c7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bc2f14f3-3fc8-462d-9864-60de59d462e4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckRepeatedDiscontinuity",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CheckRepeatedDiscontinuity"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"], ",", 
    StyleBox["indexList", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "04f28ab1-7b3d-462f-8f6d-ab7e53a42b43"],
 "\[LineSeparator]",
 "tests whether the ordered singularities in ",
 Cell[BoxData[
  StyleBox["\"\<indexList\>\"", "TI",
   StripOnInput->False]], "InlineFormula",ExpressionUUID->
  "4e251884-3c9e-4374-9a58-00c2af4a3056"],
 " support a repeated discontinuity.",
 "\n"
}], "Usage",
 CellID->139271287,ExpressionUUID->"bdc72e65-372b-4130-ac7e-78eb8a07ad81"],

Cell["\<\
singList is an ordered list of singularity polynomials. Entries in indexList \
are positions in that list.\
\>", "Notes",
 CellID->1642487768,ExpressionUUID->"c7e45bc3-4960-48c2-adb9-8147ced21411"],

Cell["\<\
The function first builds Euler-characteristic data from sector counts, and \
by default checks the generic sector count against the regulated count.\
\>", "Notes",
 CellID->1926924262,ExpressionUUID->"dca4b3ad-1630-4b39-a3c6-d67c80b88622"],

Cell["The result is True, False, Indeterminate, or $Failed.", "Notes",
 CellID->1843868183,ExpressionUUID->"4f77e975-bc39-47de-bd33-ebdd17851b54"],

Cell["The following options can be given:", "Notes",
 CellID->1353201756,ExpressionUUID->"9f669c15-1ca8-4dd1-be60-db66a482f1cd"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "86a6c26a-9e0b-4915-a952-4d07c491df19"], "\"\<CheckCriticalPointValidity\
\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether to compare the generic unregulated count against the regulated count \
before continuing\
\>", "TableText",ExpressionUUID->"5c2a4d27-3f9b-402e-ae2a-70eb343b04be"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "72950436-d3a1-4460-a88d-484140732208"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "whether to use msolve for the underlying sector counts", "TableText",
     ExpressionUUID->"f204f6f5-5b93-4390-b876-af07b339aeb1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "38e93ba3-d85a-46db-b44a-76668768f193"], "\"\<MSolveJobs\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "number of parallel msolve jobs", "TableText",ExpressionUUID->
     "3f7f1961-77fe-459f-a994-a289c99a2f59"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5dfc93de-0380-4863-a050-1cef72b598dd"], "\"\<msolveParallelThreads\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "thread count passed to each msolve job", "TableText",ExpressionUUID->
     "a54eb217-4689-468f-84be-54efaadcc92e"]}
  }]], "3ColumnTableMod",
 CellID->1275250774,ExpressionUUID->"0a55b18f-ebf2-46bb-937c-0014f97a040b"]
