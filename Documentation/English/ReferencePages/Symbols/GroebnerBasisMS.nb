Cell[CellGroupData[{
Cell["GroebnerBasisMS", "ObjectName",
 CellID->1536460921,ExpressionUUID->"fcfb5237-d95c-4563-aae6-2cd8702110cf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6a0e7210-3740-4ea5-abd0-e7ffcc36af06"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GroebnerBasisMS",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/GroebnerBasisMS"], "[", 
   RowBox[{
    StyleBox["ideal", "TI"], ",", 
    StyleBox["vars", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "62c698c8-35c0-49a7-9b57-03796192f5d7"],
 "\[LineSeparator]",
 "computes a Groebner basis using msolve.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cd74a2dd-2a77-49f2-9efe-a6249ce802fe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GroebnerBasisMS",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/GroebnerBasisMS"], "[", 
   StyleBox["jobs", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "278aa49e-6a4a-484c-9bc1-4269ca4b8a37"],
 "\[LineSeparator]",
 "computes a batch of Groebner bases."
}], "Usage",
 CellID->518091625,ExpressionUUID->"beab3592-4d5d-4c2d-b63a-6878a4740955"],

Cell["\<\
Each batch job can be an association <|\"Ideal\" -> ideal, \"Variables\" -> \
vars|> or a pair {ideal, vars}.\
\>", "Notes",
 CellID->419528080,ExpressionUUID->"2aae961d-1ac8-41b9-b3ac-69d0b298c96a"],

Cell["\<\
GroebnerBasisMS requires the msolve executable. If msolve is not available, \
use Mathematica's GroebnerBasis directly for small examples.\
\>", "Notes",
 CellID->714703331,ExpressionUUID->"da43d562-c2f7-4853-8920-8a2b803412c1"],

Cell["\<\
The msolve batch options control how many jobs are launched and how many \
threads each job uses.\
\>", "Notes",
 CellID->971922940,ExpressionUUID->"929c6e70-68ba-475e-a380-4a3b0a12aaee"],

Cell["The following options can be given:", "Notes",
 CellID->1887282940,ExpressionUUID->"25f0962e-4aef-4f6d-b4fd-caf54f35a771"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "47d6123b-8e87-44c2-8bc2-b6f9b62df2d6"], "\"\<Modulus\>\"", "0", Cell[
    "prime modulus for computations over GF(p)", "TableText",ExpressionUUID->
     "a17c6fa4-1cd9-4229-86a8-162e1a6c5581"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2bb4ea01-7fd9-4a21-b33a-4c7253e1a184"], "\"\<LeadingMonomialsOnly\>\"", 
    
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell[
    "whether to return only the leading ideal", "TableText",ExpressionUUID->
     "0f442fee-e2b1-46e0-947e-55cf453dad6d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3bc97113-4646-40a4-96be-1d6ca1d688f5"], "\"\<EliminateVariables\>\"", 
    RowBox[{"{", "}"}], Cell[
    "variables to eliminate before returning the basis", "TableText",
     ExpressionUUID->"1e072992-c96d-42a0-8f85-c06ae8858296"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "752d21a4-c4d0-4aa4-9c98-6db8c906e733"], "\"\<MSolveJobs\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "number of parallel msolve jobs", "TableText",ExpressionUUID->
     "90674dfe-8fb7-4444-91ed-428888fb3478"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3dcc95fa-7bba-49a3-836c-33e6081aa2e4"], "\"\<msolveParallelThreads\>\"",
     "1", Cell[
    "thread count passed to each msolve job", "TableText",ExpressionUUID->
     "393e637d-71bc-4668-bb0f-a36db4bc05cb"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "68234b91-642c-44c7-aa3e-d8066ecbf694"], "\"\<MSolveProgress\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "whether to show notebook progress while batch jobs run", "TableText",
     ExpressionUUID->"d00cfee7-3a11-4eba-a4f5-4f743d8d7f42"]}
  }]], "3ColumnTableMod",
 CellID->1177682670,ExpressionUUID->"326e1fba-b8ef-496e-b971-0d4a8d0705b8"]
}, Open  ]],

