Cell[CellGroupData[{
Cell["CheckDoubleDiscontinuities", "ObjectName",
 CellID->754728028,ExpressionUUID->"8a5b31a3-8d12-4a6b-b7bd-e7095708f5ed"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b848763-a1fd-4b8d-8796-9618940dd0c8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckDoubleDiscontinuities",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CheckDoubleDiscontinuities"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ff4b8f6c-3ef4-4a6f-8800-9972ead7650b"],
 "\[LineSeparator]",
 "returns the pairwise double-discontinuity matrix for the singularities in \
",
 Cell[BoxData[
  StyleBox["\"\<singList\>\"", "TI",
   StripOnInput->False]], "InlineFormula",ExpressionUUID->
  "b2e0d491-d746-40eb-9415-98ff5b8d7223"],
 ".",
 "\n"
}], "Usage",
 CellID->1440432442,ExpressionUUID->"e6ba2532-38b0-445c-ba86-ae1ca20c355b"],

Cell["Rows and columns are indexed by positions in singList.", "Notes",
 CellID->1142919505,ExpressionUUID->"0b278fea-3451-43c7-ae09-4b076ebcdfcb"],

Cell["\<\
The {i,j} entry is the result of CheckRepeatedDiscontinuity for the ordered \
pair {i,j}.\
\>", "Notes",
 CellID->443982688,ExpressionUUID->"571f33c3-b8a2-4b83-aa1f-d527fa2e9c5a"],

Cell["\<\
Entries are True, False, or Indeterminate. The function returns $Failed if \
the Euler-characteristic data cannot be built.\
\>", "Notes",
 CellID->1503267547,ExpressionUUID->"3840e231-ff2e-4e19-9e2c-994143035896"],

Cell["The following options can be given:", "Notes",
 CellID->1529682937,ExpressionUUID->"336d2c69-945c-49b8-8c25-9c1061b24aa4"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4c00b166-badf-4a3f-ac59-aa7105a0bb7c"], "\"\<CheckCriticalPointValidity\
\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether to compare the generic unregulated count against the regulated count \
before continuing\
\>", "TableText",ExpressionUUID->"25fb9795-32f6-4595-8fbc-80c43a768117"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "470fe727-ed14-49b2-afe5-b432f9abd6f8"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "whether to use msolve for the underlying sector counts", "TableText",
     ExpressionUUID->"b4061983-853e-4119-8c03-2d3046e0fc67"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5549ce32-4e82-4333-8c79-688ff43613e5"], "\"\<MSolveJobs\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "number of parallel msolve jobs", "TableText",ExpressionUUID->
     "1596b86b-b475-47b3-8e2f-737dcc407b24"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "42cb13a6-6702-4590-8ab7-bf0d0dfb52a5"], "\"\<msolveParallelThreads\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "thread count passed to each msolve job", "TableText",ExpressionUUID->
     "707f7b4b-4c62-48b7-bbc3-742faeefd220"]}
  }]], "3ColumnTableMod",
 CellID->1949606450,ExpressionUUID->"0eddf94a-1bf3-47b5-ba9b-1aaea0b54507"]
