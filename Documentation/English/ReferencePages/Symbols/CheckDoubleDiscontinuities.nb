Notebook[{

Cell[CellGroupData[{
Cell["CheckDoubleDiscontinuities", "ObjectName",
 CellID->754728028,ExpressionUUID->"8a5b31a3-8d12-4a6b-b7bd-e7095708f5ed"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b848763-a1fd-4b8d-8796-9618940dd0c8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckDoubleDiscontinuities",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CheckDoubleDiscontinuities"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ff4b8f6c-3ef4-4a6f-8800-9972ead7650b"],
 "\[LineSeparator]",
 "returns the pairwise double\[Hyphen]discontinuity matrix for the \
singularities in ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "b2e0d491-d746-40eb-9415-98ff5b8d7223"],
 "."
}], "Usage",
 CellID->1440432442,ExpressionUUID->"e6ba2532-38b0-445c-ba86-ae1ca20c355b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "3737d524-5091-4372-8fbc-a3d769a852f8"],
 " is the Lee\[Dash]Pomeransky polynomial of the Feynman integral ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "0527e849-e037-49a9-a726-3fef6bd988fc"],
 ", ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "08feeaa5-6899-45e9-8969-07503f8d4da4"],
 " is the list of its integration variables, and ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "0a0b3ead-2ccb-4dba-b60d-fd717b05179c"],
 " is a list of candidate singularities, given as polynomials in the external \
kinematic parameters."
}], "Notes",
 CellID->1479431249,ExpressionUUID->"e8a70839-997a-470e-8843-faa7bed7dede"],

Cell[TextData[{
 "The result is a square matrix indexed by positions in ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "ab5622c3-5cc1-4d4d-b7d6-bec275e4474a"],
 ", whose ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "8e27d07a-ff27-4dc1-a89d-29136a660444"],
 " entry is given by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckSequentialDiscontinuity",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CheckSequentialDiscontinuity"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9712425e-2df2-4427-90a5-90a4e03ef65c"],
 ". This entry pertains to the discontinuity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", "j"], "\[CenterEllipsis]", 
    SubscriptBox["Disc", "i"], "\[CenterEllipsis]", "\[ScriptCapitalI]"}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "2a87011b-762c-464b-81c1-9ab330b05787"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Disc", "k"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "5592b740-da49-40da-ab9e-53fff5d5a0c7"],
 " denotes the discontinuity with respect to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["k", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"360c4b66-0c06-4201-bfdb-333ed43a650c"],
 "."
}], "Notes",
 CellID->1142919505,ExpressionUUID->"0b278fea-3451-43c7-ae09-4b076ebcdfcb"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "62aa4340-047a-486b-bbd9-33fcac5782d5"],
 " means that ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "3b07765c-de9b-4392-92b2-6bfc21735ea4"],
 " satisfies the genealogical constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", "j"], "\[CenterEllipsis]", 
    SubscriptBox["Disc", "i"], "\[CenterEllipsis]", "\[ScriptCapitalI]", "=", 
    "0"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "dbed960e-41e4-4e03-8aba-08429d496c97"],
 ", ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "c4157d06-ea7c-4ac5-a5fa-a019a1f88679"],
 " means that this sequence of discontinuities is not ruled out, and ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "206b6a16-895e-4dbd-bfc4-379959d243cd"],
 " means that a higher-dimensional solution of the critical point equations \
was found. With ",
 Cell[BoxData[
  RowBox[{"\<\"RefineIndeterminates\"\>", "\[Rule]", 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula",ExpressionUUID->
  "13efef1f-7875-45d7-9c08-ed9cd7336522"],
 ", the refined algorithm is applied to the ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "aca57322-8fb0-4ffc-b389-d3d7b8f50a5d"],
 " entries, and any that it cannot resolve are conservatively set to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "adcf90b3-d22c-491a-baf5-64d59bcb9b36"],
 "."
}], "Notes",
 CellID->443982688,ExpressionUUID->"571f33c3-b8a2-4b83-aa1f-d527fa2e9c5a"],

Cell[TextData[{
 "Rows and columns associated with singularities for which the \
sector-by-sector count fails are ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "0d0f6a3d-123e-4747-bd1b-ef6606572a55"],
 ". The whole result is ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "7d4d7536-ac73-4076-a502-ea1c7135aae6"],
 " if the critical points of ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "bc490a3e-3ba4-49ea-9598-0e82cf31c882"],
 " cannot be counted sector by sector for generic kinematics or if, with the \
default setting ",
 Cell[BoxData[
  RowBox[{"\<\"CheckCriticalPointValidity\"\>", "\[Rule]", 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula",ExpressionUUID->
  "db953c2f-0cdf-45bb-9145-0198dc1b5413"],
 ", this count is not confirmed by the regulated count from ",
 Cell[BoxData[
  ButtonBox["CountSectorsRegulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"]], 
  "InlineFormula",ExpressionUUID->"7182633d-25e8-424a-8be1-18cde7b18a75"],
 "."
}], "Notes",
 CellID->689465560,ExpressionUUID->"bcca9aa1-208f-430f-9057-27f2343fb9e9"],

Cell["The following options can be given:", "Notes",
 CellID->1529682937,ExpressionUUID->"336d2c69-945c-49b8-8c25-9c1061b24aa4"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4c00b166-badf-4a3f-ac59-aa7105a0bb7c"], "\"\<CheckCriticalPointValidity\
\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether to run automatic checks that certify the validity of the output\
\>", "TableText",ExpressionUUID->"a114eb58-37b8-4a79-bc5e-6f058deaeec9"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "93b509fb-11c4-41bf-8f31-df3c7fbaa0c4"], "\"\<RefineIndeterminates\>\"", 
    
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to apply a more refined algorithm to discontinuity sequences that the \
standard procedure cannot resolve\
\>", "TableText",ExpressionUUID->"8ee491ce-94fe-4563-b963-78c9c6ab8657"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "470fe727-ed14-49b2-afe5-b432f9abd6f8"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell["\<\
whether to use msolve for the underlying Groebner basis computations\
\>", "TableText",ExpressionUUID->"b4061983-853e-4119-8c03-2d3046e0fc67"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{4.001404772860744*^9, 4.001404844299836*^9}, {
  4.001404980796733*^9, 4.001405048296817*^9}, {4.001405898096057*^9, 
  4.001405914418762*^9}},
 CellID->1949606450,ExpressionUUID->"0eddf94a-1bf3-47b5-ba9b-1aaea0b54507"]
}, Open  ]],

