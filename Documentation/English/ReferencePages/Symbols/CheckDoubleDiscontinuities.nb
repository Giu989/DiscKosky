Cell["\<\
Define the Lee\[Dash]Pomeransky polynomial of the one-loop two-mass easy box, \
its integration variables, and a list of candidate singularities:\
\>", "ExampleText",
 CellID->556462488,ExpressionUUID->"d1ec1745-39ac-4412-8994-a7e458c7da22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1358788078,ExpressionUUID->"1a587fa3-b7d1-43d2-be7e-2b72094a59be"],

Cell["\<\
Compute the double-discontinuity matrix for this list of singularities and \
display it in matrix form:\
\>", "ExampleText",
 CellID->826888677,ExpressionUUID->"15562a21-00b5-4dce-922b-905d9efc2178"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"dm1", "=", 
   RowBox[{"CheckDoubleDiscontinuities", "[", 
    RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet"}], "]"}]}], ";", 
  RowBox[{"dm1", " ", "//", " ", "MatrixForm"}]}]], "Input",
 CellChangeTimes->{{4.001404436528987*^9, 4.001404495615097*^9}},
 CellLabel->"In[15]:=",
 CellID->197041345,ExpressionUUID->"047eb382-1cb7-4052-ac73-a64b175ef2cd"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"True", "False", "False", "False", "Indeterminate", "Indeterminate", 
      "False", "False", "True", "True"},
     {"False", "True", "False", "False", "Indeterminate", "False", "False", 
      "Indeterminate", "True", "True"},
     {"False", "False", "True", "False", "False", "Indeterminate", 
      "Indeterminate", "False", "True", "True"},
     {"False", "False", "False", "True", "False", "False", "Indeterminate", 
      "Indeterminate", "True", "True"},
     {"False", "False", "False", "False", "Indeterminate", "False", "False", 
      "False", "True", "True"},
     {"False", "False", "False", "False", "False", "Indeterminate", "False", 
      "False", "True", "True"},
     {"False", "False", "False", "False", "False", "False", "Indeterminate", 
      "False", "True", "True"},
     {"False", "False", "False", "False", "False", "False", "False", 
      "Indeterminate", "True", "True"},
     {"False", "False", "False", "False", "False", "False", "False", "False", 
      "True", "True"},
     {"False", "False", "False", "False", "False", "False", "False", "False", 
      "True", "True"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{{4.0014044494414387`*^9, 4.001404495990416*^9}},
 CellLabel->"Out[15]//MatrixForm=",
 CellID->1050670419,ExpressionUUID->"ccb7635a-1d01-441d-b12c-3a8a8ada11dd"]
}, Open  ]],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "c31aec09-71ea-47c4-afd9-4075ab52ccbd"],
 " entry pertains to the discontinuity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", "j"], "\[CenterEllipsis]", 
    SubscriptBox["Disc", "i"], "\[CenterEllipsis]", "\[ScriptCapitalI]"}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "c073cb61-c643-4145-94c1-7f8aac0a1cc6"],
 ". Extract the ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "7"}], "}"}]], "InlineFormula",ExpressionUUID->
  "28f11034-4b47-4043-a982-f017ebdfb77b"],
 " entry:"
}], "ExampleText",
 CellChangeTimes->{{4.0014048676367807`*^9, 4.001404875372126*^9}},
 CellID->1345527371,ExpressionUUID->"b5341f56-5313-4490-9cb4-6b36d01267a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dm1", "[", 
  RowBox[{"[", 
   RowBox[{"1", ",", "7"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.001404877148427*^9, 4.001404882568637*^9}},
 CellLabel->"In[25]:=",
 CellID->545790819,ExpressionUUID->"116307ee-acb5-4a0f-b89f-64720e5f5a97"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{{4.00140488076411*^9, 4.001404882895859*^9}},
 CellLabel->"Out[25]=",
 CellID->687465770,ExpressionUUID->"c2c5b26b-6509-4fd1-9355-cd704376439a"]
}, Open  ]],

Cell[TextData[{
 "This means that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", "7"], "\[CenterEllipsis]", 
