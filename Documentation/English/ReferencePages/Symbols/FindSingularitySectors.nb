Notebook[{

Cell[CellGroupData[{
Cell["FindSingularitySectors", "ObjectName",
 CellID->10904114,ExpressionUUID->"d7c69957-7861-441a-a93e-5e6279095292"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6ec84629-bccc-45c1-8471-5bd27e54ad9c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindSingularitySectors",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/FindSingularitySectors"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"], ",", 
    StyleBox["index", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "051793c9-0725-475d-b3bb-cb65b29f5b11"],
 "\[LineSeparator]returns the list of sectors for which the singularity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["index", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"27e9b205-56c1-4c4f-b477-00368c2eb0c3"],
 " causes a drop in the Euler characteristic."
}], "Usage",
 CellChangeTimes->{4.001406865795331*^9},
 CellID->729334003,ExpressionUUID->"cdd2d329-5fe5-4661-89b9-32ebbff55bda"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "e49556db-1456-44e7-bc96-c5ff14b3433d"],
 " is the Lee\[Dash]Pomeransky polynomial of the Feynman integral, ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "e568a97f-794e-497a-bafd-bbff4623381f"],
 " is the list of its integration variables, and ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "c5deb8aa-4fcc-4628-b07b-1030aa36144a"],
 " is the list of candidate singularities, given as polynomials in the \
external kinematic parameters; ",
 Cell[BoxData[
  StyleBox["index", "TI"]], "InlineFormula",ExpressionUUID->
  "6d0ee640-5b4d-4e43-a428-808c7b04c200"],
 " is the position in ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "4db4fa81-e2e8-4f6f-912c-54de2a685cd1"],
 " of the singularity to analyze."
}], "Notes",
 CellID->1355564270,ExpressionUUID->"52a98f87-fb7b-47c2-ade4-bb31f8695a8a"],

Cell[TextData[{
 "The result lists the sectors in which the number of critical points is \
smaller on the support of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["index", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"7b7d4354-3c50-465d-961b-d91dd102f681"],
 " than for generic kinematics, or by those in which this number is ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "b4b4e8ec-cecd-4b63-a6f8-dc8d735203db"],
 ", indicating a higher-dimensional solution to the critical point equations. \
Each sector is given as the list of integration variables that are not set to \
zero in it, so that ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"x1", ",", "x3"}], "}"}]], "InlineFormula",ExpressionUUID->
  "928d71e2-e586-458a-9d9d-6c81c49f2468"],
 " denotes the sector ",
 Cell[BoxData[
  RowBox[{"x2", "=", "x4", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "b05d1a08-fcfa-4717-9f2d-382e4a3aa82e"],
 "."
}], "Notes",
 CellChangeTimes->{{4.002441487117785*^9, 4.002441487218265*^9}},
 CellID->597805011,ExpressionUUID->"d37261d1-eb6c-4729-bf16-4dc98e0c9ce1"],

Cell["The following options can be given:", "Notes",
 CellID->79931345,ExpressionUUID->"1ae1c110-48b7-414e-86cb-8b492624320a"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "8fb9e9fc-fe8c-42f0-9679-61109444a5da"], "\"\<CheckCriticalPointValidity\
\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether to run automatic checks that certify the validity of the output\
\>", "TableText",ExpressionUUID->"cd703bee-ab65-4cdc-82ec-378fca3bda49"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "fdff389e-744f-40be-a651-a2ddc6d4161d"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell["\<\
whether to use msolve for the underlying Groebner basis computations\
\>", "TableText",ExpressionUUID->"dd4597f5-a181-4b65-8e58-6bca392f141b"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{4.0014053962716837`*^9, 4.001405407031354*^9}, {
  4.001405924759912*^9, 4.001405941018669*^9}, {4.001406931411063*^9, 
  4.001406933999794*^9}},
 CellID->438679867,ExpressionUUID->"80936063-01cf-4145-98a5-2cc83f976a30"]
}, Open  ]],

