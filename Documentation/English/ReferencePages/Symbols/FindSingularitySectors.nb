Cell["\<\
Define the Lee\[Dash]Pomeransky polynomial of the one-loop two-mass easy box, \
its integration variables, and a list of candidate singularities:\
\>", "ExampleText",
 CellID->1514468047,ExpressionUUID->"a2f9cdbb-9fd8-42dd-91e7-2354d9d2aed5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[51]:=",
 CellID->1513626083,ExpressionUUID->"ade28153-75fe-40e0-9606-0136eb26fc3a"],

Cell[TextData[{
 "Find the sectors associated with the singularity ",
 Cell[BoxData[
  RowBox[{
  "rationalAlphabet", "\[LeftDoubleBracket]", "10", 
   "\[RightDoubleBracket]"}]], "InlineFormula",ExpressionUUID->
  "917bc021-c8d7-45c6-a0fd-524698dd7d95"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{4.0014055188978577`*^9, 4.001405525422042*^9}, {
  4.001407023531658*^9, 4.0014070605430737`*^9}},
