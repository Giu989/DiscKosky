Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[51]:=",
 CellID->1513626083,ExpressionUUID->"ade28153-75fe-40e0-9606-0136eb26fc3a"],

Cell["\<\
Find the sectors associated to the letter rationalAlphabet[[10]]:\
\>", "Notes",
 CellChangeTimes->{{4.0014055188978577`*^9, 4.001405525422042*^9}, {
  4.001407023531658*^9, 4.0014070605430737`*^9}},
 CellID->922319825,ExpressionUUID->"f0811054-36c6-4b18-8384-3d37b6e279e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindSingularitySectors", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet", ",", "10"}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.001407036676223*^9, 4.001407051952683*^9}},
 CellLabel->"In[61]:=",
 CellID->170109085,ExpressionUUID->"e6f4d3a4-e8d4-4d2c-8477-b17ad09466b6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{4.001407042301367*^9, 4.001407052193006*^9}},
 CellLabel->"Out[61]=",
 CellID->1406669790,ExpressionUUID->"079b5ec2-e455-4df4-ad9c-a12e5768de87"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindSingularitySectors", "//", "Options"}]], "Input",
 CellChangeTimes->{{4.001407070551023*^9, 4.0014070715035467`*^9}},
 CellLabel->"In[62]:=",
 CellID->379347306,ExpressionUUID->"4d73aab2-c9ad-4813-b12e-4ec6e9bc1ce0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CheckCriticalPointValidity\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Substitute\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"MonomialOrder\"\>", "\[Rule]", "DegreeReverseLexicographic"}],
    ",", 
   RowBox[{"\<\"Sort\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Diophantine\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"msolve\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"PrimeIndex\"\>", "\[Rule]", "Random"}], ",", 
   RowBox[{"\<\"MSolveJobs\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"MSolveThreads\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"msolveParallelThreads\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"MSolveBatchDirectory\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"MSolveKeepFiles\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"MSolveProgress\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"MSolveProgressInterval\"\>", "\[Rule]", "0.008`"}], ",", 
   RowBox[{"\<\"debug\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"UseSameRho\"\>", "\[Rule]", "False"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0014070717681932`*^9},
 CellLabel->"Out[62]=",
 CellID->2128857960,ExpressionUUID->"9f9a3417-cec0-47aa-bac6-fcc8c4cb1eb1"]
}, Open  ]]
}, Open  ]],

