Cell["\<\
Regulated and unregulated counts can differ when points at infinity \
contribute. In such cases, the regulated approach produces the correct result:\
\>", "ExampleText",
 CellChangeTimes->{{4.0014038744072447`*^9, 4.001403903415978*^9}},
 CellID->1600212169,ExpressionUUID->"58006a0a-6931-47f0-bced-3fda0a2d5032"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "+", "x", "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"3", " ", "y"}], "+", 
    RowBox[{"6", " ", "x", " ", "y"}], "+", 
    RowBox[{"11", " ", 
     SuperscriptBox["x", "2"], " ", "y"}], "+", 
    RowBox[{"12", " ", 
