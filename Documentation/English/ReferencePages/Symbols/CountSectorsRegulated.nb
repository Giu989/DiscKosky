     ButtonData->"paclet:ref/Automatic"], Cell["\<\
whether to use msolve for the underlying Groebner basis computations\
\>", "TableText",ExpressionUUID->"55b87ffa-07b8-41fd-9737-d7ddaedf96ab"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3edcedd9-f07a-486d-b4ca-d0d4f5b9f74c"], "\"\<MSolveJobs\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
