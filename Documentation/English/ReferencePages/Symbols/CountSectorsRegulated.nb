Notebook[{

Cell[CellGroupData[{
Cell["CountSectorsRegulated", "ObjectName",
 CellID->575292180,ExpressionUUID->"e0d91086-d9ea-44f7-be71-edc72ee71370"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5572deef-b05d-4fee-a41e-e5a53115e532"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CountSectorsRegulated",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["cut", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8ffd8f7b-363f-423a-a8cc-7601fd630414"],
 "\[LineSeparator]",
 "computes the regulated critical-point count, leaving variables in ",
 Cell[BoxData[
  StyleBox["\"\<cut\>\"", "TI",
   StripOnInput->False]], "InlineFormula",ExpressionUUID->
  "d6633f2e-01b4-4bbe-8011-f9f45effe37d"],
 " unregulated.",
 "\n"
}], "Usage",
 CellID->1822466468,ExpressionUUID->"eb47be34-066a-467d-a449-0cf304e7a205"],

Cell["\<\
CountSectorsRegulated computes the number of (regulated) critical points of \
the regulated ideal.\
\>", "Notes",
 CellChangeTimes->{{4.001403404350646*^9, 4.00140341753201*^9}},
 CellID->1914533785,ExpressionUUID->"5a96d72c-2a68-4ce1-bcf7-2a9be49164fa"],

Cell[TextData[{
 "With an empty third argument, the result is the expected number of master \
integrals without symmetries for the chosen polynomial. If a non empty ",
 StyleBox["cut", "TI"],
 " is given, CountSectorsRegulated will ",
 StyleBox["not", "TI"],
 " regulate the variables given in the ",
 StyleBox["cut,", "TI"],
 " to mimic the effect of cutting these propagators."
}], "Notes",
 CellChangeTimes->{
  4.00140342610069*^9, {4.00140345811084*^9, 4.001403562463089*^9}, {
   4.0014038475046663`*^9, 4.001403851793144*^9}},
 CellID->885746738,ExpressionUUID->"6dae651f-918f-44ec-839e-0c9ed8ae88f7"],

Cell[TextData[{
 "This count is useful as a global check on sector-by-sector unregulated \
counts obtained with ",
 Cell[BoxData[
  ButtonBox["CountSectorsUnregulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"]], 
  "InlineFormula",ExpressionUUID->"797ec5a5-2e50-47e1-a0ce-6ed7e898a08f"]
}], "Notes",
 CellChangeTimes->{{4.0014034326191473`*^9, 4.001403451328865*^9}},
 CellID->1460674880,ExpressionUUID->"2220b16b-3a55-46b5-b2c1-8bbc4523d167"],

Cell["The following options can be given:", "Notes",
 CellID->1356050387,ExpressionUUID->"6a3ef64b-5c3f-48d8-b56f-a61fee064074"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ddcfcc1f-733f-4466-9854-59f06a8c2c78"], "\"\<Constraint\>\"", "0", Cell[
    "kinematic constraint imposed on the computation", "TableText",
     ExpressionUUID->"a589d06f-5cd1-4ded-b3b8-a0bfcb83428e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "dc2d4414-0a20-4ae7-81c4-5fde4a1bfa2a"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "attempts to use msolve as the Groebner basis engine", "TableText",
     ExpressionUUID->"55b87ffa-07b8-41fd-9737-d7ddaedf96ab"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3edcedd9-f07a-486d-b4ca-d0d4f5b9f74c"], "\"\<MSolveJobs\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "number of parallel msolve jobs", "TableText",ExpressionUUID->
     "74e34a8f-7598-4047-99f0-41860eaed8d1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6cf96a7b-acfc-44a3-8780-785d4ca9ab17"], "\"\<msolveParallelThreads\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "thread count passed to each msolve job", "TableText",ExpressionUUID->
     "f457c20a-4312-40c5-ab63-b9582a73189a"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9d1e4e0a-5f28-4187-aeaf-7a8e15d34bfb"], "\"\<PrimeIndex\>\"", 
    ButtonBox["Random",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Random"], Cell["\<\
prime from the internal prime list used for finite-field specialization\
\>", "TableText",ExpressionUUID->"22cc3087-921b-4401-b4e5-f2bde678836a"]}
