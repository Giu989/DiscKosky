Cell["\<\
Define the Lee\[Dash]Pomeransky polynomial of the one-loop two-mass easy box \
and its integration variables:\
\>", "ExampleText",
 CellID->1616259346,ExpressionUUID->"a6bd37c7-fecd-496b-92b2-e88ca058b5b0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}]}], "Input",\

 CellLabel->"In[25]:=",
 CellID->1192835785,ExpressionUUID->"6a7fc6c6-02d2-4c84-873f-f850b501bdba"],

Cell["\<\
Compute the number of critical points of the regulated ideal:\
\>", "ExampleText",
 CellChangeTimes->{{4.001403740570465*^9, 4.0014037487699757`*^9}},
 CellID->1406720780,ExpressionUUID->"2288c707-0cf4-4b93-a2a0-f515d17c6d3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CountSectorsRegulated", "[", 
  RowBox[{"gpol", ",", "vars", ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->"In[27]:=",
 CellID->1071327529,ExpressionUUID->"50ac6a38-642a-40f9-99ed-b17924555ae6"],

Cell[BoxData["5"], "Output",
 CellChangeTimes->{{4.0014037954189053`*^9, 4.001403796995974*^9}},
 CellLabel->"Out[27]=",
 CellID->12692653,ExpressionUUID->"af5b355b-aeb0-4255-b62b-364c9e5d91d6"]
}, Open  ]],

Cell[TextData[{
 "In many cases, this number equals the sum of the sector-by-sector \
unregulated counts from ",
 Cell[BoxData[
  ButtonBox["CountSectorsUnregulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"]], 
  "InlineFormula",ExpressionUUID->"6c1a74d6-04a7-4381-8fc3-e79fb27c4ac4"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{4.001403740570465*^9, 4.001403783625072*^9}},
 CellID->2111622696,ExpressionUUID->"28ac86e0-81b1-4784-8720-6a870e83ddaa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CountSectorsUnregulated", "[", 
   RowBox[{"gpol", ",", "vars", ",", 
    RowBox[{"{", "}"}]}], "]"}], "\[LeftDoubleBracket]", "1", 
  "\[RightDoubleBracket]"}]], "Input",
 CellChangeTimes->{{4.001403790594924*^9, 4.001403792941559*^9}},
 CellLabel->"In[28]:=",
 CellID->887741800,ExpressionUUID->"c76b69c1-bc8c-40c2-b48a-7c48c5b1c12a"],

Cell[BoxData["5"], "Output",
 CellChangeTimes->{{4.001403793801876*^9, 4.001403798200862*^9}},
 CellLabel->"Out[28]=",
 CellID->1447922127,ExpressionUUID->"90839e07-401a-4bbe-bdcf-7fe3164131f2"]
}, Open  ]],

Cell["\<\
Variables in the third argument are left unregulated, which mimics the effect \
of cutting these propagators:\
\>", "ExampleText",
 CellChangeTimes->{{4.0014038251439734`*^9, 4.001403833046226*^9}},
 CellID->674344400,ExpressionUUID->"90b5bd3e-0981-4a63-966c-f4cbf50edb69"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cut", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"CountSectorsRegulated", "[", 
  RowBox[{"gpol", ",", "vars", ",", "cut"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"CountSectorsUnregulated", "[", 
  RowBox[{"gpol", ",", "vars", ",", "cut"}], "]"}]}], "Input",
