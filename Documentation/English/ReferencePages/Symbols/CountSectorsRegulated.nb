Cell[CellGroupData[{
Cell["CountSectorsRegulated", "ObjectName",
 CellID->575292180,ExpressionUUID->"e0d91086-d9ea-44f7-be71-edc72ee71370"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5572deef-b05d-4fee-a41e-e5a53115e532"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CountSectorsRegulated",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["cut", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8ffd8f7b-363f-423a-a8cc-7601fd630414"],
 "\[LineSeparator]",
 "computes the regulated critical-point count, leaving variables in ",
 Cell[BoxData[
  StyleBox["\"\<cut\>\"", "TI",
   StripOnInput->False]], "InlineFormula",ExpressionUUID->
  "d6633f2e-01b4-4bbe-8011-f9f45effe37d"],
 " unregulated.",
 "\n"
}], "Usage",
 CellID->1822466468,ExpressionUUID->"eb47be34-066a-467d-a449-0cf304e7a205"],

Cell["\<\
CountSectorsRegulated computes the critical points of the regulated ideal, \
except for variables supplied in the third argument.\
\>", "Notes",
 CellID->1914533785,ExpressionUUID->"5a96d72c-2a68-4ce1-bcf7-2a9be49164fa"],

Cell["\<\
With an empty third argument, the result is the expected number of master \
integrals without symmetries for the chosen polynomial.\
\>", "Notes",
 CellID->885746738,ExpressionUUID->"6dae651f-918f-44ec-839e-0c9ed8ae88f7"],

Cell["\<\
This count is useful as a global check on sector-by-sector unregulated counts.\
\>", "Notes",
 CellID->1460674880,ExpressionUUID->"2220b16b-3a55-46b5-b2c1-8bbc4523d167"],

Cell["\<\
The option \"UseSameRho\" -> True uses one shared rho parameter for all \
propagator exponents.\
\>", "Notes",
 CellID->1450601731,ExpressionUUID->"49258296-9495-466c-b2a7-de893c6a27a6"],

Cell["The following options can be given:", "Notes",
 CellID->1356050387,ExpressionUUID->"6a3ef64b-5c3f-48d8-b56f-a61fee064074"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c6146f5b-fd0b-484e-9d4c-d2330617967e"], "\"\<UseSameRho\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to use one shared rho parameter for all propagator exponents\
\>", "TableText",ExpressionUUID->"a862f090-6d44-40b6-958d-adea9e2dbb0b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b7a0d2cb-3b03-4d3c-8214-5e985d2ee93f"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "whether to use msolve for Groebner basis computations", "TableText",
     ExpressionUUID->"0bed63ad-7c3c-47ae-8f3b-afc8e9b71e64"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f9ed1f3a-2ebf-44b7-8e48-0506ca4d44dc"], "\"\<MSolveJobs\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
