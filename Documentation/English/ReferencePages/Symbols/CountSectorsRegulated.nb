Notebook[{

Cell[CellGroupData[{
Cell["CountSectorsRegulated", "ObjectName",
 CellID->575292180,ExpressionUUID->"e0d91086-d9ea-44f7-be71-edc72ee71370"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5572deef-b05d-4fee-a41e-e5a53115e532"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CountSectorsRegulated",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["cut", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8ffd8f7b-363f-423a-a8cc-7601fd630414"],
 "\[LineSeparator]",
 "computes the regulated critical point count, leaving variables in ",
 Cell[BoxData[
  StyleBox["cut", "TI"]], "InlineFormula",ExpressionUUID->
  "d6633f2e-01b4-4bbe-8011-f9f45effe37d"],
 " unregulated."
}], "Usage",
 CellID->1822466468,ExpressionUUID->"eb47be34-066a-467d-a449-0cf304e7a205"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CountSectorsRegulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"]], 
  "InlineFormula",ExpressionUUID->"075e3b04-608d-46ca-9b95-f4b114ff783f"],
 " computes the number of critical points of a Feynman integral with analytic \
regulators, given by its Lee\[Dash]Pomeransky polynomial ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "58920024-29d5-4321-8118-fd8ae17d6f91"],
 " in the integration variables ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "b43ac226-c762-4cff-bc22-3c82766d956d"],
 "."
}], "Notes",
 CellID->1914533785,ExpressionUUID->"5a96d72c-2a68-4ce1-bcf7-2a9be49164fa"],

Cell[TextData[{
 "The variables in ",
 Cell[BoxData[
  StyleBox["cut", "TI"]], "InlineFormula",ExpressionUUID->
  "ff952a9b-dcc6-40f0-89f4-790f35aab42d"],
 " are not regulated, to mimic the effect of cutting the corresponding \
propagators. Use ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cut", "TI"], "=", 
   RowBox[{"{", "}"}]}]], "InlineFormula",ExpressionUUID->
  "5bc224c1-5440-4be9-9171-5b4abea11b9a"],
 " when no propagators are cut."
}], "Notes",
 CellID->885746738,ExpressionUUID->"6dae651f-918f-44ec-839e-0c9ed8ae88f7"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cut", "TI"], "=", 
   RowBox[{"{", "}"}]}]], "InlineFormula",ExpressionUUID->
  "5177c38f-529e-4cfe-8b16-3d6442b131b5"],
 ", the result is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "n"], " ", "\[Chi]", "(", 
    RowBox[{
     SuperscriptBox["\[DoubleStruckCapitalC]", "n"], "\[Backslash]", 
     RowBox[{"V", "(", 
      RowBox[{
       SubscriptBox["x", "1"], "\[CenterEllipsis]", 
       SubscriptBox["x", "n"], " ", "G"}], ")"}]}], ")"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"a57b14d2-f1bf-41f1-87f8-aa0f6afeaa31"],
 ", where ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineMath",ExpressionUUID->
  "0b613d8c-a4e8-4d1a-9733-a0cd18541c00"],
 " is ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "52225651-b691-4f39-afbc-d8b4905d2c01"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox["x", "n"]}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "f2cca770-e3f5-4e1a-8390-b7b7e4e4561f"],
 " are the variables in ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "30e3bd16-9b23-4763-8058-023e292db4cd"],
 ". This is the number of master integrals of the regulated Feynman integral, \
not accounting for symmetries, and provides a global check on the \
sector-by-sector counts of ",
 Cell[BoxData[
  ButtonBox["CountSectorsUnregulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"]], 
  "InlineFormula",ExpressionUUID->"43f6736b-29bc-43f8-bc75-c7cb1dcd5a83"],
 "."
}], "Notes",
 CellID->1460674880,ExpressionUUID->"2220b16b-3a55-46b5-b2c1-8bbc4523d167"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CountSectorsRegulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"]], 
  "InlineFormula",ExpressionUUID->"6825bc5e-e590-4f40-9ded-f63dee443d46"],
 " returns ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "b62cf7e8-8b4a-43d7-bfec-e398da4113e7"],
 " if the critical points are not isolated. It prints an error and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "570f1f66-6e0f-43c7-bbbc-e5938bd30b4f"],
 " if, for example, ",
 Cell[BoxData[
  StyleBox["cut", "TI"]], "InlineFormula",ExpressionUUID->
  "e6bce9e5-27a4-4f65-8634-ab95719b901d"],
 " is not a subset of ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "e4eaa8aa-7dc6-4d9a-8a91-a599c2911602"],
 "."
}], "Notes",
 CellID->2034168352,ExpressionUUID->"e4a08283-4e80-4670-a117-f1db0b4c7604"],

Cell["The following options can be given:", "Notes",
 CellID->1356050387,ExpressionUUID->"6a3ef64b-5c3f-48d8-b56f-a61fee064074"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ddcfcc1f-733f-4466-9854-59f06a8c2c78"], "\"\<Constraint\>\"", "0", 
    Cell["\<\
polynomial in the kinematic variables that is set to zero; 0 means generic \
