 RowBox[{
  RowBox[{"cut", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"CountSectorsRegulated", "[", 
  RowBox[{"gpol", ",", "vars", ",", "cut"}], "]"}], "\[IndentingNewLine]", 
