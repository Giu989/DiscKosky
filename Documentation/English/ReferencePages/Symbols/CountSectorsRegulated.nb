Cell["\<\
Variables in the third argument are left unregulated, which mimics the effect \
of cutting these propagators.\
\>", "Notes",
 CellChangeTimes->{{4.0014038251439734`*^9, 4.001403833046226*^9}},
 CellID->674344400,ExpressionUUID->"90b5bd3e-0981-4a63-966c-f4cbf50edb69"],

