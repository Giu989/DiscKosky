Cell["\<\
Regulated and unregulated counts can differ when points at infinity \
contribute. In such cases, the regulated approach produces the correct result.\
\>", "Notes",
 CellChangeTimes->{{4.0014038744072447`*^9, 4.001403903415978*^9}},
 CellID->1600212169,ExpressionUUID->"58006a0a-6931-47f0-bced-3fda0a2d5032"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "+", "x", "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"3", " ", "y"}], "+", 
    RowBox[{"6", " ", "x", " ", "y"}], "+", 
    RowBox[{"11", " ", 
     SuperscriptBox["x", "2"], " ", "y"}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "3"], " ", "y"}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["x", "2"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"19", " ", 
     SuperscriptBox["x", "3"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"18", " ", 
     SuperscriptBox["x", "4"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["x", "4"], " ", 
     SuperscriptBox["y", "3"]}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "5"], " ", 
     SuperscriptBox["y", "3"]}], "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "6"], " ", 
     SuperscriptBox["y", "4"]}]}]}], ";"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1134798046,ExpressionUUID->"64127916-efcf-48af-870a-22000da95fe9"],

