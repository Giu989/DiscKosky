    }], "TableText",ExpressionUUID->"74e34a8f-7598-4047-99f0-41860eaed8d1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6cf96a7b-acfc-44a3-8780-785d4ca9ab17"], "\"\<msolveParallelThreads\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[TextData[{
     "number of threads used by each msolve job; ",
     Cell[BoxData[
      ButtonBox["Automatic",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
      "b66d7424-d2a0-4a06-a46f-726a091aa9b9"],
     " uses all available processor threads"
    }], "TableText",ExpressionUUID->"f457c20a-4312-40c5-ab63-b9582a73189a"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9d1e4e0a-5f28-4187-aeaf-7a8e15d34bfb"], "\"\<PrimeIndex\>\"", 
    ButtonBox["Random",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Random"], Cell[TextData[{
     "index (starting from 0) of the prime in the internal prime list used \
for finite\[Hyphen]field specialization; ",
     Cell[BoxData[
      ButtonBox["Random",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Random"]], "InlineFormula",ExpressionUUID->
      "09eeb1d7-ff39-463d-82f6-296c2e6ac375"],
     " picks one at random"
    }], "TableText",ExpressionUUID->"22cc3087-921b-4401-b4e5-f2bde678836a"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{4.001402722759692*^9, 4.001402753835342*^9}},
 CellID->607165529,ExpressionUUID->"d6677425-4ed3-4a56-8c33-dbcf1a6395fd"]
}, Open  ]],

