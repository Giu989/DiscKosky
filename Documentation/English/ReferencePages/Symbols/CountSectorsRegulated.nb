 CellID->12692653,ExpressionUUID->"af5b355b-aeb0-4255-b62b-364c9e5d91d6"]
}, Open  ]],

Cell[TextData[{
 "In many cases this number is matched by the sum of the unregulated critical \
ideals using ",
 Cell[BoxData[
  ButtonBox["CountSectorsUnregulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"]], 
  "InlineFormula",ExpressionUUID->"6f9e6bdd-9a32-4c61-a738-490db2b0974c"]
}], "Notes",
