Cell[TextData[{
 "For some polynomials, ",
 Cell[BoxData[
  ButtonBox["CountSectorsUnregulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"]], 
  "InlineFormula",ExpressionUUID->"a3e47d70-6850-4b93-976c-3b4ebe911730"],
 " may undercount because critical points are lost to infinity. This can be \
detected by comparing the total with the result of ",
 Cell[BoxData[
  ButtonBox["CountSectorsRegulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"]], 
  "InlineFormula",ExpressionUUID->"0946f039-38ae-481c-914d-d11052f4b642"],
 ":"
}], "ExampleText",
