Cell["\<\
The first entry represents the total number of critical points. The second a \
breakdown of the contributions from each sector. The third entry indexes the \
considered sectors.\
\>", "Notes",
 CellChangeTimes->{{4.001402905296788*^9, 4.001402953706603*^9}},
 CellID->1701013000,ExpressionUUID->"387dabbe-e1fc-45c3-94cb-4728f3831f19"],

