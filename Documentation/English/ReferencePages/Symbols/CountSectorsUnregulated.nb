Cell[CellGroupData[{
Cell["CountSectorsUnregulated", "ObjectName",
 CellID->314863609,ExpressionUUID->"bf4accd6-fd01-4b61-9d8b-2c7ea44350e6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5a09e278-f995-46c0-b322-fe94234803d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CountSectorsUnregulated",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["cut", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2d3aebf8-9ed8-45f5-bed7-a20f1c3e0e98"],
 "\[LineSeparator]",
 "counts unregulated critical points sector by sector and returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"total", ",", "sectorCounts", ",", "sectors"}], "}"}]], 
  "InlineFormula",ExpressionUUID->"7ab0023f-cf88-4a6c-bc53-959305ab13e7"],
 ".",
 "\n"
}], "Usage",
 CellID->116330810,ExpressionUUID->"13a434e0-6885-4046-87cf-6bde20750300"],

Cell["\<\
CountSectorsUnregulated computes the critical points in each sector of a \
Feynman integral.\
\>", "Notes",
 CellID->586972977,ExpressionUUID->"9ec461c5-50d2-4a14-a796-6fcf09ea38c2"],

Cell["\<\
The third argument is a list of cut variables. Only sectors containing all \
variables in the cut are counted.\
\>", "Notes",
 CellID->1220580336,ExpressionUUID->"e99a74c6-e373-4cd8-af72-1cddd01f017b"],

Cell["\<\
The option \"Constraint\" evaluates the sector counts on a singularity or \
other kinematic constraint.\
\>", "Notes",
 CellID->1010458230,ExpressionUUID->"58d390e1-3430-4f4a-89aa-dbd5381318cc"],

Cell["\<\
By default, \"msolve\" -> Automatic uses msolve when the executable is \
available. Setting \"msolve\" -> False forces Mathematica's built-in \
GroebnerBasis workflow.\
\>", "Notes",
 CellID->1871237163,ExpressionUUID->"6b8a4c4b-8780-497c-9a73-d32d4ec71347"],

Cell["The following options can be given:", "Notes",
 CellID->610483391,ExpressionUUID->"c076d4ce-7124-40f3-8c5a-dc2733171c26"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7c3b347c-df59-4975-9d0b-ac8da2a27891"], "\"\<Constraint\>\"", "0", Cell[
    "constraint imposed before counting", "TableText",ExpressionUUID->
     "a60e50f5-53bf-41b9-ac8d-d20803e4ee5c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "44c62b17-c19d-40ad-8c14-c6a440b4b733"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "whether to use msolve for Groebner basis computations", "TableText",
     ExpressionUUID->"79ea1446-f666-4c23-88cb-076ca63d09de"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2012e121-acf6-4d60-9ffb-ad1d5f0bef5c"], "\"\<MSolveJobs\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "number of parallel msolve jobs", "TableText",ExpressionUUID->
     "ba67cac4-4fb9-4c33-b44a-bc0b60a1f165"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "15ac7906-711e-4d6d-952a-6e6cf8c7c5e5"], "\"\<msolveParallelThreads\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "thread count passed to each msolve job", "TableText",ExpressionUUID->
     "e9f0acb8-0711-4505-be9f-e910f151efb9"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0b5e162e-13e6-4e5f-bfe5-406cd9a837d0"], "\"\<PrimeIndex\>\"", 
    ButtonBox["Random",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Random"], Cell["\<\
prime from the internal prime list used for finite-field specialization\
\>", "TableText",ExpressionUUID->"43abcd4f-56cb-452a-8dde-ab9fa7192593"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "87760a68-381c-4e11-859b-b3b220c868f2"], "\"\<MonomialOrder\>\"", 
    ButtonBox["DegreeReverseLexicographic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/DegreeReverseLexicographic"], Cell[
    "monomial order for Groebner basis computations", "TableText",
     ExpressionUUID->"497b21a2-bcf0-4607-b312-9ab00cefc940"]}
  }]], "3ColumnTableMod",
 CellID->607165529,ExpressionUUID->"a03ac83c-564f-459e-932e-bdcbd542edff"]
