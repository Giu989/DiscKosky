Cell["\<\
Define the Lee\[Dash]Pomeransky polynomial of the one-loop two-mass easy box \
and its integration variables:\
\>", "ExampleText",
 CellChangeTimes->{{4.00140317593458*^9, 4.001403185086466*^9}},
 CellID->1681378749,ExpressionUUID->"a30ac2cb-e823-427e-a47f-f0df1aa2dead"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}]}], "Input",\

 CellLabel->"In[2]:=",
 CellID->1640206756,ExpressionUUID->"1bc2263a-36d0-464d-9d1b-5166e6e7e037"],

