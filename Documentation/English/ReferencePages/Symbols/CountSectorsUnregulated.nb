    RowBox[{"9", " ", 
     RowBox[{"x", "^", "2"}], " ", 
     RowBox[{"y", "^", "2"}]}], "+", 
    RowBox[{"9", " ", 
     RowBox[{"x", "^", "4"}], " ", 
     RowBox[{"y", "^", "3"}]}], "+", 
