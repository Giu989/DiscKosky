Cell["\<\
The first element is the total number of critical points, the second gives \
the number of critical points in each sector, and the third lists the \
corresponding sectors.\
\>", "ExampleText",
 CellChangeTimes->{{4.001402905296788*^9, 4.001402953706603*^9}},
 CellID->1701013000,ExpressionUUID->"387dabbe-e1fc-45c3-94cb-4728f3831f19"],

