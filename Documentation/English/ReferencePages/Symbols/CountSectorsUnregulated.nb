Cell[TextData[{
 "For some polynomials, CountSectorsUnregulated may undercount due to \
critical points being lost to infinity. This can be checked by comparing the \
output to ",
 Cell[BoxData[
  ButtonBox["CountSectorsRegulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"]], 
  "InlineFormula",ExpressionUUID->"0946f039-38ae-481c-914d-d11052f4b642"]
}], "Notes",
 CellChangeTimes->{{4.001402857893054*^9, 4.0014028624486837`*^9}, 
   4.001402988074196*^9, {4.001403040722219*^9, 4.0014030893937693`*^9}},
 CellID->1949002206,ExpressionUUID->"80da8551-d1bd-40b5-9f66-b66fef00e74b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "+", "x", "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"3", " ", "y"}], "+", 
    RowBox[{"6", " ", "x", " ", "y"}], "+", 
    RowBox[{"11", " ", 
     SuperscriptBox["x", "2"], " ", "y"}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "3"], " ", "y"}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["x", "2"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"19", " ", 
     SuperscriptBox["x", "3"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"18", " ", 
     SuperscriptBox["x", "4"], " ", 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["x", "4"], " ", 
     SuperscriptBox["y", "3"]}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "5"], " ", 
     SuperscriptBox["y", "3"]}], "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "6"], " ", 
     SuperscriptBox["y", "4"]}]}]}], ";"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->179942683,ExpressionUUID->"86b9c05c-39aa-45c7-ba44-7f906d84e9c3"],

