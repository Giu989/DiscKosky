Notebook[{

Cell[CellGroupData[{
Cell["CountSectorsUnregulated", "ObjectName",
 CellID->314863609,ExpressionUUID->"bf4accd6-fd01-4b61-9d8b-2c7ea44350e6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5a09e278-f995-46c0-b322-fe94234803d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CountSectorsUnregulated",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["cut", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2d3aebf8-9ed8-45f5-bed7-a20f1c3e0e98"],
 "\[LineSeparator]",
 "counts the unregulated critical points of the Lee\[Dash]Pomeransky \
polynomial ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "1aeefeca-d631-4388-a0ba-f562186eb6ed"],
 " in the variables ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "1a9fd8c9-4274-4763-a607-4c0b95a0d771"],
 " sector by sector, over the sectors that contain all the cut propagators in \
",
 Cell[BoxData[
  StyleBox["cut", "TI"]], "InlineFormula",ExpressionUUID->
  "588a93f5-d165-4ce9-ae8b-f2f1ae839ed5"],
 ", and returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["total", "TI"], ",", 
    StyleBox["sectorCounts", "TI"], ",", 
    StyleBox["sectors", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "7ab0023f-cf88-4a6c-bc53-959305ab13e7"],
 "."
}], "Usage",
 CellID->116330810,ExpressionUUID->"13a434e0-6885-4046-87cf-6bde20750300"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "5a6b10ff-7152-4001-97e6-050b518b72c0"],
 " is the Lee\[Dash]Pomeransky polynomial of the Feynman integral and ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "0690a0d5-38e9-4ddb-9fef-b1cdf23f50f2"],
 " is the list of its integration variables, one for each propagator. ",
 Cell[BoxData[
  StyleBox["cut", "TI"]], "InlineFormula",ExpressionUUID->
  "ea68b658-6da7-4fd1-8352-39591febc978"],
 " lists the integration variables of the cut propagators; use ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "d6e7d2fc-2d7f-4118-9cd5-dc3169bcb4b5"],
 " when no propagators are cut."
}], "Notes",
 CellID->586972977,ExpressionUUID->"9ec461c5-50d2-4a14-a796-6fcf09ea38c2"],

Cell[TextData[{
 "All other symbols in ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "f798e2d1-b137-491c-9296-b4433e475385"],
 " are kinematic parameters and are given random numerical values, so the \
counts hold for generic kinematics. With the ",
 Cell[BoxData["\<\"Constraint\"\>"], "InlineFormula",ExpressionUUID->
  "9eef7666-8190-4001-b495-1c18083cb2b8"],
 " option, they hold for generic kinematics on the locus where the given \
polynomial vanishes."
}], "Notes",
 CellID->961311688,ExpressionUUID->"937154b5-2348-4702-a2d4-60d54892d5c0"],

Cell[TextData[{
 "Each sector is labeled by the list of integration variables that are not \
set to zero; this list always contains all the variables in ",
 Cell[BoxData[
  StyleBox["cut", "TI"]], "InlineFormula",ExpressionUUID->
  "e6305233-3ac1-443a-b19f-ec0c2ad6e99c"],
 ". ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sectorCounts", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["k", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"8610b039-862c-477a-b4ae-244911c56dcd"],
 " is the number of critical points in the sector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sectors", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["k", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"a1ee6627-b824-4cc7-b3f1-6cda97ec1368"],
 ", and ",
 Cell[BoxData[
  StyleBox["total", "TI"]], "InlineFormula",ExpressionUUID->
  "6e69ccd3-5dc2-4a0e-a4dd-839c5dadfd74"],
 " is the sum of ",
 Cell[BoxData[
  StyleBox["sectorCounts", "TI"]], "InlineFormula",ExpressionUUID->
  "7267119f-36f8-4517-a5b1-149fbc5873e4"],
 "."
}], "Notes",
 CellID->1133355265,ExpressionUUID->"4d5eda46-262b-4dc2-9fd9-04a938a3ce2a"],

Cell[TextData[{
 "If the critical points in a sector are not isolated, the corresponding \
entry of ",
 Cell[BoxData[
  StyleBox["sectorCounts", "TI"]], "InlineFormula",ExpressionUUID->
  "5b2c2c90-9c91-4f99-a4fc-31cc5bc1da4b"],
 " is ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "99533303-9d4e-4e96-a4b0-d51a7cedefd6"],
 ", and so is ",
 Cell[BoxData[
  StyleBox["total", "TI"]], "InlineFormula",ExpressionUUID->
  "fea2e0d6-9a0b-4c4e-9265-18eedb262f7b"],
 ". If the computation cannot be carried out, for instance when ",
 Cell[BoxData[
  RowBox[{"\<\"msolve\"\>", "\[Rule]", 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula",ExpressionUUID->
  "452f2320-b06f-4579-aa1f-be6abc4eb8ed"],
 " is given but the msolve executable is not found, an error is printed and \
",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "e1b43fe0-0ff1-4992-be6a-2e8b484e5dfe"],
 " is returned."
}], "Notes",
 CellID->709380178,ExpressionUUID->"ec92ccdd-84c4-4d4b-aec7-ff2236f9e561"],

Cell["The following options can be given:", "Notes",
 CellID->610483391,ExpressionUUID->"c076d4ce-7124-40f3-8c5a-dc2733171c26"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7c3b347c-df59-4975-9d0b-ac8da2a27891"], "\"\<Constraint\>\"", "0", 
    Cell["\<\
polynomial in the kinematic variables that is set to zero; 0 means generic \
kinematics\
\>", "TableText",ExpressionUUID->"a60e50f5-53bf-41b9-ac8d-d20803e4ee5c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "87760a68-381c-4e11-859b-b3b220c868f2"], "\"\<MonomialOrder\>\"", 
    "DegreeReverseLexicographic", Cell[
    "monomial order for Groebner basis computations", "TableText",
     ExpressionUUID->"497b21a2-bcf0-4607-b312-9ab00cefc940"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "44c62b17-c19d-40ad-8c14-c6a440b4b733"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell["\<\
whether to use msolve for the underlying Groebner basis computations\
\>", "TableText",ExpressionUUID->"001cd6dd-5f79-4226-bf97-8e64dfe4ecbc"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2012e121-acf6-4d60-9ffb-ad1d5f0bef5c"], "\"\<MSolveJobs\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[TextData[{
     "maximum number of msolve jobs run in parallel; ",
     Cell[BoxData[
      ButtonBox["Automatic",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
      "ea6aeec8-13b7-488b-bbc2-04d70a4ebff6"],
     " uses one job per processor core"
    }], "TableText",ExpressionUUID->"ba67cac4-4fb9-4c33-b44a-bc0b60a1f165"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "15ac7906-711e-4d6d-952a-6e6cf8c7c5e5"], "\"\<msolveParallelThreads\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[TextData[{
     "number of threads used by each msolve job; ",
     Cell[BoxData[
      ButtonBox["Automatic",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
      "5ac235ec-5eb9-47e5-a9b2-472196dd279d"],
     " uses all available processor threads"
    }], "TableText",ExpressionUUID->"e9f0acb8-0711-4505-be9f-e910f151efb9"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0b5e162e-13e6-4e5f-bfe5-406cd9a837d0"], "\"\<PrimeIndex\>\"", 
    ButtonBox["Random",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Random"], Cell[TextData[{
     "index (starting from 0) of the prime in the internal prime list used \
for finite\[Hyphen]field specialization; ",
     Cell[BoxData[
      ButtonBox["Random",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Random"]], "InlineFormula",ExpressionUUID->
