Cell["\<\
Define the Lee\[Dash]Pomeransky polynomial of the one-loop two-mass easy box, \
its integration variables, and a list of candidate singularities:\
\>", "ExampleText",
 CellID->1766505133,ExpressionUUID->"50040c80-630c-40f0-9bc9-1b07e285fca9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->496265211,ExpressionUUID->"95b0c81a-b7d2-411c-ad80-28dbddd33e53"],

Cell[TextData[{
 "Test a sequential discontinuity using singularities 1 and 7 of the list, \
where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Disc", 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineMath",ExpressionUUID->
  "5f37e15a-10c8-43ed-a536-b1e573854915"],
 " denotes the discontinuity with respect to ",
 Cell[BoxData[
  RowBox[{"rationalAlphabet", "\[LeftDoubleBracket]", 
   StyleBox["k", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"a71d6b07-2221-4e23-b935-5d7bf2214037"],
 ". Explicitly, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", "7"], "\[CenterEllipsis]", 
    SubscriptBox["Disc", "1"], "\[CenterEllipsis]", "\[ScriptCapitalI]"}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "34b859db-99e8-4377-9162-01b07e76a565"],
 " is shown to vanish:"
}], "ExampleText",
 CellChangeTimes->{{4.0014050913217688`*^9, 4.001405127431882*^9}},
 CellID->762589467,ExpressionUUID->"e48595f0-2e90-4067-bd28-e8bc4fc1f935"],

Cell[CellGroupData[{

