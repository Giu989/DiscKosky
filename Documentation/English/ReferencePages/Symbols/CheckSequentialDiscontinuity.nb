   {Cell["   ", "ModInfo",ExpressionUUID->
     "061f9b79-1e6d-472e-9201-309565f6f48e"], "\"\<RefineIndeterminates\>\"", 
    
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to apply a more refined algorithm to discontinuity sequences that the \
standard procedure cannot resolve\
\>", "TableText",ExpressionUUID->"b5464c5f-2862-46f7-9fee-22d106257a05"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "72950436-d3a1-4460-a88d-484140732208"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell["\<\
whether to use msolve for the underlying Groebner basis computations\
\>", "TableText",ExpressionUUID->"f204f6f5-5b93-4390-b876-af07b339aeb1"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{4.001405027534149*^9, 4.00140505663758*^9}},
