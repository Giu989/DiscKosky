Cell[CellGroupData[{
Cell["CheckSequentialDiscontinuity", "ObjectName",
 CellID->433740186,ExpressionUUID->"ea42bb03-fe5f-4169-95d0-9b83c828c0c7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bc2f14f3-3fc8-462d-9864-60de59d462e4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckSequentialDiscontinuity",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/CheckSequentialDiscontinuity"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"], ",", 
    StyleBox["indexList", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "04f28ab1-7b3d-462f-8f6d-ab7e53a42b43"],
 "\[LineSeparator]",
 "tests whether the ordered singularities in ",
 Cell[BoxData[
  StyleBox["indexList", "TI"]], "InlineFormula",ExpressionUUID->
  "147566ba-0ab9-44fe-a13a-4f380d0630b9"],
 " support a sequential discontinuity."
}], "Usage",
 CellID->139271287,ExpressionUUID->"bdc72e65-372b-4130-ac7e-78eb8a07ad81"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "3836cea0-4af3-4766-8a9b-a878deda776c"],
 " is the Lee\[Dash]Pomeransky polynomial of the Feynman integral ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "fb731a6c-1ccc-40f5-b357-21d2d31d98ee"],
 ", ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "96287efb-a334-46da-bc70-df108fc9cde5"],
 " is the list of its integration variables, and ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "b8b03cee-6013-403f-8c30-4d25150f0281"],
 " is the list of candidate singularities, given as polynomials in the \
external kinematic parameters."
}], "Notes",
 CellID->1642487768,ExpressionUUID->"c7e45bc3-4960-48c2-adb9-8147ced21411"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["indexList", "TI"], "=", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["i", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["i", "TI"], 
      StyleBox["2", "TR"]], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["i", "TI"], 
      StyleBox["n", "TI"]]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "f29c8a62-2014-48ca-a5ea-902fa330c4a4"],
 " is a list of positions in ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "7ef2d0f3-4d9d-48b5-83b6-52eb6890f945"],
 ", with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["i", "TI"], 
   StyleBox["1", "TR"]]], "InlineFormula",ExpressionUUID->
  "6d659dee-0786-45c7-ac36-1441fda8c2da"],
 " corresponding to the first discontinuity taken. The sequence tested is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", 
     SubscriptBox["i", "n"]], "\[CenterEllipsis]", 
    SubscriptBox["Disc", 
     SubscriptBox["i", "2"]], "\[CenterEllipsis]", 
    SubscriptBox["Disc", 
     SubscriptBox["i", "1"]], "\[CenterEllipsis]", "\[ScriptCapitalI]"}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "e30825aa-6b7d-46db-9907-b5a7d8c3937e"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Disc", "k"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "60e120d2-e495-4902-96e0-6862642a74c2"],
 " denotes the discontinuity with respect to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["k", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"f6d74980-9cd0-4596-80c4-89711ecf2379"],
 "."
}], "Notes",
 CellID->2016578698,ExpressionUUID->"3c368f78-c8ab-4066-ad89-b6abc5ab77c5"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "3c89c6c3-5018-4746-869f-ac0c4f551717"],
 " if the sequence is shown to vanish, so that ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "9eae0d63-740c-4418-9367-c9ff1d719adb"],
 " satisfies the genealogical constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["Disc", 
      SubscriptBox["i", "n"]], "\[CenterEllipsis]", 
     SubscriptBox["Disc", 
      SubscriptBox["i", "2"]], "\[CenterEllipsis]", 
     SubscriptBox["Disc", 
      SubscriptBox["i", "1"]], "\[CenterEllipsis]", "\[ScriptCapitalI]"}], "=",
     "0"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "8c348e40-4a78-467a-94f0-003650cb13fd"],
 ", and ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "df9d1589-4396-4e3b-9c9e-971ca13b0fb7"],
 " if the sequence is not ruled out by this method. ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "df9fe8c0-bbef-4ee6-9333-d9b4ca4660eb"],
 " indicates that a higher-dimensional solution to the critical point \
equations has been found; with ",
 Cell[BoxData[
  RowBox[{"\<\"RefineIndeterminates\"\>", "\[Rule]", 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula",ExpressionUUID->
  "8b90ddaf-2a21-43a9-babd-f04a733d7577"],
 ", such cases are resolved where possible and otherwise conservatively \
returned as ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "6663447c-d2b1-479d-9c46-4fcf67cbbb1d"],
 "."
}], "Notes",
 CellID->1843868183,ExpressionUUID->"4f77e975-bc39-47de-bd33-ebdd17851b54"],

Cell["The following options can be given:", "Notes",
 CellID->1353201756,ExpressionUUID->"9f669c15-1ca8-4dd1-be60-db66a482f1cd"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "86a6c26a-9e0b-4915-a952-4d07c491df19"], "\"\<CheckCriticalPointValidity\
\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
