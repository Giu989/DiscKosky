Cell["\<\
Define the Lee\[Dash]Pomeransky polynomial of the one-loop two-mass easy box, \
its integration variables, and a list of candidate singularities:\
\>", "ExampleText",
 CellID->179208092,ExpressionUUID->"1cbc3bb0-25e7-4c75-96d4-71d9f6fa85e5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->1910047670,ExpressionUUID->"1e16027f-7c7b-47a1-b910-892b629b286d"],

Cell["\<\
Draw the default pruned sector graph. Allowed sequences of discontinuities \
can be read off by either choosing a singularity at the current node, or one \
that can be reached by following any sequence of directed arrows:\
\>", "ExampleText",
 CellChangeTimes->{{4.0014055188978577`*^9, 4.001405525422042*^9}},
 CellID->922319825,ExpressionUUID->"e8c6e86f-9955-4ab5-a121-25d41ccb6049"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SectorDropGraph", "[", 
  RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet"}], "]"}]], "Input",
 CellChangeTimes->{{4.001407215887382*^9, 4.001407217812809*^9}},
 CellLabel->"In[5]:=",
 CellID->406658803,ExpressionUUID->"5fcb77f1-9adb-4928-9a74-4c785740b88b"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{{1, 3}, {1, 4}, {2, 3}, {2, 4}, {1, 2, 3}, {1, 2, 4}, {1, 3, 4}, {
       2, 3, 4}, {1, 2, 3, 4}}, {{{1, 5}, {1, 7}, {2, 6}, {2, 7}, {3, 5}, {3, 
       8}, {4, 6}, {4, 8}, {5, 9}, {6, 9}, {7, 9}, {8, 9}}, Null}, {
      GraphLayout -> "LayeredDigraphEmbedding", ImagePadding -> 40, ImageSize -> 
       Large, VertexLabels -> {{1, 2, 3} -> Placed[{
            Pane[
             Style["{x1, x2, x3}", 10, 
              GrayLevel[0.15]], FrameMargins -> {{0, 0}, {7, 0}}], 
            Pane[
             Style["{6}", 10, Bold, 
              RGBColor[0.55, 0.1, 0.08]], 
             FrameMargins -> {{0, 0}, {0, 7}}]}, {Above, Below}], {2, 3, 4} -> 
         Placed[{
            Pane[
             Style["{x2, x3, x4}", 10, 
              GrayLevel[0.15]], FrameMargins -> {{0, 0}, {7, 0}}], 
            Pane[
             Style["{7}", 10, Bold, 
              RGBColor[0.55, 0.1, 0.08]], 
             FrameMargins -> {{0, 0}, {0, 7}}]}, {Above, Below}], {1, 2, 4} -> 
         Placed[{
            Pane[
             Style["{x1, x2, x4}", 10, 
              GrayLevel[0.15]], FrameMargins -> {{0, 0}, {7, 0}}], 
            Pane[
             Style["{8}", 10, Bold, 
              RGBColor[0.55, 0.1, 0.08]], 
             FrameMargins -> {{0, 0}, {0, 7}}]}, {Above, Below}], {2, 3} -> 
         Placed[{
            Pane[
             Style["{x2, x3}", 10, 
              GrayLevel[0.15]], FrameMargins -> {{0, 0}, {7, 0}}], 
