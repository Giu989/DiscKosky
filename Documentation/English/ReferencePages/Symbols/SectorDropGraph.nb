Cell[CellGroupData[{
Cell["SectorDropGraph", "ObjectName",
 CellID->810310898,ExpressionUUID->"2e8ec607-ef79-4090-a0b8-724aec7478f7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da3fcea0-61e6-4d76-bc31-2e749ad4f86e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SectorDropGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/SectorDropGraph"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bfa83bc4-dd61-4f46-ad55-b5d3ec3d5c9d"],
 "\[LineSeparator]",
 "draws a directed sector graph labelled by singularity indices that cause \
sector drops or Indeterminate sector counts.",
 "\n"
}], "Usage",
 CellID->1149527361,ExpressionUUID->"e6737d33-0010-44fb-9f22-8f14a779e9fd"],

Cell["\<\
Vertices are sectors. Arrows point from subsectors to immediate supersectors.\
\
\>", "Notes",
 CellID->1500773682,ExpressionUUID->"a335ea28-e54b-4d1d-974d-499e02f4211f"],

Cell["\<\
The sector name is displayed above each node and the associated singularity \
indices below it.\
\>", "Notes",
 CellID->1443405534,ExpressionUUID->"fba3fe6c-8a6c-4480-9278-5184021d1009"],

Cell["\<\
SectorDropGraph first builds Euler-characteristic data in the same way as \
CheckDoubleDiscontinuities, so counting options are forwarded to the \
underlying computations.\
\>", "Notes",
 CellID->652195287,ExpressionUUID->"3981a49f-dfc9-4c78-9591-4c522cc519ad"],

Cell["\<\
With \"DeleteEmptyNodes\" -> True, a node is kept when it or one of its \
subsectors has an associated singularity.\
\>", "Notes",
 CellID->1845252834,ExpressionUUID->"9e76c8b4-10c4-45e9-9f11-9a590775d4ae"],

Cell["The following options can be given:", "Notes",
 CellID->151494426,ExpressionUUID->"7ec75815-d8c7-4c4e-a0c9-74f91ffe077d"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d50d419e-c92e-4833-aa24-ec685d2c610c"], "\"\<RefineIndeterminates\>\"", 
    
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
apply the more refined algorithm for dealing with discontinuity sequences the \
standard procedure cannot  resolve\
\>", "TableText",ExpressionUUID->"acebd982-5cb8-44a1-aea0-ca0cf2a2e3f1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7c4afad2-b0b2-4969-8051-5dfcba00bc2c"], "\"\<DeleteEmptyNodes\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
prune nodes whose subsectors have no associated singularities\
\>", "TableText",ExpressionUUID->"760f9913-39dd-47e5-82d8-6cd0ecc86669"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e313a66e-ffae-4c8a-b266-518a1455ca72"], "\"\<CheckCriticalPointValidity\
\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell[
    "run the set of auomatic checks to certify the output", "TableText",
     ExpressionUUID->"ce8f2782-7cfb-4c19-9fba-162cde80d57e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "183ee90e-cea9-4312-bf1d-fa7424dc81a1"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "use msolve for the underlying sector counts", "TableText",ExpressionUUID->
     "39b71455-5c03-4d42-8fa9-7ec30298a1d0"]}
  }]], "3ColumnTableMod",
