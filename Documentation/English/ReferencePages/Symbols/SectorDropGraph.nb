Notebook[{

Cell[CellGroupData[{
Cell["SectorDropGraph", "ObjectName",
 CellID->810310898,ExpressionUUID->"2e8ec607-ef79-4090-a0b8-724aec7478f7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da3fcea0-61e6-4d76-bc31-2e749ad4f86e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SectorDropGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/SectorDropGraph"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bfa83bc4-dd61-4f46-ad55-b5d3ec3d5c9d"],
 "\[LineSeparator]",
 "draws a directed graph of the sectors of ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "14c917a6-b9f3-4a06-87ff-8b2fd45345ad"],
 ", labeled by the indices of the singularities in ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "3104bd8b-ca4d-49df-9465-bc6769ff1547"],
 " that cause sector drops or ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "8ae0b93f-2314-44b3-8773-939e7eb952b2"],
 " sector counts."
}], "Usage",
 CellID->1149527361,ExpressionUUID->"e6737d33-0010-44fb-9f22-8f14a779e9fd"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "acd4ca04-fbac-4c8b-ae7f-e618d68d1452"],
 " is the Lee\[Dash]Pomeransky polynomial of a Feynman integral, ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "86894b63-9d52-46a1-ab66-792c30c76a89"],
 " is the list of its integration variables, and ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "481f3a0d-087e-4d2e-a82e-914a38a25206"],
 " is a list of candidate singularities, given as polynomials in the external \
kinematic parameters."
}], "Notes",
 CellID->1736969072,ExpressionUUID->"9b716856-1e9e-4f30-b8bd-9d63977bad5e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SectorDropGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/SectorDropGraph"]], "InlineFormula",
  ExpressionUUID->"03dfcaae-96ef-407a-b662-1f9769eea966"],
 " returns a ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "30e17c27-4894-4fac-8f27-a41859b865ef"],
 " whose vertices are the sectors of ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "0e7c5428-0423-4d87-a7a1-476c89fffaad"],
 ", given as lists of positions in ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "872e1189-b9c4-4afa-bc1e-821906333cbe"],
 ", with arrows pointing from subsectors to immediate supersectors. It \
returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "2feb2f1f-346d-4766-867d-2cf6741cb577"],
 " if the critical point counts cannot be computed or do not pass the \
validity checks."
}], "Notes",
 CellID->1500773682,ExpressionUUID->"66513038-920a-4089-8995-0cbc391b67d7"],

Cell[TextData[{
 "Above each node is its sector, given as the list of variables that are not \
set to zero. Below it are the indices ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "8d0f54ed-a2cc-4104-87e9-1813e610ee4c"],
 " of the singularities associated with that sector: those for which the \
number of critical points in the sector drops, or becomes ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "0ae207de-2fbc-4da1-b5bc-d6e703379ab4"],
 ", when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["i", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"e549c3eb-ea5b-46fe-91c7-e40b78907bd1"],
 " vanishes."
}], "Notes",
 CellID->1443405534,ExpressionUUID->"eeb964b0-0fef-4a2e-9d9d-f748569777d9"],

Cell[TextData[{
 "With the default settings, a discontinuity with respect to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["j", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"a2b95011-5da6-434f-88ca-e987d453c9ba"],
 " can follow one with respect to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["singList", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["i", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"72cebbc9-1212-4469-a058-b22e02c46565"],
 " only if ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "a2d5b957-f585-4d83-bcaa-30a87ba78e23"],
 " appears at a node where ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "bdf4205e-ebc2-4972-93e0-bb614024339d"],
 " appears, or at a node reachable from it along the arrows. Otherwise, the \
Feynman integral ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalI]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "badba397-454d-47b4-a860-d705210d428b"],
 " satisfies the genealogical constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Disc", 
     RowBox[{
      StyleBox["singList", "TI"], "\[LeftDoubleBracket]", "j", 
      "\[RightDoubleBracket]"}]], "\[CenterEllipsis]", 
    SubscriptBox["Disc", 
     RowBox[{
      StyleBox["singList", "TI"], "\[LeftDoubleBracket]", "i", 
      "\[RightDoubleBracket]"}]], "\[CenterEllipsis]", "\[ScriptCapitalI]", "=",
     "0"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "3afe1f89-7a5e-45ef-84a5-66bd37ef9cc9"],
 "."
}], "Notes",
 CellID->1156255091,ExpressionUUID->"05091424-f434-479e-9a66-e39cfd7cae5a"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SectorDropGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/SectorDropGraph"]], "InlineFormula",
  ExpressionUUID->"37926610-81db-4d92-bfca-82a978cce27e"],
 " first builds Euler characteristic data in the same way as ",
 Cell[BoxData[
  ButtonBox["CheckDoubleDiscontinuities",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CheckDoubleDiscontinuities"]], 
  "InlineFormula",ExpressionUUID->"03fa7b84-73bf-4d8b-b1ab-f589ef5faf61"],
 ", so options of ",
 Cell[BoxData[
  ButtonBox["CountSectorsUnregulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"]], 
  "InlineFormula",ExpressionUUID->"794233ad-e44e-41c7-9e37-2d87cb05b139"],
 " and ",
 Cell[BoxData[
  ButtonBox["CountSectorsRegulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"]], 
  "InlineFormula",ExpressionUUID->"0f73982b-cd34-4888-8cf8-e3c0e5d71730"],
 ", except ",
 Cell[BoxData["\<\"Constraint\"\>"], "InlineFormula",ExpressionUUID->
  "e4ffd801-2fae-44bc-8ab9-e50dc4bc213a"],
 ", are forwarded to the underlying sector counts. The underlying data can be \
obtained with ",
 Cell[BoxData[
  ButtonBox["SectorDropGraphData",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/SectorDropGraphData"]], "InlineFormula",
  ExpressionUUID->"349eb657-ff76-4b54-a36b-991fd52145a6"],
 "."
}], "Notes",
 CellID->652195287,ExpressionUUID->"3981a49f-dfc9-4c78-9591-4c522cc519ad"],

Cell["The following options can be given:", "Notes",
 CellID->151494426,ExpressionUUID->"7ec75815-d8c7-4c4e-a0c9-74f91ffe077d"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e313a66e-ffae-4c8a-b266-518a1455ca72"], "\"\<CheckCriticalPointValidity\
\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether to run automatic checks that certify the validity of the output\
\>", "TableText",ExpressionUUID->"ce8f2782-7cfb-4c19-9fba-162cde80d57e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d50d419e-c92e-4833-aa24-ec685d2c610c"], "\"\<RefineIndeterminates\>\"", 
    
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to apply a more refined algorithm to discontinuity sequences that the \
standard procedure cannot resolve\
\>", "TableText",ExpressionUUID->"acebd982-5cb8-44a1-aea0-ca0cf2a2e3f1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7c4afad2-b0b2-4969-8051-5dfcba00bc2c"], "\"\<DeleteEmptyNodes\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether to remove nodes for which neither the sector nor any of its \
subsectors has an associated singularity\
\>", "TableText",ExpressionUUID->"760f9913-39dd-47e5-82d8-6cd0ecc86669"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "183ee90e-cea9-4312-bf1d-fa7424dc81a1"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell["\<\
whether to use msolve for the underlying Groebner basis computations\
\>", "TableText",ExpressionUUID->"39b71455-5c03-4d42-8fa9-7ec30298a1d0"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{4.0014053962716837`*^9, 4.001405407031354*^9}, {
  4.001405924759912*^9, 4.001405941018669*^9}},
 CellID->438679867,ExpressionUUID->"fade1daf-739f-4035-9be9-bccf3a8cd121"],

Cell[TextData[{
 "With the default setting ",
 Cell[BoxData[
  RowBox[{"\<\"DeleteEmptyNodes\"\>", "\[Rule]", 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula",ExpressionUUID->
  "a93b4b2f-a8a6-4b0f-80c2-ce977b3d5f77"],
 ", a node is kept when it or one of its subsectors has an associated \
singularity."
}], "Notes",
 CellID->1845252834,ExpressionUUID->"9e76c8b4-10c4-45e9-9f11-9a590775d4ae"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\<\"RefineIndeterminates\"\>", "\[Rule]", 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula",ExpressionUUID->
  "c041ca51-de18-45f9-9e2a-ae961eadac4c"],
 ", singularities that make the critical point count ",
 Cell[BoxData[
  ButtonBox["Indeterminate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Indeterminate"]], "InlineFormula",ExpressionUUID->
  "806d4b35-6612-4b92-bb2b-26e66eaab205"],
 " in a sector with no critical points in generic kinematics are removed from \
the node of that sector and shown in orange on the edges leaving it."
}], "Notes",
 CellID->1086880136,ExpressionUUID->"cfc51596-adb6-4ecb-8267-02ddd9080e2c"]
}, Open  ]],

