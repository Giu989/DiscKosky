Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"data", "[", "\"\<Labels\>\"", "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1064828606,ExpressionUUID->"34a2a318-a2b8-418e-a03f-a78115871302"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}], "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "4"}], "}"}], "\[Rule]", 
    RowBox[{"{", "2", "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], "\[Rule]", 
    RowBox[{"{", "3", "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "4"}], "}"}], "\[Rule]", 
    RowBox[{"{", "4", "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], "\[Rule]", 
    RowBox[{"{", "6", "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "4"}], "}"}], "\[Rule]", 
    RowBox[{"{", "8", "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "3", ",", "4"}], "}"}], "\[Rule]", 
    RowBox[{"{", "5", "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3", ",", "4"}], "}"}], "\[Rule]", 
    RowBox[{"{", "7", "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"9", ",", "10"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->701829992,ExpressionUUID->"2028afeb-0348-450a-9aca-a3233bb64bfd"]
}, Open  ]],

Cell[TextData[{
 "Each vertex lists the positions in ",
 Cell[BoxData[
 "vars"], "InlineFormula",ExpressionUUID->
  "731e0987-2886-4044-b41e-2e0307b09ede"],
 " of the variables of its sector, so ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "InlineFormula",
  ExpressionUUID->"a5f1c42f-f548-4883-8f6d-03a6ad0a37ab"],
 " is the top sector. Extract the singularities associated with it:"
}], "ExampleText",
 CellID->927381281,ExpressionUUID->"9c6c3b51-6e30-4acb-9c8b-995221dd679a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rationalAlphabet", "[", 
  RowBox[{"[", 
   RowBox[{
