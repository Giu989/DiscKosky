Cell["\<\
Define the Lee\[Dash]Pomeransky polynomial of the one-loop two-mass easy box, \
its integration variables, and a list of candidate singularities:\
\>", "ExampleText",
 CellID->1670574733,ExpressionUUID->"95e2ef02-12e9-4b28-8650-879803d56ea8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpol", "=", 
   RowBox[{"x1", "+", "x2", "+", "x3", "-", 
    RowBox[{"s23", " ", "x1", " ", "x3"}], "-", 
    RowBox[{
     SuperscriptBox["m2", "2"], " ", "x2", " ", "x3"}], "+", "x4", "-", 
    RowBox[{
     SuperscriptBox["m1", "2"], " ", "x1", " ", "x4"}], "-", 
    RowBox[{"s12", " ", "x2", " ", "x4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rationalAlphabet", "=", 
   RowBox[{"{", 
    RowBox[{"s23", ",", "m1", ",", "m2", ",", "s12", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s23"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m2", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "+", "s12"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], "-", 
      RowBox[{"s12", " ", "s23"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["m1", "2"]}], "-", 
      SuperscriptBox["m2", "2"], "+", "s12", "+", "s23"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->182580895,ExpressionUUID->"f8db0391-51ef-426b-b317-b288fc3075db"],

Cell["Compute the data behind the sector drop graph:", "ExampleText",
 CellID->1055788218,ExpressionUUID->"1632582b-de1e-45f1-b9a9-aaae1a75a4f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"SectorDropGraphData", "[", 
    RowBox[{"gpol", ",", "vars", ",", "rationalAlphabet"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1339180600,ExpressionUUID->"acf245c3-255d-493a-b863-49b27a9d5ca4"],

Cell["List the keys of the association:", "ExampleText",
 CellID->465824177,ExpressionUUID->"fe9e08ba-fbf7-4ef6-bfee-e4e98e27fd43"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", "data", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->472482801,ExpressionUUID->"cc302a2d-9397-4313-bd53-883adb8d0d75"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"EulerChiData\"\>", ",", "\<\"Sectors\"\>", 
   ",", "\<\"Vertices\"\>", ",", "\<\"Labels\"\>", ",", "\<\"Edges\"\>", 
   ",", "\<\"EdgeLabels\"\>"}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->2114414612,ExpressionUUID->"50f16d67-d977-4279-9f18-b8b19c94f341"]
}, Open  ]],

