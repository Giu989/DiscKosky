 CellID->1468225276,ExpressionUUID->"bcd809cc-aaf4-4aa8-9e59-f47b4127e393"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "47cb2856-b6aa-4968-9b91-5fae60914fd0"], "\"\<CheckCriticalPointValidity\
\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether to run automatic checks that certify the validity of the output\
\>", "TableText",ExpressionUUID->"5de302d1-acae-4ae2-ad0f-5b5683dcba11"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "53e7062b-9213-4d32-8ceb-a6298ae86e9b"], "\"\<RefineIndeterminates\>\"", 
    
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to apply a more refined algorithm to discontinuity sequences that the \
standard procedure cannot resolve\
\>", "TableText",ExpressionUUID->"fb394738-535d-44ee-8334-e9f701ceb3af"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6507950c-d2da-4b90-a9ce-37a74fc0a7d7"], "\"\<DeleteEmptyNodes\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether to remove nodes for which neither the sector nor any of its \
subsectors has an associated singularity\
\>", "TableText",ExpressionUUID->"0d616a06-45d5-47ad-8080-eb4adc33619d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1867dcb5-37e7-4b07-b924-d814869588fe"], "\"\<msolve\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell["\<\
whether to use msolve for the underlying Groebner basis computations\
\>", "TableText",ExpressionUUID->"b168a27d-713a-41f8-91ce-40b305c42425"]}
  }]], "3ColumnTableMod",
 CellID->555942711,ExpressionUUID->"58187469-8831-49a1-a3bf-3a50fee58536"]
