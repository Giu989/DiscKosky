Cell[CellGroupData[{
Cell["SectorDropGraphData", "ObjectName",
 CellID->574604369,ExpressionUUID->"4830aa4c-fef8-4f61-ac3c-29cf79da1759"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ff54c8a6-e531-40dc-8999-85f9d38ce7b4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SectorDropGraphData",
    BaseStyle->"Link",
    ButtonData->"paclet:DiscKosky/ref/SectorDropGraphData"], "[", 
   RowBox[{
    StyleBox["gpol", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["singList", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d6b9bf59-5176-423b-a550-f54cd117c78e"],
 "\[LineSeparator]",
 "gives the Euler characteristic data used by ",
 Cell[BoxData[
  ButtonBox["SectorDropGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/SectorDropGraph"]], "InlineFormula",
  ExpressionUUID->"87350197-fe83-49d8-a19a-68db3c32c5b1"],
 ", as an association containing the sectors of ",
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "203cc41a-d169-4127-aef5-1d2dcc6613d9"],
 ", the graph vertices and edges, and the indices of the singularities in ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "acd8c058-0902-43a3-a736-d2d88ec5a6f3"],
 " that label them."
}], "Usage",
 CellID->2032645917,ExpressionUUID->"60af87d2-22d8-430f-bb60-c99da951e0b9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["gpol", "TI"]], "InlineFormula",ExpressionUUID->
  "9b8ee2ec-3d38-49c1-a580-5f3d45fb09a7"],
 " is the Lee\[Dash]Pomeransky polynomial of a Feynman integral, ",
 Cell[BoxData[
  StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
  "0d61275f-a6fb-46ad-bd45-efd0fa756a20"],
 " is the list of its integration variables, and ",
 Cell[BoxData[
  StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
  "04962749-54b4-4e59-a62d-3e4b54f0b07c"],
 " is a list of candidate singularities, given as polynomials in the external \
kinematic parameters."
}], "Notes",
 CellID->187269191,ExpressionUUID->"872d39a0-2292-4439-8293-04cfbe52457d"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SectorDropGraphData",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/SectorDropGraphData"]], "InlineFormula",
  ExpressionUUID->"a269c8db-4c7d-4f6d-97cd-ffdaa779e4a6"],
 " returns an association with the following keys:"
}], "Notes",
 CellID->1802718792,ExpressionUUID->"bc5e14a6-f386-4f8c-b31d-43bada9c2907"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e3355364-aedd-42f2-974f-927317b3c389"], "\"\<EulerChiData\>\"", Cell[
    TextData[{
     "outputs of ",
     Cell[BoxData[
      ButtonBox["CountSectorsUnregulated",
       BaseStyle->"Link",
       ButtonData->"paclet:DiscKosky/ref/CountSectorsUnregulated"]], 
      "InlineFormula",ExpressionUUID->"fcff359e-7df3-4601-aafd-ff2376922add"],
     
     ", one for each singularity in ",
     Cell[BoxData[
      StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
      "55091102-6e10-452e-8bae-8d24d8a6d9f6"],
     " used as ",
     Cell[
     BoxData["\"\<Constraint\>\""], "InlineFormula",ExpressionUUID->
      "d002c988-ae38-4c98-8cd8-9d876af87ddd"],
     ", followed by the output for generic kinematics"
    }], "TableText",ExpressionUUID->"4fae91b6-3184-4968-b62f-b4e50cd4b172"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "55eb3179-39ca-424e-8e88-de3144104b48"], "\"\<Sectors\>\"", Cell[
    "sectors drawn as nodes, each given as a list of variables", "TableText",
     ExpressionUUID->"94c599d3-ecfd-45a2-b5c1-87fc867e34d2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a60efc51-eba9-46e0-bdba-c883387d9dd4"], "\"\<Vertices\>\"", Cell[
    TextData[{
     "the same sectors as graph vertices, each given by the sorted positions \
of its variables in ",
     Cell[BoxData[
      StyleBox["vars", "TI"]], "InlineFormula",ExpressionUUID->
      "a1a60d88-4c96-477d-8cf9-8d46148c5f89"]
    }], "TableText",ExpressionUUID->"bd774b3c-ca4f-4bf1-a439-0a41484b688f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "44e82a0a-615b-4ffe-a21f-e6dbe0d77cd0"], "\"\<Labels\>\"", Cell[TextData[{
     "association from each vertex to the indices in ",
     Cell[BoxData[
      StyleBox["singList", "TI"]], "InlineFormula",ExpressionUUID->
      "becef379-d71a-4df2-b341-8920956ee9ea"],
     " of the singularities that cause a sector drop or an indeterminate \
count in that sector",
     "; with ",
     Cell[BoxData[
      RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", 
       ButtonBox["True",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/True"]}]], "InlineFormula",ExpressionUUID->
      "46183709-0d16-4e5b-af3f-bcfcd4665c6a"],
     ", the singularities shown on the edges leaving the sector are omitted"
    }], "TableText",ExpressionUUID->"fe7cd3b1-c1ed-4227-97fd-28e71913cd3f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "01e6f945-2b6f-4d2e-8b44-18ec2e787dbd"], "\"\<Edges\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["DirectedEdge",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/DirectedEdge"]], "InlineFormula",
      ExpressionUUID->"14bbb234-308f-423f-ad43-93d94174dbba"],
     " objects from each vertex to its immediate supersectors"
    }], "TableText",ExpressionUUID->"6bc01182-ae1b-45dc-8f87-41db1be63265"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0d6f74b0-e7f5-446a-a38c-4378bd3ca0a3"], "\"\<EdgeLabels\>\"", Cell[
    TextData[{
     "association from each edge to the indices of the singularities \
displayed on it; all empty unless ",
     Cell[BoxData[
      RowBox[{"\"\<RefineIndeterminates\>\"", "\[Rule]", 
       ButtonBox["True",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/True"]}]], "InlineFormula",ExpressionUUID->
      "c20242a6-4f4d-46aa-8a40-328975a13dbc"]
    }], "TableText",ExpressionUUID->"402ec143-c43e-48f5-80ea-691bdbec0562"]}
  }]], "2ColumnTableMod",
 CellID->1134273792,ExpressionUUID->"8bbc92ed-0a72-49a8-ac7b-026fb25e24ac"],

Cell[TextData[{
