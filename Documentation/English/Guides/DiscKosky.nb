Notebook[{

Cell[CellGroupData[{
Cell["DiscKosky Documentation", "GuideTitle",
 CellID->1439520439,ExpressionUUID->"1ee5d3b0-d339-4f69-9220-fe8c69af1313"],

Cell["\<\
DiscKosky provides tools for sector-by-sector critical point counts, repeated \
discontinuity checks, and graph visualizations of sector drops. Use the \
tutorial for a worked example and the symbol pages for detailed options.\
\>", "GuideAbstract",
 CellID->1669521233,ExpressionUUID->"ce643523-a1fd-4a63-be50-1bcdb2899e36"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tutorial", "GuideTutorialsSection",
 CellID->1083753444,ExpressionUUID->"2b1a176f-5cac-4bc5-ae69-f4c7cf94a15a"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox[
   RowBox[{"Using", " ", "DiscKosky"}],
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/tutorial/UsingDiscKosky"]], 
  "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},
  CellTags->"4a56cd45-bddd-4da6-8fd7-8fbb9bec3d17",ExpressionUUID->
  "28d33515-bb23-4720-b20d-67dce2132813"],
 " \[LongDash] A small example covering sector counts, discontinuity checks, \
and sector drop graphs"
}], "GuideTutorial",
 CellID->1831206437,ExpressionUUID->"445e2891-29df-4049-9ffa-b5f18233dd60"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sector Counting", "GuideFunctionsSection",
 CellID->927472655,ExpressionUUID->"11733be8-7652-43b6-9c59-1b116bde8a52"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CountSectorsUnregulated",
   BaseStyle->"Link",
