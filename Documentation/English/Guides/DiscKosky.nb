  TaggingRules->{"PageType" -> "Function"},
  CellTags->"f8d9936c-1d3c-4b79-b54e-e64289494975",ExpressionUUID->
  "12d14d89-1b42-4468-89a7-0023c4017928"],
 " \[LongDash] counts critical points sector by sector and returns the total, \
sector counts, and sectors",
 "\n",
 Cell[BoxData[
  ButtonBox["CountSectorsRegulated",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CountSectorsRegulated"]], 
  "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},
  CellTags->"407b3bc3-fb3b-4ca4-a7db-598c054766e9",ExpressionUUID->
  "6d24a78c-6aa8-46da-9c2c-102b710e914f"],
 " \[LongDash] computes the regulated critical-point count"
}], "GuideText",
 CellID->556024358,ExpressionUUID->"2cdf03de-215d-4387-8d88-abcf7cb8aafa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Discontinuity Checks", "GuideFunctionsSection",
 CellID->427259906,ExpressionUUID->"1ef68336-9afd-4b26-95e9-d59c53752fd1"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CheckSequentialDiscontinuity",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CheckSequentialDiscontinuity"]], 
  "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},
  CellTags->"8d87b45c-3e2b-4c5d-be7c-49523989355e",ExpressionUUID->
  "05c8f197-b244-4a5b-ab5a-4384e9457ae1"],
 " \[LongDash] tests an ordered list of singularities for a repeated \
discontinuity",
 "\n",
 Cell[BoxData[
  ButtonBox["CheckDoubleDiscontinuities",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/CheckDoubleDiscontinuities"]], 
  "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},
  CellTags->"9febd1f6-7216-4998-8c3b-167e5f77b214",ExpressionUUID->
  "570e4f60-2474-4037-bcf1-db42c2362676"],
 " \[LongDash] builds the pairwise double-discontinuity matrix",
 "\n",
 Cell[BoxData[
  ButtonBox["SectorDropGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:DiscKosky/ref/SectorDropGraph"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},
  CellTags->"bc45e374-dfd5-40c7-909c-cdff52134be9",ExpressionUUID->
  "706df331-539d-4ab4-b4d4-e86efd2d8fe8"],
 " \[LongDash] draws the sector graph labelled by singularities that cause \
drops or indeterminates"
}], "GuideText",
 CellID->872998380,ExpressionUUID->"c45cdbbd-cd0d-4f29-a887-d0084b64e5e2"]
}, Open  ]],

